                    CornerRadius="14" Padding="9" FlowDirection="RightToLeft">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.02*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FBFCFE" BorderBrush="#E6ECF3"
                                BorderThickness="1" CornerRadius="9" Padding="8" Margin="3">
                            <StackPanel>
                                <TextBlock Text="حجم البطاقة (مم)" FontSize="12" FontWeight="Bold"
                                           Foreground="#233653" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,5">
                                    <StackPanel Margin="2">
                                        <TextBlock Text="العرض" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="CardWidthTextBox" Text="92.1" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="الارتفاع" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="CardHeightTextBox" Text="52" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="الدوران °" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="CardRotationTextBox" Text="0" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </UniformGrid>
                                <DockPanel LastChildFill="False">
                                    <Button x:Name="ApplyCardDimensionsButton" Content="تطبيق المقاس"
                                            Height="30" MinWidth="90" Style="{StaticResource StudioPrimaryActionButton}"
                                            Click="ApplyCardDimensionsButton_Click"/>
                                    <Button x:Name="ToggleCardOrientationButton" Content="تبديل الاتجاه"
                                            Height="30" MinWidth="86" Margin="4,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="ToggleCardOrientationButton_Click" ToolTip="تبديل العرض والارتفاع"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#FBFCFE" BorderBrush="#E6ECF3"
                                BorderThickness="1" CornerRadius="9" Padding="8" Margin="3">
                            <StackPanel>
                                <TextBlock Text="تخطيط الصفحة (A4)" FontSize="12" FontWeight="Bold"
                                           Foreground="#233653" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,5">
                                    <StackPanel Margin="2">
                                        <TextBlock Text="الأعمدة" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="PrintColumnsTextBox" Text="2" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight" TextChanged="PrintLayoutSetting_TextChanged"
                                                 LostFocus="PrintLayoutSetting_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="الصفوف" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="PrintRowsTextBox" Text="5" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight" TextChanged="PrintLayoutSetting_TextChanged"
                                                 LostFocus="PrintLayoutSetting_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="إجمالي الكروت" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="PrintTotalCardsTextBox" Text="153" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight" TextChanged="PrintLayoutSetting_TextChanged"
                                                 LostFocus="PrintLayoutSetting_LostFocus"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="PrintLayoutSummaryTextBlock" Text="2 عمود × 5 صفوف · 10 كروت/صفحة"
                                           FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                           TextWrapping="Wrap" Margin="3,2,3,0"/>
                                <Button Content="إعادة ضبط التخطيط" Height="29" HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryButton}" Click="ResetPrintLayoutButton_Click"
                                        Padding="10,0" Margin="2,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FBFCFE" BorderBrush="#E6ECF3"
                                BorderThickness="1" CornerRadius="9" Padding="8" Margin="3">
                            <StackPanel>
                                <TextBlock Text="الهوامش (مم)" FontSize="12" FontWeight="Bold"
                                           Foreground="#233653" Margin="0,0,0,6"/>
                                <UniformGrid Columns="4" Rows="1">
                                    <StackPanel Margin="2">
                                        <TextBlock Text="أعلى" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="PrintMarginTopTextBox" Text="10" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight" TextChanged="PrintLayoutSetting_TextChanged"
                                                 LostFocus="PrintLayoutSetting_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="أسفل" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="PrintMarginBottomTextBox" Text="10" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight" TextChanged="PrintLayoutSetting_TextChanged"
                                                 LostFocus="PrintLayoutSetting_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="يمين" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="PrintMarginRightTextBox" Text="10" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight" TextChanged="PrintLayoutSetting_TextChanged"
                                                 LostFocus="PrintLayoutSetting_LostFocus"/>
                                    </StackPanel>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="يسار" Style="{StaticResource StudioHint}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="PrintMarginLeftTextBox" Text="10" Style="{StaticResource StudioInput}"
                                                 Height="33" FlowDirection="LeftToRight" TextChanged="PrintLayoutSetting_TextChanged"
                                                 LostFocus="PrintLayoutSetting_LostFocus"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="تُطبّق الهوامش على المعاينة والطباعة وPDF."
                                           Style="{StaticResource StudioHint}" Margin="3,8,3,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="1" LastChildFill="True" Margin="3,7,3,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource StudioPrimaryActionButton}" Height="38" MinWidth="104"
                                    Click="PrintStudioPreviewButton_Click" ToolTip="طباعة نموذج تخطيطي A4">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="طباعة نموذج" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StudioActionButton}" Height="38" MinWidth="104"
                                    Click="ExportStudioPreviewPdfButton_Click" ToolTip="تصدير المعاينة إلى PDF">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="تصدير PDF" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StudioActionButton}" Height="38" MinWidth="108"
                                    Click="PreviewTemplateButton_Click" ToolTip="فتح معاينة ورقة A4">
                                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="معاينة" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="ملاحظة: طباعة الدفعات الفعلية تتم من شاشة إصدار الكروت."
                                   FontSize="10.5" Foreground="#718096" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <!-- Status and color popups remain attached to the live named controls -->
