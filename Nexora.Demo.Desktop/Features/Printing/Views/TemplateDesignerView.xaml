<?xml version='1.0' encoding='UTF-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexora.Demo.Desktop.Features.Printing.Views.TemplateDesignerView" FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}" FontFamily="Segoe UI" Loaded="TemplateDesignerView_Loaded" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="StudioPrimaryActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Height" Value="42"/><Setter Property="MinWidth" Value="112"/><Setter Property="Padding" Value="13,0"/><Setter Property="Margin" Value="3,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.94"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.50"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="StudioActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Height" Value="42"/><Setter Property="MinWidth" Value="84"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="3,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#C51D2E"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.50"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="StudioAlignmentToggleStyle" TargetType="{x:Type ToggleButton}"><Setter Property="Width" Value="38"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="3,2"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#253A58"/><Setter Property="Background" Value="#F3F6FB"/><Setter Property="BorderBrush" Value="#D8E2EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ToggleButton}"><Border x:Name="AlignChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="AlignChrome" Property="Background" Value="#FCE5E8"/><Setter TargetName="AlignChrome" Property="BorderBrush" Value="#C51D2E"/><Setter Property="Foreground" Value="#A91525"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AlignChrome" Property="BorderBrush" Value="#C51D2E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="AlignChrome" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="StudioSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="StudioHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StudioInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputChrome" Property="BorderBrush" Value="#C51D2E"/><Setter TargetName="InputChrome" Property="Background" Value="#FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputChrome" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StudioCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StudioFieldChip" TargetType="ToggleButton">
            <Setter Property="Height" Value="31"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="Background" Value="#EAF0FA"/>
            <Setter Property="BorderBrush" Value="#D6E2EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#C51D2E"/><Setter TargetName="ChipBorder" Property="BorderThickness" Value="1.5"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#C51D2E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="username"><Setter Property="Background" Value="#FCE5E8"/><Setter Property="Foreground" Value="#B91C2C"/><Setter Property="BorderBrush" Value="#F0BFC6"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="password"><Setter Property="Background" Value="#FDE9EF"/><Setter Property="Foreground" Value="#A71935"/><Setter Property="BorderBrush" Value="#F4C5D1"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="validity"><Setter Property="Background" Value="#DFF7E9"/><Setter Property="Foreground" Value="#16734A"/><Setter Property="BorderBrush" Value="#B8E7CD"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="time"><Setter Property="Background" Value="#E3ECFF"/><Setter Property="Foreground" Value="#244DB6"/><Setter Property="BorderBrush" Value="#CAD8FA"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="price"><Setter Property="Background" Value="#FFF1D8"/><Setter Property="Foreground" Value="#99600A"/><Setter Property="BorderBrush" Value="#F5D7A5"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="download"><Setter Property="Background" Value="#DDF6FF"/><Setter Property="Foreground" Value="#056C9A"/><Setter Property="BorderBrush" Value="#B8EAF8"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="contact"><Setter Property="Background" Value="#FCE6F0"/><Setter Property="Foreground" Value="#9F2457"/><Setter Property="BorderBrush" Value="#F2C5D9"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="package"><Setter Property="Background" Value="#F1E7FF"/><Setter Property="Foreground" Value="#6932B6"/><Setter Property="BorderBrush" Value="#DDC9FF"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="networkName"><Setter Property="Background" Value="#DDF6F8"/><Setter Property="Foreground" Value="#086B7D"/><Setter Property="BorderBrush" Value="#B9E9EF"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="username"/><Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#C51D2E"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#C51D2E"/></MultiDataTrigger></Style.Triggers></Style>
    </UserControl.Resources>

    <Grid Margin="12" Background="#F3F6FA">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Primary command bar -->
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D9E2EE" BorderThickness="1"
            CornerRadius="13" Padding="7,5" Margin="0,0,0,8">
        <WrapPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Button Style="{StaticResource StudioActionButton}" MinWidth="105" Height="42"
                    Click="NewTemplateButton_Click" ToolTip="إنشاء قالب جديد">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,7,0"/>
                    <TextBlock Text="قالب جديد" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <ComboBox x:Name="SavedTemplateComboBox" Height="42" Width="166"
                      DisplayMemberPath="Name" VerticalContentAlignment="Center"
                      SelectionChanged="SavedTemplateComboBox_SelectionChanged"
                      ToolTip="اختر قالباً محفوظاً أو اكتب اسم قالب جديد"
                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                      Text="{Binding ElementName=TemplateNameTextBox, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="12.5" Margin="3,0"/>
            <Button x:Name="ImportTemplateButton" Style="{StaticResource StudioActionButton}" Height="42"
                    MinWidth="112" Click="ImportTemplateButton_Click" ToolTip="استيراد قالب">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,7,0"/>
                    <TextBlock Text="استيراد قالب" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource StudioActionButton}" Height="42" MinWidth="126"
                    Click="ImportBackgroundImageButton_Click" ToolTip="استيراد صورة خلفية للبطاقة">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,7,0"/>
                    <TextBlock Text="استيراد خلفية" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource StudioPrimaryActionButton}" Height="42" MinWidth="122"
                    Click="SaveTemplateButton_Click" ToolTip="حفظ القالب الحالي">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,7,0"/>
                    <TextBlock Text="حفظ القالب" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button x:Name="ExportTemplateButton" Style="{StaticResource StudioActionButton}" Height="42"
                    MinWidth="92" Click="ExportTemplateButton_Click" ToolTip="تصدير ملف القالب">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,7,0"/>
                    <TextBlock Text="تصدير" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource StudioActionButton}" Height="42" MinWidth="128"
                    Click="PreviewTemplateButton_Click" ToolTip="معاينة الطباعة على ورقة A4">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,7,0"/>
                    <TextBlock Text="معاينة الطباعة" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            
            
            <Button Style="{StaticResource StudioActionButton}" Height="42" MinWidth="80"
                    Click="DeleteTemplateButton_Click" ToolTip="حذف القالب المحفوظ المحدد">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#C51D2E" Margin="0,0,7,0"/>
                    <TextBlock Text="حذف" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <TextBox x:Name="TemplateNameTextBox" Text="Default_Design" Style="{StaticResource StudioInput}"
                     Width="0" Height="0" Visibility="Collapsed" Padding="0"/>
        </WrapPanel>
    </Border>

    <!-- Work area: inspector on the left, canvas studio on the right -->
    <Grid Grid.Row="1" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" MinWidth="286" MaxWidth="360"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*" MinWidth="580"/>
        </Grid.ColumnDefinitions>

        <!-- Inspector and layer management -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D9E2EE" BorderThickness="1"
                CornerRadius="14" Padding="10" FlowDirection="RightToLeft">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="3,2,3,9">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Border Width="34" Height="34" CornerRadius="9" Background="#FCE7EA" Margin="0,0,0,0">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="#A91525" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="محرر الخصائص" FontSize="15" FontWeight="Bold" Foreground="#172B4D"/>
                            <TextBlock Text="تحكم دقيق في العنصر المحدد" FontSize="10.5" Foreground="#748198"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="INSPECTOR" FontSize="9.5"
                               Foreground="#9AA6B7" VerticalAlignment="Center" FontWeight="Bold"/>
                </DockPanel>

                <TabControl x:Name="InspectorTabs" Grid.Row="1" FontSize="12" BorderThickness="0" Background="Transparent">
                    <TabItem Header="خصائص العنصر" Padding="10,7">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4,10,4,5">
                                <Border Background="#FFF1F3" BorderBrush="#F3D0D5" BorderThickness="1"
                                        CornerRadius="10" Padding="10" Margin="0,0,0,12">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Width="32" Height="32" CornerRadius="8" Background="#C51D2E">
                                            <TextBlock Text="T" FontSize="17" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="العنصر المحدد" FontSize="10.5" Foreground="#7B8798"/>
                                            <TextBlock x:Name="SelectedFieldNameTextBlock" Text="اسم المستخدم"
                                                       FontSize="13" FontWeight="Bold" Foreground="#A91525"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ComboBox x:Name="SelectedElementComboBox" Height="0" Width="0" Visibility="Collapsed"
                                          Margin="0" SelectionChanged="SelectedElementComboBox_SelectionChanged"
                                          ToolTip="حالة التحديد البرمجية للعنصر"/>

                                <Expander Header="موضع وحجم العنصر (متقدم)" IsExpanded="False" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,9"><UniformGrid Columns="2" Rows="3" Margin="0,0,0,12">
                                    <StackPanel Margin="4">
                                        <TextBlock Text="الموضع X" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ElementXTextBox" Text="20" Style="{StaticResource StudioInput}"
                                                 Height="38" FlowDirection="LeftToRight" LostFocus="ElementProperty_LostFocus"
                                                 PreviewKeyDown="ElementProperty_PreviewKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="الموضع Y" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ElementYTextBox" Text="73" Style="{StaticResource StudioInput}"
                                                 Height="38" FlowDirection="LeftToRight" LostFocus="ElementProperty_LostFocus"
                                                 PreviewKeyDown="ElementProperty_PreviewKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="العرض" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ElementWidthTextBox" Text="180" Style="{StaticResource StudioInput}"
                                                 Height="38" FlowDirection="LeftToRight" LostFocus="ElementProperty_LostFocus"
                                                 PreviewKeyDown="ElementProperty_PreviewKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="الارتفاع" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ElementHeightTextBox" Text="34" Style="{StaticResource StudioInput}"
                                                 Height="38" FlowDirection="LeftToRight" LostFocus="ElementProperty_LostFocus"
                                                 PreviewKeyDown="ElementProperty_PreviewKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="الدوران °" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ElementAngleTextBox" Text="0" Style="{StaticResource StudioInput}"
                                                 Height="38" FlowDirection="LeftToRight" LostFocus="ElementProperty_LostFocus"
                                                 PreviewKeyDown="ElementProperty_PreviewKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="حجم الخط" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ElementFontSizeTextBox" Text="11" Style="{StaticResource StudioInput}"
                                                 Height="38" FlowDirection="LeftToRight" LostFocus="ElementProperty_LostFocus"
                                                 PreviewKeyDown="ElementProperty_PreviewKeyDown"/>
                                    </StackPanel>
                                </UniformGrid></Expander>

                                <Separator Background="#E6ECF3" Margin="0,0,0,12"/>
                                <TextBlock Text="النص والتنسيق" FontSize="12.5" FontWeight="Bold"
                                           Foreground="#233653" Margin="1,0,0,8"/>
                                <TextBlock Text="محتوى العنصر" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SelectedElementTextBox" Text="50723015" Style="{StaticResource StudioInput}"
                                         Height="40" FontSize="13" FlowDirection="LeftToRight" Margin="0,0,0,10"
                                         TextChanged="SelectedElementTextBox_TextChanged"
                                         LostFocus="SelectedElementTextBox_LostFocus"
                                         ToolTip="يتغير محتوى العنصر مباشرة عند الكتابة"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="نوع الخط" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="FontFamilyComboBox" Height="38" SelectedIndex="0"
                                                  VerticalContentAlignment="Center" SelectionChanged="FontFamilyComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                                            <ComboBoxItem Content="Arial" Tag="Arial"/>
                                            <ComboBoxItem Content="Tahoma" Tag="Tahoma"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <ToggleButton x:Name="BoldElementCheckBox" Grid.Column="2" Content="B"
                                                  IsChecked="True" Width="46" Height="38" Margin="0,18,0,0"
                                                  Style="{StaticResource StudioAlignmentToggleStyle}"
                                                  FontSize="15" FontWeight="Bold" Click="ElementStyleControl_Click"
                                                  ToolTip="تفعيل أو إيقاف الخط العريض"/>
                                    <ToggleButton x:Name="ItalicElementCheckBox" Grid.Column="4" Content="I"
                                                  IsChecked="False" Width="46" Height="38" Margin="0,18,0,0"
                                                  Style="{StaticResource StudioAlignmentToggleStyle}"
                                                  FontSize="15" FontStyle="Italic" Click="ElementStyleControl_Click"
                                                  ToolTip="تفعيل أو إيقاف الخط المائل"/>
                                </Grid>

                                <TextBlock Text="محاذاة النص" Style="{StaticResource StudioHint}" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,0,0,12">
                                    <ToggleButton x:Name="ElementTextAlignLeftButton" Style="{StaticResource StudioAlignmentToggleStyle}"
                                                  Click="ElementTextAlignLeftButton_Click" ToolTip="محاذاة إلى اليسار">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ElementTextAlignCenterButton" Style="{StaticResource StudioAlignmentToggleStyle}"
                                                  Click="ElementTextAlignCenterButton_Click" ToolTip="توسيط النص">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ElementTextAlignRightButton" Style="{StaticResource StudioAlignmentToggleStyle}"
                                                  Click="ElementTextAlignRightButton_Click" ToolTip="محاذاة إلى اليمين">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    </ToggleButton>
                                </StackPanel>

                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="شفافية العنصر" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="#263B59" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ElementOpacityValueTextBlock" Grid.Column="1" Text="100%"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#263B59"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Slider x:Name="ElementOpacitySlider" Minimum="0" Maximum="100" Value="100"
                                        SmallChange="1" LargeChange="10" TickFrequency="5" Height="25"
                                        Margin="2,0,2,11" FlowDirection="LeftToRight"
                                        ValueChanged="ElementOpacitySlider_ValueChanged"
                                        ToolTip="التحكم في شفافية العنصر المحدد من 0% إلى 100%"/>

                                <TextBlock Text="الألوان والإطار" FontSize="12.5" FontWeight="Bold"
                                           Foreground="#233653" Margin="1,0,0,8"/>
                                <UniformGrid Columns="2" Rows="1" Margin="0,0,0,7">
                                    <Button x:Name="ElementForegroundColorButton" Height="40" Margin="3"
                                            Style="{StaticResource StudioActionButton}" Click="ElementForegroundColorButton_Click"
                                            ToolTip="اختيار لون النص">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="لون النص" FontSize="11.5" Margin="0,0,6,0"/>
                                            <Border x:Name="ElementForegroundColorSwatch" Width="20" Height="20"
                                                    CornerRadius="5" Background="#22252A" BorderBrush="#64748B" BorderThickness="1"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ElementBackgroundColorButton" Height="40" Margin="3"
                                            Style="{StaticResource StudioActionButton}" Click="ElementBackgroundColorButton_Click"
                                            ToolTip="اختيار لون خلفية العنصر">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="لون الخلفية" FontSize="11.5" Margin="0,0,6,0"/>
                                            <Border x:Name="ElementBackgroundColorSwatch" Width="20" Height="20"
                                                    CornerRadius="5" Background="#FFFFFF" BorderBrush="#64748B" BorderThickness="1"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <TextBlock Text="قيم الألوان (HEX)" Style="{StaticResource StudioHint}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
