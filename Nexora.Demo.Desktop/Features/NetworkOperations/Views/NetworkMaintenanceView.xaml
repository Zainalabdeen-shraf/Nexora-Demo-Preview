<UserControl x:Class="Nexora.Demo.Desktop.Features.NetworkOperations.Views.NetworkMaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <DockPanel><StackPanel><TextBlock Text="FIELD SERVICE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="الأعطال والصيانة الميدانية" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/><TextBlock Text="حوّل التنبيهات إلى مهام، وعيّن الفني، وسجّل الإجراء ونتيجة الفحص." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Left" Content="مهمة جديدة" Style="{StaticResource PrimaryButton}" Click="NewTaskButton_Click" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel>
            </Border>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="إجمالي المهام" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TasksTotalTextBlock" Text="3" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="مفتوحة" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TasksOpenTextBlock" Text="2" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="مكتملة" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TasksCompletedTextBlock" Text="1" FontSize="22" FontWeight="Bold" Foreground="#16865A" Margin="0,5,0,0"/></StackPanel></Border>
            </Grid>
            <Border x:Name="TaskEditorPanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel><TextBlock Text="إنشاء مهمة صيانة" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="عنوان المهمة" Margin="0,0,0,5"/><TextBox x:Name="TaskTitleTextBox" Padding="8"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="الجهاز" Margin="0,0,0,5"/><ComboBox x:Name="TaskDeviceComboBox" Padding="7" DisplayMemberPath="Name"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="الأولوية" Margin="0,0,0,5"/><ComboBox x:Name="TaskPriorityComboBox" Padding="7"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="الفني المسؤول" Margin="0,0,0,5"/><TextBox x:Name="TaskAssigneeTextBox" Padding="8"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,10"><TextBlock Text="وصف المشكلة أو خطوات الفحص" Margin="0,0,0,5"/><TextBox x:Name="TaskNotesTextBox" Padding="8" MinHeight="58" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
                    </Grid>
                    <WrapPanel><Button Content="حفظ المهمة" Style="{StaticResource PrimaryButton}" Click="SaveTaskButton_Click" Margin="0,0,8,8"/><Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="CancelTaskButton_Click" Margin="0,0,0,8"/></WrapPanel>
                    <TextBlock x:Name="TaskEditorStatusTextBlock" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,12">
                <StackPanel><DockPanel Margin="4,2,4,10"><TextBlock Text="قائمة مهام الصيانة" FontSize="15" FontWeight="Bold"/><ComboBox x:Name="TaskStatusFilterComboBox" DockPanel.Dock="Left" Width="150" Padding="6" SelectionChanged="TaskStatusFilter_Changed"/></DockPanel>
                    <DataGrid x:Name="TasksDataGrid" ItemsSource="{Binding VisibleTasks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="TasksDataGrid_SelectionChanged" MinHeight="250" MaxHeight="390" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المهمة" Binding="{Binding Id}" Width="0.9*"/>
                            <DataGridTextColumn Header="المهمة" Binding="{Binding Title}" Width="1.5*"/>
                            <DataGridTextColumn Header="الجهاز" Binding="{Binding DeviceName}" Width="0.9*"/>
                            <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="1.1*"/>
                            <DataGridTextColumn Header="الأولوية" Binding="{Binding Priority}" Width="0.7*"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="0.9*"/>
                            <DataGridTextColumn Header="الفني" Binding="{Binding AssignedTo}" Width="0.9*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border x:Name="SelectedTaskPanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel><TextBlock Text="إجراءات المهمة" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="SelectedTaskDetailsTextBlock" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button Content="بدء التنفيذ" Style="{StaticResource PrimaryButton}" Click="StartTaskButton_Click" Margin="0,0,8,8"/><Button Content="إغلاق بعد الفحص" Style="{StaticResource SecondaryButton}" Click="CompleteTaskButton_Click" Margin="0,0,8,8"/><Button Content="إعادة فتح" Style="{StaticResource SecondaryButton}" Click="ReopenTaskButton_Click" Margin="0,0,8,8"/><Button Content="عرض الأجهزة" Style="{StaticResource SecondaryButton}" Click="OpenDevicesButton_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="TaskActionStatusTextBlock" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <TextBlock Text="تغيير حالة المهمة يسجل تفاعلًا داخل الديمو فقط. لا يتم إرسال أوامر للأجهزة." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>