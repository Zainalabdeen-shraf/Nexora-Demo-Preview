<UserControl x:Class="Nexora.Demo.Desktop.Features.NetworkOperations.Views.NetworkSitesDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <DockPanel><StackPanel><TextBlock Text="حصر البنية الميدانية" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="المواقع والأجهزة" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/><TextBlock Text="سجّل دور كل جهاز وموقعه وعلاقته بالأجهزة الأخرى. الحالات المعروضة تجريبية." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Left" Content="إضافة جهاز" Style="{StaticResource PrimaryButton}" Click="ShowAddDeviceButton_Click" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel>
            </Border>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="إجمالي الأجهزة" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalDevicesTextBlock" Text="12" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="مواقع مسجلة" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalSitesTextBlock" Text="4" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="تحتاج مراجعة" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NeedsReviewTextBlock" Text="3" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0"/></StackPanel></Border>
            </Grid>
            <Border x:Name="AddDevicePanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel><TextBlock Text="تسجيل جهاز تجريبي" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="اسم الجهاز" Margin="0,0,0,5"/><TextBox x:Name="NewDeviceNameTextBox" Padding="8"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="نوع الجهاز / دوره" Margin="0,0,0,5"/><ComboBox x:Name="NewDeviceTypeComboBox" Padding="7"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="الموقع" Margin="0,0,0,5"/><ComboBox x:Name="NewDeviceSiteComboBox" Padding="7" DisplayMemberPath="Name"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="الجهاز الأب / نقطة الربط" Margin="0,0,0,5"/><ComboBox x:Name="NewDeviceParentComboBox" Padding="7" DisplayMemberPath="Name"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,10"><TextBlock Text="عنوان الإدارة (اختياري)" Margin="0,0,0,5"/><TextBox x:Name="NewDeviceAddressTextBox" Padding="8" FlowDirection="LeftToRight"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="ملاحظات" Margin="0,0,0,5"/><TextBox x:Name="NewDeviceNotesTextBox" Padding="8"/></StackPanel>
                    </Grid>
                    <WrapPanel><Button Content="حفظ الجهاز في الديمو" Style="{StaticResource PrimaryButton}" Click="SaveNewDeviceButton_Click" Margin="0,0,8,8"/><Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Click="CancelNewDeviceButton_Click" Margin="0,0,0,8"/></WrapPanel>
                    <TextBlock x:Name="AddDeviceStatusTextBlock" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="البحث والتصفية" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DeviceSearchTextBox" Grid.Column="0" Padding="8" ToolTip="ابحث باسم الجهاز أو عنوانه أو الموقع" TextChanged="DeviceFilters_Changed"/>
                        <ComboBox x:Name="DeviceTypeFilterComboBox" Grid.Column="2" Padding="7" SelectionChanged="DeviceFilters_Changed"/>
                        <ComboBox x:Name="DeviceSiteFilterComboBox" Grid.Column="4" Padding="7" SelectionChanged="DeviceFilters_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="4,2,4,10"><TextBlock Text="سجل الأجهزة" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="VisibleDevicesTextBlock" DockPanel.Dock="Left" Text="12 جهازًا" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
                    <DataGrid x:Name="DevicesDataGrid" ItemsSource="{Binding VisibleDevices}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DevicesDataGrid_SelectionChanged" MinHeight="290" MaxHeight="430" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الجهاز" Binding="{Binding Name}" Width="1.1*"/>
                            <DataGridTextColumn Header="الدور" Binding="{Binding Type}" Width="1.2*"/>
                            <DataGridTextColumn Header="الموقع" Binding="{Binding SiteName}" Width="1.1*"/>
                            <DataGridTextColumn Header="الجهاز الأب" Binding="{Binding ParentDevice}" Width="1*"/>
                            <DataGridTextColumn Header="عنوان الإدارة" Binding="{Binding ManagementAddress}" Width="1.1*"/>
                            <DataGridTextColumn Header="الحالة في الديمو" Binding="{Binding Status}" Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
            <Border x:Name="SelectedDevicePanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel><TextBlock Text="تفاصيل الجهاز المحدد" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="SelectedDeviceDetailsTextBlock" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button Content="عرض المتصلين والاستهلاك" Style="{StaticResource PrimaryButton}" Click="OpenClientsButton_Click" Margin="0,0,8,0"/><Button Content="إنشاء مهمة صيانة" Style="{StaticResource SecondaryButton}" Click="CreateTaskForDeviceButton_Click"/></WrapPanel></StackPanel>
            </Border>
            <TextBlock x:Name="PageStatusTextBlock" Text="المواقع والعناوين هنا بيانات تعريف تجريبية، وليست اكتشافًا تلقائيًا للشبكة." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>