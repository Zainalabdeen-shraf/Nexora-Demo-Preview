<UserControl x:Class="Nexora.Demo.Desktop.Features.NetworkOperations.Views.NetworkAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NETWORK INSIGHTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="تحليلات الشبكة" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/>
                        <TextBlock Text="مقارنة استهلاك السيناريو وحالة الأجهزة حسب الفترة المحددة." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="الفترة" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="PeriodComboBox" Padding="7" SelectionChanged="PeriodComboBox_SelectionChanged"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <TextBlock Text="الأرقام مستمدة من سيناريو محلي لسبعة أيام؛ تقديرات اليوم و30 يومًا محسوبة من المتوسط، وليست قياسات مباشرة من RouterOS. في الربط الفعلي يجب إظهار مصدر القراءة ووقت جمعها." FontSize="11" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
            </Border>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel><TextBlock Text="التنزيل التقديري" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="UsageTotalTextBlock" Text="1.3 TB" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="للفترة المحددة" FontSize="9.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel><TextBlock Text="أعلى موقع في السيناريو" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="TopSiteTextBlock" Text="الحي الشرقي" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel><TextBlock Text="أجهزة تحتاج مراجعة" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="DevicesNeedReviewTextBlock" Text="3" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/><TextBlock x:Name="DevicesCountTextBlock" Text="من 12 سجلًا" FontSize="9.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="الاستهلاك حسب الموقع" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="حصة كل موقع من إجمالي التنزيل التوضيحي." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
                        <ItemsControl ItemsSource="{Binding UsageBySite}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,13">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Caption}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/></Grid>
                                        <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ProgressBar Value="{Binding SharePercent}" Maximum="100" Height="8" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SharePercent, StringFormat={}{0}%}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/></Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel>
                        <TextBlock Text="حالة الأجهزة" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="ملخص الحالات المعرفة في بيانات العرض، وليس فحصًا فعليًا." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="متصل في السيناريو" FontSize="11.5"/><TextBlock x:Name="ScenarioOnlineTextBlock" Grid.Column="1" Text="8" FontWeight="Bold" Foreground="#16865A"/></Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="غير متصل أو يحتاج مراجعة" FontSize="11.5" TextWrapping="Wrap"/><TextBlock x:Name="ScenarioReviewTextBlock" Grid.Column="1" Text="3" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></Grid>
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="غير معروف / غير مختبر" FontSize="11.5"/><TextBlock x:Name="ScenarioUnknownTextBlock" Grid.Column="1" Text="1" FontWeight="Bold"/></Grid>
                        <WrapPanel>
                            <Button Content="عرض الأجهزة" Style="{StaticResource PrimaryButton}" Click="OpenDevicesButton_Click" Margin="0,0,8,8"/>
                            <Button Content="عرض المتصلين" Style="{StaticResource SecondaryButton}" Click="OpenClientsButton_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="AnalyticsStatusTextBlock" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>