<Window x:Class="Nexora.Demo.Desktop.Features.Packages.Views.QuickPackageCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إنشاء باقة جديدة"
        Width="790"
        MinWidth="790"
        MaxWidth="790"
        MinHeight="420"
        MaxHeight="650"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="Tahoma"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PkgRedBrush" Color="#BE1726" />
        <SolidColorBrush x:Key="PkgRedHoverBrush" Color="#A91623" />
        <SolidColorBrush x:Key="PkgRedLightBrush" Color="#FCEDEF" />
        <SolidColorBrush x:Key="PkgBorderBrush" Color="#D7E0EA" />
        <SolidColorBrush x:Key="PkgTextBrush" Color="#142B4B" />
        <SolidColorBrush x:Key="PkgMutedBrush" Color="#657A99" />

        <Style x:Key="PkgFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#536A89" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CBD6E4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#173253" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#BE1726" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#9BAEC5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Background" Value="#F0F3F7" />
                                <Setter Property="Foreground" Value="#8392A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="BorderBrush" Value="#CBD6E4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#173253" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" CornerRadius="6" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,25,0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              IsHitTestVisible="False" />
                            <Path Data="M 0,0 L 4,4 L 8,0"
                                  Stroke="#71839B"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD6E4"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="2">
                                    <ScrollViewer MaxHeight="256" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#9BAEC5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#BE1726" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#BE1726" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Background" Value="#F0F3F7" />
                                <Setter Property="Foreground" Value="#8392A6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#173253" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FCEDEF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="#BE1726" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#526B8C" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1,1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PkgRtlCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#526B8C" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1,1" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True" FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Grid.Column="0" Width="14" Height="14" CornerRadius="4" BorderBrush="#AAB8C9" BorderThickness="1" Background="#FFFFFF" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 2,7 L 5,10 L 12,3" Stroke="#FFFFFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Right" RecognizesAccessKey="True" ContentSource="Content" FlowDirection="RightToLeft" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#BE1726" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#BE1726" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PkgToggleSwitchCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#526B8C" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="1,1" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True" FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="32" Height="18" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <Border x:Name="SwitchTrack" Background="#D5DCE5" CornerRadius="9" BorderBrush="#C3CDD9" BorderThickness="1" />
                                <Ellipse x:Name="SwitchThumb" Width="12" Height="12" Fill="#FFFFFF" Stroke="#C7D0DC" StrokeThickness="0.5" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform><TranslateTransform X="0" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Center" HorizontalAlignment="Right" RecognizesAccessKey="True" ContentSource="Content" FlowDirection="RightToLeft" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#BE1726" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#BE1726" />
                                <Setter TargetName="SwitchThumb" Property="RenderTransform"><Setter.Value><TranslateTransform X="14" /></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#142B4B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Padding" Value="16,2" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#BE1726" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#BE1726" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#344966" />
            <Setter Property="BorderBrush" Value="#CCD7E4" />
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="#F7F8FA" />
            <Setter Property="Foreground" Value="#526B8C" />
            <Setter Property="BorderBrush" Value="#E3E8EF" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowChromeBorder"
            Background="#F7F9FC"
            BorderBrush="#D5DFEA"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E0E6EE"
                    BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0"
                    Padding="14,6"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="×" Style="{StaticResource CloseButtonStyle}" IsCancel="True" ToolTip="إغلاق النافذة" />
                    <CheckBox x:Name="BindingEnabledCheckBox"
                              Grid.Column="1"
                              Content="إيقاف"
                              IsChecked="True"
                              Visibility="Collapsed"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Checked="BindingEnabledCheckBox_StateChanged"
                              Unchecked="BindingEnabledCheckBox_StateChanged"
                              ToolTip="إيقاف أو تشغيل الباقة في النظام الحالي فقط"
                              Style="{StaticResource PkgToggleSwitchCheckBoxStyle}" />
                    <TextBlock Grid.Column="2" Text="إنشاء باقة جديدة" FontSize="13" FontWeight="Bold" Foreground="#142B4B" VerticalAlignment="Center" Margin="0,0,2,0" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Margin="14,9,14,5"
                          Focusable="False"
                          Background="Transparent">
                <StackPanel x:Name="PackageScrollableContent" Margin="0">
                    <!-- Hidden compatibility elements retained for the existing code-behind. -->
                    <Border x:Name="PackageCommercialAccentLine" Height="0" Visibility="Collapsed" />
                    <TextBlock x:Name="SourceSettingsIconTextBlock" Visibility="Collapsed" Text="⚙" />
                    <TextBlock x:Name="SourceSettingsTitleTextBlock" Visibility="Collapsed" Text="إعدادات المصدر" />

                    <Grid x:Name="PackageCommercialLayoutV2" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 1: name, quota, validity. -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.05*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="اسم الباقة *" />
                                <TextBox x:Name="PackageNameTextBox" ToolTip="اسم الباقة" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="حصة البيانات" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DataQuotaAmountTextBox" Grid.Column="0" Text="500" HorizontalContentAlignment="Center" />
                                    <ComboBox x:Name="DataQuotaUnitComboBox" Grid.Column="1" SelectedIndex="0" Margin="4,0,0,0">
                                        <ComboBoxItem Tag="MB" Content="ميجابايت" />
                                        <ComboBoxItem Tag="GB" Content="جيجابايت" />
                                    </ComboBox>
                                    <CheckBox x:Name="UnlimitedDataCheckBox" Grid.Column="2" Content="بلا حد" ToolTip="بدون حد لحصة البيانات" Checked="LimitOption_Changed" Unchecked="LimitOption_Changed" Style="{StaticResource PkgToggleSwitchCheckBoxStyle}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="مدة الصلاحية" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ValidityDaysTextBox" Grid.Column="0" Text="7" HorizontalContentAlignment="Center" />
                                    <ComboBox x:Name="ValidityUnitComboBox" Grid.Column="1" SelectedIndex="0" Margin="4,0,0,0" ToolTip="وحدة مدة الصلاحية">
                                        <ComboBoxItem Tag="days" Content="أيام" />
                                        <ComboBoxItem Tag="hours" Content="ساعات" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: prices and commission. -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.65*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="سعر البيع (ريال يمني) *" />
                                <TextBox x:Name="SalePriceTextBox" Text="100" HorizontalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="السعر المطبوع على الكرت" />
                                <TextBox x:Name="CardDisplayPriceTextBox" Text="100" HorizontalContentAlignment="Center" />
                            </StackPanel>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="0.65*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="نوع العمولة" />
                                    <ComboBox x:Name="CommissionModeComboBox" SelectedIndex="0">
                                        <ComboBoxItem Tag="Percentage" Content="نسبة مئوية" />
                                        <ComboBoxItem Tag="Fixed" Content="مبلغ ثابت" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                    <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="قيمة العمولة" />
                                    <TextBox x:Name="CommissionValueTextBox" Text="0" HorizontalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" MinWidth="74">
                                    <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="تفعيل العمولة" />
                                    <CheckBox x:Name="CommissionEnabledCheckBox" Content="تفعيل" Checked="CommissionEnabled_Changed" Unchecked="CommissionEnabled_Changed" Style="{StaticResource PkgToggleSwitchCheckBoxStyle}" Margin="0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Row 3: usage hours followed by download/upload speeds. -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="ساعات" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UptimeHoursTextBox" Grid.Column="0" Text="0" ToolTip="الساعات" HorizontalContentAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="س" Style="{StaticResource PkgFieldLabelStyle}" VerticalAlignment="Center" Margin="4,0" />
                                    <TextBox x:Name="UptimeMinutesTextBox" Grid.Column="2" Text="0" ToolTip="الدقائق" HorizontalContentAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="د" Style="{StaticResource PkgFieldLabelStyle}" VerticalAlignment="Center" Margin="4,0" />
                                    <CheckBox x:Name="UnlimitedUptimeCheckBox" Grid.Column="4" Content="مفتوحة" ToolTip="بدون حد لإجمالي ساعات الاستخدام" Checked="LimitOption_Changed" Unchecked="LimitOption_Changed" Style="{StaticResource PkgToggleSwitchCheckBoxStyle}" Margin="3,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="سرعة التنزيل (ميجابت/ث)" />
                                <TextBox x:Name="DownloadMbpsTextBox" Text="2" HorizontalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="سرعة الرفع (ميجابت/ث)" />
                                <TextBox x:Name="UploadMbpsTextBox" Text="0.5" HorizontalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: users, allowed days, allowed time. -->
                        <Grid Grid.Row="3" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                <TextBlock x:Name="ConcurrentUsersLabel" Style="{StaticResource PkgFieldLabelStyle}" Text="عدد المستخدمين المتزامنين" />
                                <ComboBox x:Name="HotSpotSharedUsersComboBox" SelectedIndex="0">
                                    <ComboBoxItem Tag="1" Content="جلسة واحدة" />
                                    <ComboBoxItem Tag="2" Content="جلستان" />
                                    <ComboBoxItem Tag="3" Content="3 جلسات" />
                                    <ComboBoxItem Tag="5" Content="5 جلسات" />
                                    <ComboBoxItem Tag="0" Content="غير محدود" />
                                </ComboBox>
                                <ComboBox x:Name="UserManagerSharedOverrideComboBox" Visibility="Collapsed" SelectedIndex="0">
                                    <ComboBoxItem Tag="off" Content="استخدام الإعداد الأصلي" />
                                    <ComboBoxItem Tag="unlimited" Content="غير محدود" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,9,0">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="الأيام المسموحة" />
                                <ComboBox x:Name="DaysPolicyComboBox" SelectedIndex="0" SelectionChanged="PolicySelection_Changed">
                                    <ComboBoxItem Tag="all" Content="كل الأيام" />
                                    <ComboBoxItem Tag="custom" Content="أيام محددة" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="الفترة الزمنية المسموحة" />
                                <ComboBox x:Name="PeriodPolicyComboBox" SelectedIndex="0" SelectionChanged="PolicySelection_Changed">
                                    <ComboBoxItem Tag="full-day" Content="كامل اليوم (24 ساعة)" />
                                    <ComboBoxItem Tag="custom" Content="فترة مخصصة" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <WrapPanel x:Name="CustomDaysPanel" Visibility="Collapsed" FlowDirection="RightToLeft" Margin="0,7,0,0">
                        <CheckBox x:Name="SaturdayCheckBox" Content="السبت" Margin="0,0,13,0" />
                        <CheckBox x:Name="SundayCheckBox" Content="الأحد" Margin="0,0,13,0" />
                        <CheckBox x:Name="MondayCheckBox" Content="الإثنين" Margin="0,0,13,0" />
                        <CheckBox x:Name="TuesdayCheckBox" Content="الثلاثاء" Margin="0,0,13,0" />
                        <CheckBox x:Name="WednesdayCheckBox" Content="الأربعاء" Margin="0,0,13,0" />
                        <CheckBox x:Name="ThursdayCheckBox" Content="الخميس" Margin="0,0,13,0" />
                        <CheckBox x:Name="FridayCheckBox" Content="الجمعة" Margin="0,0,0,0" />
                    </WrapPanel>

                    <Grid x:Name="AccessTimeFieldsPanel" Visibility="Collapsed" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="من الساعة (24 ساعة)" />
                            <TextBox x:Name="AccessFromTextBox" Text="08:00" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="إلى الساعة (24 ساعة)" />
                            <TextBox x:Name="AccessUntilTextBox" Text="18:00" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="#E0E7EF" Margin="0,10,0,9" />

                    <!-- Provider-specific settings are intentionally the final fields. -->
                    <Grid>
                        <Grid x:Name="HotSpotSourcePanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                    <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="ملف البروفايل الافتراضي" />
                                    <ComboBox x:Name="HotSpotProfileComboBox" SelectedIndex="0">
                                        <ComboBoxItem Tag="default" Content="البروفايل الافتراضي" />
                                        <ComboBoxItem Tag="HS-1H-500M" Content="ساعة واحدة — 500 ميجابايت" />
                                        <ComboBoxItem Tag="HS-6H-2G" Content="6 ساعات — 2 جيجابايت" />
                                        <ComboBoxItem Tag="HS-24H-5G" Content="24 ساعة — 5 جيجابايت" />
                                        <ComboBoxItem Tag="HS-7D-20G" Content="أسبوع — 20 جيجابايت" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="HotSpotServerPanel" Grid.Column="1">
                                    <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="خادم الهوتسبوت" />
                                    <ComboBox x:Name="HotSpotServerComboBox" SelectedIndex="0">
                                        <ComboBoxItem Tag="hotspot1" Content="الخادم الافتراضي" />
                                        <ComboBoxItem Tag="all" Content="كل الخوادم" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,7,0,0">
                                <CheckBox x:Name="PreserveUsageOnRouterInterruptionCheckBox" Content="الاحتفاظ بسجل الاستهلاك" IsChecked="True" Style="{StaticResource PkgRtlCheckBoxStyle}" />
                                <CheckBox x:Name="PreserveTimeOnRouterInterruptionCheckBox" Content="الاحتفاظ بوقت الجلسة" IsChecked="True" Style="{StaticResource PkgRtlCheckBoxStyle}" />
                                <CheckBox x:Name="RecordHotSpotSessionsCheckBox" Content="تسجيل جلسات هوتسبوت" IsChecked="True" Style="{StaticResource PkgRtlCheckBoxStyle}" />
                            </UniformGrid>
                        </Grid>

                        <Grid x:Name="UserManagerSourcePanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.15*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                    <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="ملف مدير المستخدمين" />
                                    <ComboBox x:Name="UserManagerProfileComboBox" SelectedIndex="0">
                                        <ComboBoxItem Tag="UM-1H-500M" Content="باقة ساعة واحدة" />
                                        <ComboBoxItem Tag="UM-6H-2G" Content="باقة 6 ساعات" />
                                        <ComboBoxItem Tag="UM-24H-5G" Content="باقة 24 ساعة" />
                                        <ComboBoxItem Tag="UM-7D-20G" Content="باقة أسبوع" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,9,0">
                                    <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="مجموعة المستخدمين" />
                                    <ComboBox x:Name="UserManagerGroupComboBox" SelectedIndex="0">
                                        <ComboBoxItem Tag="default" Content="المجموعة الافتراضية" />
                                        <ComboBoxItem Tag="retailers" Content="موزعو التجزئة" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="محدد الاستخدام" />
                                    <ComboBox x:Name="UserManagerLimitationComboBox" SelectedIndex="0">
                                        <ComboBoxItem Tag="limit-hour-500mb-2m" Content="ساعة — 500 ميجابايت" />
                                        <ComboBoxItem Tag="limit-six-hours-2gb-4m" Content="6 ساعات — 2 جيجابايت" />
                                        <ComboBoxItem Tag="limit-daily-5gb-6m" Content="يومي — 5 جيجابايت" />
                                        <ComboBoxItem Tag="limit-weekly-20gb-8m" Content="أسبوعي — 20 جيجابايت" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="UserManagerStartsWhenPanel" Grid.Row="1" MaxWidth="350" Margin="0,7,0,0">
                                <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="بدء احتساب الصلاحية" />
                                <ComboBox x:Name="UserManagerStartsWhenComboBox" SelectedIndex="0">
                                    <ComboBoxItem Tag="first-auth" Content="عند أول مصادقة" />
                                    <ComboBoxItem Tag="assigned" Content="من وقت إسناد الملف" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#E0E6EE"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,11,11"
                    Padding="14,8">
                <Grid FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="QuickCreateStatusTextBlock"
                               Grid.Column="0"
                               Foreground="#B42318"
                               FontSize="10"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <Button x:Name="SavePackageButton"
                                Content="حفظ الباقة"
                                Click="SavePackageButton_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="112"
                                Margin="0,0,7,0" />
                        <Button x:Name="CancelButton"
                                Content="إلغاء"
                                IsCancel="True"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="84" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hidden editor used only to reuse existing validation and persistence. -->
            <Grid x:Name="LogicHostContainer" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
    </Border>
</Window>
