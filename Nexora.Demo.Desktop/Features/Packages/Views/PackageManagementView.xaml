                                    MaxWidth="340">
                                <TextBlock x:Name="EmptyStateTextBlock"
                                           Text="لا توجد باقات مطابقة للفلاتر الحالية."
                                           Foreground="#657A99"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>

                        <!-- Full-width rounded primary action; no surrounding box or separator. -->
                        <Grid Grid.Row="2" Margin="0,8,0,2">
                            <Button x:Name="CreateNewPackageButton"
                                    Content="إنشاء باقة جديدة"
                                    Click="CreateNewPackageButton_Click"
                                    Height="44"
                                    Margin="0"
                                    Padding="14,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="#BE1726"
                                    Foreground="White"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Style="{StaticResource PkgPrimaryActionButtonStyle}" />

                            <!-- يبقى الاسم موجودًا لتوافق الكود الحالي، دون عرض رسالة أسفل الزر. -->
                            <TextBlock x:Name="StatusTextBlock"
                                    Visibility="Collapsed"
                                    Text=""
                                    Foreground="#657A99"
                                    FontSize="10" />
                        </Grid>
                    </Grid>
            </TabItem>
        
        </TabControl>
        <Grid x:Name="PackageNoticeOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Panel.ZIndex="1000"
            Visibility="Collapsed"
            Background="#55142B4B"
            Focusable="True">

            <Border x:Name="PackageNoticeCard"
                    Width="410"
                    MaxWidth="460"
                    Padding="22"
                    Background="White"
                    BorderBrush="#D7E0EA"
                    BorderThickness="1"
                    CornerRadius="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect Color="#142B4B"
                                    BlurRadius="26"
                                    ShadowDepth="5"
                                    Opacity="0.18" />
                </Border.Effect>

                <StackPanel FlowDirection="RightToLeft">

                    <Border x:Name="PackageNoticeIconBadge"
                            Width="52"
                            Height="52"
                            CornerRadius="26"
                            Background="#DCFCE7"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,13">

                        <TextBlock x:Name="PackageNoticeIconTextBlock"
                                Text="✓"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#166534"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="PackageNoticeTitleTextBlock"
                            Text="تمت العملية بنجاح"
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="#166534"
                            TextAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,9" />

                    <TextBlock x:Name="PackageNoticeMessageTextBlock"
                            Text="تم تنفيذ العملية بنجاح."
                            FontSize="12"
                            Foreground="#526B8C"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Margin="0,0,0,20" />

                    <Button x:Name="PackageNoticeCloseButton"
                            Content="حسنًا"
                            Click="PackageNoticeCloseButton_Click"
                            Height="40"
                            MinWidth="120"
                            Padding="22,0"
                            HorizontalAlignment="Center"
                            Background="#BE1726"
                            Foreground="White"
                            BorderBrush="#BE1726"
                            FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
