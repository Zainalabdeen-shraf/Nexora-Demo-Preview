                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusDisplay}" Value="نشطة">
                                <Setter Property="Background" Value="#DCFCE7"/>
                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusDisplay}" Value="متوقفة">
                                <Setter Property="Background" Value="#FEF3C7"/>
                                <Setter Property="BorderBrush" Value="#FCD34D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusDisplay}" Value="مؤرشفة">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusDisplay}" Value="غير مرتبطة">
                                <Setter Property="Background" Value="#FCE7F3"/>
                                <Setter Property="BorderBrush" Value="#F9A8D4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold"
                           TextAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="#475569"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusDisplay}" Value="نشطة">
                                    <Setter Property="Foreground" Value="#166534"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusDisplay}" Value="متوقفة">
                                    <Setter Property="Foreground" Value="#92400E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusDisplay}" Value="مؤرشفة">
                                    <Setter Property="Foreground" Value="#475569"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusDisplay}" Value="غير مرتبطة">
                                    <Setter Property="Foreground" Value="#9D174D"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>
    </DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
                                    <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAtDisplay}" Width="1*" />
