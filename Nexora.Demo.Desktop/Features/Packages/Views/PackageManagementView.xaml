<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Nexora.Demo.Desktop.Features.Packages.Views.PackageManagementView" FlowDirection="RightToLeft" Background="#F4F6F9" FontFamily="Tahoma" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PkgRedBrush" Color="#BE1726" />
        <SolidColorBrush x:Key="PkgRedLightBrush" Color="#FCEDEF" />
        <LinearGradientBrush x:Key="PkgPanelAccentBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D7192D" Offset="0.0" />
            <GradientStop Color="#D7192D" Offset="0.025" />
            <GradientStop Color="#D7E0EA" Offset="0.055" />
            <GradientStop Color="#D7E0EA" Offset="1.0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PkgBorderBrush" Color="#D7E0EA" />
        <SolidColorBrush x:Key="PkgTextBrush" Color="#142B4B" />
        <SolidColorBrush x:Key="PkgMutedBrush" Color="#657A99" />
        <Style x:Key="PkgFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#536A89" />
            <Setter Property="Margin" Value="1,0,1,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="29" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D3DDE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#173253" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="29" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="BorderBrush" Value="#D3DDE9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FAFBFD" />
            <Setter Property="Foreground" Value="#173253" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#526B8C" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,1" />
        </Style>
        <Style x:Key="PkgRtlCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#526B8C" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid SnapsToDevicePixels="True" FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="15" Height="15" CornerRadius="3" BorderBrush="#AAB8C9" BorderThickness="1" Background="White" VerticalAlignment="Center">
                                <Viewbox Stretch="Uniform" Margin="2">
                                    <Path x:Name="CheckMark" Data="M 1,5 L 4,8 L 10,1" Stroke="#BE1726" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" FlowDirection="LeftToRight" />
                                </Viewbox>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="0,0,7,0" VerticalAlignment="Center" HorizontalAlignment="Right" RecognizesAccessKey="True" ContentSource="Content" FlowDirection="RightToLeft" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PkgToggleSwitchCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#526B8C" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid SnapsToDevicePixels="True" FlowDirection="RightToLeft">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="42" Height="22" VerticalAlignment="Center" FlowDirection="LeftToRight">
                                <Border x:Name="SwitchTrack" Background="#D5DCE5" CornerRadius="11" BorderBrush="#C3CDD9" BorderThickness="1" />
                                <Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="White" Stroke="#C7D0DC" StrokeThickness="0.5" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="0,0,7,0" VerticalAlignment="Center" HorizontalAlignment="Right" RecognizesAccessKey="True" ContentSource="Content" FlowDirection="RightToLeft" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#BE1726" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#BE1726" />
                                <Setter TargetName="SwitchThumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="20" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#142B4B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E1EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EDF3" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEF1F5" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowHeight" Value="27" />
            <Setter Property="ColumnHeaderHeight" Value="29" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style x:Key="PkgSectionHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FCEDEF" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="NexoraPackageTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="NexoraPackageTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#526B8C" />
            <Setter Property="Background" Value="#EDF1F6" />
            <Setter Property="BorderBrush" Value="#D9E1EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#BE1726" />
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,3,1,0" />
                                <Setter Property="Foreground" Value="#BE1726" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="PackageTabs" Grid.Row="0" Grid.RowSpan="2" FlowDirection="RightToLeft" Margin="2,0,2,5" Background="#FFFFFF" Style="{StaticResource NexoraPackageTabControlStyle}" BorderBrush="#D9E1EC" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TabItem x:Name="CreatePackageTab" Header="باقة جديدة" Style="{StaticResource NexoraPackageTabItemStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="PackageScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly" Focusable="False" Margin="0,0,2,5" Background="Transparent" AutomationProperties.Name="محتوى إدارة الباقات">
                        <ScrollViewer.Resources>
                            <Style x:Key="PkgSlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="MinWidth" Value="8" />
                                <Setter Property="Background" Value="#F0F2F5" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                            <Grid Background="Transparent">
                                                <Border Background="#F0F2F5" CornerRadius="4" Margin="2" />
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Focusable="False" IsTabStop="False">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                                    <Border x:Name="ThumbBody" Background="#B9C3D0" CornerRadius="4" Margin="0,1" />
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ThumbBody" Property="Background" Value="#C51D2B" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsDragging" Value="True">
                                                                            <Setter TargetName="ThumbBody" Property="Background" Value="#A91421" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                                                    </Track.IncreaseRepeatButton>
                                                </Track>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="Orientation" Value="Horizontal">
                                                    <Setter Property="Width" Value="Auto" />
                                                    <Setter Property="Height" Value="8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PkgSlimScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="PackageScrollableContent" Margin="2">
                            <Border Background="White" BorderBrush="{StaticResource PkgPanelAccentBorderBrush}" BorderThickness="1,3,1,1" CornerRadius="9" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource PkgSectionHeaderStyle}">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="▤" Foreground="{StaticResource PkgRedBrush}" FontSize="16" FontWeight="Bold" Margin="0,0,0,0" />
                                            <TextBlock Text="بيانات الباقة التجارية" Foreground="{StaticResource PkgTextBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </DockPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="1,0,1,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.92*" />
                                            <ColumnDefinition Width="1.05*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="3,1,3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="اسم الباقة *" />
                                            <TextBox x:Name="PackageNameTextBox" ToolTip="اسم الباقة" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,1,3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="سعر البيع (ريال يمني) *" />
                                            <TextBox x:Name="SalePriceTextBox" Text="100" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,1,3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="السعر المطبوع على الكرت" />
                                            <TextBox x:Name="CardDisplayPriceTextBox" Text="100" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="3,1,3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="مدة الصلاحية (أيام)" />
                                            <TextBox x:Name="ValidityDaysTextBox" Text="7" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Margin="3,1,3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="حصة البيانات" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="88" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="DataQuotaAmountTextBox" Text="500" />
                                                <ComboBox x:Name="DataQuotaUnitComboBox" Grid.Column="1" SelectedIndex="0" Margin="3,0,0,0">
                                                    <ComboBoxItem Tag="MB" Content="ميجابايت" />
                                                    <ComboBoxItem Tag="GB" Content="جيجابايت" />
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="1,4,1,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="0.92*" />
                                            <ColumnDefinition Width="1.05*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
                                            <CheckBox x:Name="UnlimitedDataCheckBox" Content="بلا حد للبيانات" Checked="LimitOption_Changed" Unchecked="LimitOption_Changed" Style="{StaticResource PkgToggleSwitchCheckBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
                                            <CheckBox x:Name="UnlimitedValidityCheckBox" Content="بلا انتهاء تقويمي" Checked="LimitOption_Changed" Unchecked="LimitOption_Changed" Style="{StaticResource PkgToggleSwitchCheckBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0">
                                            <CheckBox x:Name="CommissionEnabledCheckBox" Content="تفعيل العمولة" Checked="CommissionEnabled_Changed" Unchecked="CommissionEnabled_Changed" Style="{StaticResource PkgToggleSwitchCheckBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="نوع العمولة" />
                                            <ComboBox x:Name="CommissionModeComboBox" SelectedIndex="0">
                                                <ComboBoxItem Tag="Percentage" Content="نسبة مئوية" />
                                                <ComboBoxItem Tag="Fixed" Content="مبلغ ثابت" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4" Margin="3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="قيمة العمولة" />
                                            <TextBox x:Name="CommissionValueTextBox" Text="0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Background="White" BorderBrush="{StaticResource PkgPanelAccentBorderBrush}" BorderThickness="1,3,1,1" CornerRadius="9" Padding="8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource PkgSectionHeaderStyle}">
                                        <DockPanel>
                                            <TextBlock Text="◴" Foreground="{StaticResource PkgRedBrush}" FontSize="16" FontWeight="Bold" />
                                            <TextBlock Text="حدود الاستخدام والسرعة" Foreground="{StaticResource PkgTextBrush}" FontSize="13" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Margin="1,0,1,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="سرعة التنزيل (ميجابت/ث)" />
                                            <TextBox x:Name="DownloadMbpsTextBox" Text="2" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="سرعة الرفع (ميجابت/ث)" />
                                            <TextBox x:Name="UploadMbpsTextBox" Text="0.5" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="حد الاستخدام الزمني" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="0.8*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="UptimeHoursTextBox" Text="0" ToolTip="الساعات" />
                                                <TextBox x:Name="UptimeMinutesTextBox" Grid.Column="2" Text="0" ToolTip="الدقائق" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="3,0">
                                            <TextBlock x:Name="ConcurrentUsersLabel" Style="{StaticResource PkgFieldLabelStyle}" Text="عدد المستخدمين المتزامنين" />
                                            <ComboBox x:Name="HotSpotSharedUsersComboBox" SelectedIndex="0">
                                                <ComboBoxItem Tag="1" Content="جلسة واحدة" />
                                                <ComboBoxItem Tag="2" Content="جلستان" />
                                                <ComboBoxItem Tag="3" Content="3 جلسات" />
                                                <ComboBoxItem Tag="5" Content="5 جلسات" />
                                                <ComboBoxItem Tag="0" Content="غير محدود" />
                                            </ComboBox>
                                            <ComboBox x:Name="UserManagerSharedOverrideComboBox" Visibility="Collapsed" SelectedIndex="0">
                                                <ComboBoxItem Tag="off" Content="استخدام الإعداد الأصلي" />
                                                <ComboBoxItem Tag="unlimited" Content="غير محدود" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="1,4,1,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="HotSpotServerPanel" Grid.Column="0" Margin="3,0">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="خادم الهوتسبوت" />
                                            <ComboBox x:Name="HotSpotServerComboBox" SelectedIndex="0">
                                                <ComboBoxItem Tag="hotspot1" Content="الخادم الافتراضي" />
                                                <ComboBoxItem Tag="all" Content="كل الخوادم" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel x:Name="UserManagerStartsWhenPanel" Grid.Column="1" Margin="3,0" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource PkgFieldLabelStyle}" Text="بدء احتساب الصلاحية" />
                                            <ComboBox x:Name="UserManagerStartsWhenComboBox" SelectedIndex="0">
                                                <ComboBoxItem Tag="first-auth" Content="عند أول مصادقة" />
                                                <ComboBoxItem Tag="assigned" Content="من وقت إسناد الملف" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource PkgPanelAccentBorderBrush}" BorderThickness="1,3,1,1" CornerRadius="9" Padding="7" Margin="0,0,3,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Style="{StaticResource PkgSectionHeaderStyle}">
                                            <DockPanel>
                                                <TextBlock x:Name="SourceSettingsIconTextBlock" Text="⚙" Foreground="{StaticResource PkgRedBrush}" FontSize="15" />
                                                <TextBlock x:Name="SourceSettingsTitleTextBlock" Text="إعدادات المصدر (هوتسبوت)" Foreground="{StaticResource PkgTextBrush}" FontSize="12.5" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <Grid x:Name="HotSpotSourcePanel" Margin="1,0,1,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="ملف البروفايل الافتراضي" Style="{StaticResource PkgFieldLabelStyle}" VerticalAlignment="Center" Margin="2,0,8,0" />
                                                    <ComboBox x:Name="HotSpotProfileComboBox" Grid.Column="1" SelectedIndex="0">
                                                        <ComboBoxItem Tag="default" Content="البروفايل الافتراضي" />
                                                        <ComboBoxItem Tag="HS-1H-500M" Content="ساعة واحدة — 500 ميجابايت" />
                                                        <ComboBoxItem Tag="HS-6H-2G" Content="6 ساعات — 2 جيجابايت" />
