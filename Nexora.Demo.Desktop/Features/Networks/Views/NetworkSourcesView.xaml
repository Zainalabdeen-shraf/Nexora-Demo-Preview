                                 Margin="0,0,0,16"/>

                        <Separator/>

                        <TextBlock Text="المصادقة"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,10"/>

                        <TextBlock Text="مصدر المصادقة"
                                   Margin="0,0,0,5"/>
