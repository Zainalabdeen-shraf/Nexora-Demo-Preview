<UserControl x:Class="Nexora.Demo.Desktop.Features.Networks.Views.NetworkSourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{StaticResource PrimaryLightBrush}" CornerRadius="9" Padding="10" Margin="10,0,0,0"><TextBlock Text="↔" FontSize="25" Foreground="{StaticResource PrimaryBrush}" /></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NetworkPageTitleTextBlock" Text="الشبكات ومصادر المصادقة" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="NetworkPageSubtitleTextBlock" Text="اختر مصدر المصادقة لتدير إعداداته التقنية بشكل مستقل مع بقاء مستخدمي الشبكة موحدين في Nexora." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid x:Name="ProviderCardsGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="HotSpotCard" Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="#FBEDEF" CornerRadius="8" Padding="10"><TextBlock Text="HS" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="HotSpot" FontSize="18" FontWeight="Bold"/><TextBlock Text="بوابة دخول المستخدمين" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel>
                        <TextBlock Text="حدد طريقة مصادقة HotSpot: حسابات HotSpot أو مصدر RADIUS مرتبط بالنظام." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <Separator Background="{StaticResource BorderBrushSoft}"/>
                        <Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="حسابات مسجلة في Nexora" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HotSpotAccountsTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="ملف الباقة" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HotSpotPackageBindingsTextBlock" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid>
                        <WrapPanel><Button Content="إدارة الباقات" Style="{StaticResource SecondaryButton}" Click="HotSpotPackagesButton_Click" Margin="0,0,8,0"/><Button Content="إصدار كروت" Style="{StaticResource PrimaryButton}" Tag="hotspot" Click="IssueForSystemButton_Click"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="UserManagerCard" Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="#FBEDEF" CornerRadius="8" Padding="10"><TextBlock Text="UM" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="User Manager" FontSize="18" FontWeight="Bold"/><TextBlock Text="إدارة الحسابات عبر RADIUS" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel>
                        <TextBlock Text="إدارة الحسابات والمجموعات وحدود الاستخدام من خلال User Manager، مع إعدادات ربط خاصة بهذا المصدر." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <Separator Background="{StaticResource BorderBrushSoft}"/>
                        <Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="حسابات مسجلة في Nexora" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UserManagerAccountsTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="ملفات الباقات" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UserManagerPackageBindingsTextBlock" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid>
                        <WrapPanel><Button Content="إدارة الباقات" Style="{StaticResource SecondaryButton}" Click="UserManagerPackagesButton_Click" Margin="0,0,8,0"/><Button Content="إصدار كروت" Style="{StaticResource PrimaryButton}" Tag="user-manager" Click="IssueForSystemButton_Click"/></WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="ProviderDetailPanel" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProviderDetailTitleTextBlock" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="ProviderDetailDescriptionTextBlock" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/>
                    <WrapPanel><Button Content="إدارة مستخدمي الشبكة" Style="{StaticResource SecondaryButton}" Click="OpenUsersButton_Click" Margin="0,0,8,0"/><Button Content="إصدار دفعة" Style="{StaticResource PrimaryButton}" Click="OpenIssuanceButton_Click"/></WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
