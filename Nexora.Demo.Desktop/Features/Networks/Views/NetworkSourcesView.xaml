                                  Padding="8"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="طرق تسجيل الدخول"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="يمكن تحديد أكثر من طريقة للمصادقة."
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <ListBox x:Name="HotSpotLoginMethodsListBox"
                                 SelectionMode="Multiple"
                                 MinHeight="125"
                                 MaxHeight="170"
                                 Margin="0,0,0,12"/>

                        <CheckBox x:Name="HotSpotRadiusAccountingCheckBox"
                                  Content="استخدام محاسبة RADIUS"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="فترة تحديث المحاسبة بالثواني"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="HotSpotRadiusInterimUpdateTextBox"
                                 Padding="8"
                                 Text="300"
                                 FlowDirection="LeftToRight"
                                 Margin="0,0,0,14"/>

                        <Separator/>

                        <TextBlock Text="سياسة جلسة العميل"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,10"/>

                        <CheckBox x:Name="HotSpotUseCookieCheckBox"
                                  Content="السماح باستخدام Cookie"
                                  Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="مدة Cookie بالدقائق"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="HotSpotCookieTimeoutTextBox"
                                         Padding="8"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="خمول العميل بالثواني"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="HotSpotClientIdleTimeoutTextBox"
                                         Padding="8"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Keepalive بالثواني"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="HotSpotKeepaliveTimeoutTextBox"
                                         Padding="8"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="ملاحظات"
                                   Margin="0,14,0,5"/>
                        <TextBox x:Name="HotSpotCommentTextBox"
                                 Padding="8"
                                 MinHeight="50"
                                 MaxLength="300"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="حفظ إعدادات HotSpot"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SaveHotSpotSettingsButton_Click"
                                    Margin="0,0,8,8"/>
                            <Button Content="إعادة تحميل"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ReloadHotSpotSettingsButton_Click"
                                    Margin="0,0,8,8"/>
                            <Button Content="اتصالات الراوتر"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ManageRouterConnectionsButton_Click"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- HotSpot profiles -->
            <TabItem Header="البروفايلات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ListBox x:Name="HotSpotProfilesListBox"
                                     Height="260"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="HotSpotProfilesListBox_SelectionChanged"/>

                            <Button Content="بروفايل جديد"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="NewHotSpotProfileButton_Click"
                                    Margin="0,8,0,5"/>

                            <Button Content="حذف المحدد"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="DeleteHotSpotProfileButton_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="اسم البروفايل"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="HotSpotProfileNameTextBox"
                                     Padding="8"
                                     Margin="0,0,0,10"/>

                            <CheckBox x:Name="HotSpotProfileEnabledCheckBox"
                                      Content="البروفايل مفعّل"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="HotSpotProfileUseRadiusCheckBox"
                                      Content="استخدام RADIUS لهذا البروفايل"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="HotSpotProfileRadiusAccountingCheckBox"
                                      Content="إرسال المحاسبة"
                                      Margin="0,0,0,10"/>

                            <CheckBox x:Name="HotSpotProfileUseCookieCheckBox"
                                      Content="استخدام Cookie"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="طرق الدخول المسموحة"
                                       Margin="0,0,0,5"/>
                            <ListBox x:Name="HotSpotProfileLoginMethodsListBox"
                                     SelectionMode="Multiple"
                                     MinHeight="100"
                                     MaxHeight="140"
                                     Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="فترة تحديث RADIUS"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="HotSpotProfileInterimUpdateTextBox"
                                             Padding="8"
                                             FlowDirection="LeftToRight"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="عدد المستخدمين المتزامنين"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="HotSpotProfileSharedUsersTextBox"
                                             Padding="8"
                                             FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="مدة Cookie بالدقائق"
                                               FontSize="11"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="HotSpotProfileCookieTimeoutTextBox"
                                             Padding="8"
                                             FlowDirection="LeftToRight"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="خمول العميل بالثواني"
                                               FontSize="11"
                                               Margin="0,0,0,5"/>
                                    <TextBox x:Name="HotSpotProfileIdleTimeoutTextBox"
                                             Padding="8"
                                             FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Keepalive بالثواني"
                                       Margin="0,10,0,5"/>
                            <TextBox x:Name="HotSpotProfileKeepaliveTimeoutTextBox"
                                     Padding="8"
                                     FlowDirection="LeftToRight"/>

                            <TextBlock Text="ملاحظات"
                                       Margin="0,10,0,5"/>
                            <TextBox x:Name="HotSpotProfileCommentTextBox"
                                     Padding="8"
                                     MinHeight="45"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>

                            <Button Content="حفظ البروفايل"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SaveHotSpotProfileButton_Click"
                                    Margin="0,12,0,0"/>

                            <TextBlock x:Name="HotSpotProfileStatusTextBlock"
                                       Text="اختر بروفايلًا أو أنشئ واحدًا."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Portal branding -->
            <TabItem Header="صفحة دخول العميل">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="هوية بوابة الدخول"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="عنوان الصفحة"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="HotSpotPortalTitleTextBox"
                                     Padding="8"
                                     Margin="0,0,0,12"/>

                            <TextBlock Text="رسالة الترحيب"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="HotSpotPortalWelcomeTextBox"
                                     Padding="8"
                                     MinHeight="90"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Margin="0,0,0,12"/>

                            <Button Content="معاينة صفحة الدخول"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="PreviewHotSpotPortalButton_Click"
                                    HorizontalAlignment="Right"/>

                            <TextBlock Text="هذه معاينة نصوص للمتطلبات فقط؛ لا يتم تعديل ملفات بوابة فعلية على الراوتر."
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{StaticResource AppBgBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="معاينة البوابة"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,16"/>

                                <Border Background="White"
                                        CornerRadius="10"
                                        Padding="20">
                                    <StackPanel>
                                        <Border Background="{StaticResource PrimaryLightBrush}"
                                                CornerRadius="8"
                                                Padding="12"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,14">
                                            <TextBlock Text="NEXORA"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>

                                        <TextBlock x:Name="HotSpotPortalPreviewTitleTextBlock"
                                                   Text="مرحبًا بك في الشبكة"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock x:Name="HotSpotPortalPreviewMessageTextBlock"
                                                   Text="أدخل بيانات كرت الإنترنت للاتصال."
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,18"/>

                                        <TextBox Text="اسم المستخدم"
                                                 Padding="9"
                                                 IsReadOnly="True"
                                                 Margin="0,0,0,8"/>

                                        <PasswordBox Password="••••••••"
                                                     Padding="9"
                                                     IsEnabled="False"/>

                                        <Border Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="7"
                                                Padding="10"
                                                Margin="0,14,0,0">
                                            <TextBlock Text="تسجيل الدخول"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Package bindings -->
            <TabItem Header="ربط الباقات">
                <StackPanel Margin="14">
                    <TextBlock Text="ربط الباقات التجارية بموارد HotSpot"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="السعر والصلاحية وحصة البيانات والسياسة التجارية تبقى في كتالوج باقات Nexora. تُدار روابط المورد التقنية من كتالوج الباقات."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <Border Background="{StaticResource AppBgBrush}"
                            CornerRadius="9"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="الروابط المفعّلة في الكتالوج"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11.5"/>

                            <TextBlock x:Name="HotSpotPackageBindingSummaryTextBlock"
                                       Text="0"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,4,0,8"/>

                            <TextBlock Text="العدد يوضح بيانات الربط المحلية فقط، ولا يعني أن البروفايلات طُبقت على الراوتر."
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button Content="فتح كتالوج باقات HotSpot"
                            Style="{StaticResource PrimaryButton}"
                            Click="HotSpotPackagesButton_Click"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Diagnostics -->
            <TabItem Header="التشخيص">
                <StackPanel Margin="14">
                    <TextBlock Text="حالة الإعداد"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="تعرض هذه الصفحة مراجعة محلية للإعدادات، ولا ترسل أي طلب إلى جهاز فعلي."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="HotSpotDiagnosticsStatusTextBlock"
                               Text="لم يتم تنفيذ اختبار اتصال فعلي."
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button Content="تحديث مراجعة الإعدادات"
                            Style="{StaticResource SecondaryButton}"
                            Click="RefreshHotSpotDiagnosticsButton_Click"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="HotSpotSettingsStatusTextBlock"
                   Text="إعدادات HotSpot محفوظة محليًا في الديمو."
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>
    </StackPanel>
</Border>

            <Border x:Name="RouterSettingsPanel"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="اتصالات الراوتر"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="إدارة ملفات الاتصال التي يمكن ربطها بمصادر المصادقة. هذه الإعدادات محلية في الديمو ولا تنشئ اتصالاً فعلياً."
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,5,0,14"/>

                    <TextBlock Text="الاتصالات المحفوظة"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ListBox x:Name="RouterConnectionsListBox"
                             MinHeight="55"
                             MaxHeight="130"
                             DisplayMemberPath="Name"
                             SelectionChanged="RouterConnectionsListBox_SelectionChanged"
                             Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="اسم الاتصال" Margin="0,0,0,5"/>
                            <TextBox x:Name="RouterNameTextBox"
                                     Padding="8"
                                     Text="الراوتر الرئيسي"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="عنوان الراوتر أو اسم المضيف"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="RouterAddressTextBox"
                                     Padding="8"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0"
                                    Margin="0,0,0,10">
                            <TextBlock Text="طريقة الاتصال"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="RouterMethodComboBox"
                                      Padding="6"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2"
            Margin="0,0,0,10">
    <TextBlock Text="المنفذ" Margin="0,0,0,5"/>
    <TextBox x:Name="RouterPortTextBox"
             Padding="8"
             Text="8729"/>
</StackPanel>

<StackPanel Grid.Row="2" Grid.Column="0"
            Margin="0,0,0,10">
    <TextBlock Text="اسم مستخدم الراوتر" Margin="0,0,0,5"/>
    <TextBox x:Name="RouterUsernameTextBox" Padding="8"/>
</StackPanel>

<StackPanel Grid.Row="2" Grid.Column="2"
            Margin="0,0,0,10">
    <TextBlock Text="ملاحظات" Margin="0,0,0,5"/>
    <TextBox x:Name="RouterCommentTextBox" Padding="8"/>
</StackPanel>
</Grid>

                    <CheckBox x:Name="RouterEnabledCheckBox"
                              Content="ملف الاتصال مفعّل"
                              IsChecked="True"
                              Margin="0,0,0,12"/>

                    <WrapPanel>
                        <Button Content="حفظ الاتصال"
                                Style="{StaticResource PrimaryButton}"
                                Click="SaveRouterConnectionButton_Click"
                                Margin="0,0,8,8"/>

                        <Button Content="اتصال جديد"
                                Style="{StaticResource SecondaryButton}"
                                Click="NewRouterConnectionButton_Click"
                                Margin="0,0,8,8"/>

                        <Button Content="إعادة تحميل"
                                Style="{StaticResource SecondaryButton}"
                                Click="ReloadRouterConnectionsButton_Click"
                                Margin="0,0,0,8"/>
                    </WrapPanel>

                    <TextBlock x:Name="RouterSettingsStatusTextBlock"
                               Text="الإعدادات محلية في الديمو."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
