<UserControl x:Class="Nexora.Demo.Desktop.Features.Networks.Views.NetworkSourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{StaticResource PrimaryLightBrush}" CornerRadius="9" Padding="10" Margin="10,0,0,0"><TextBlock Text="↔" FontSize="25" Foreground="{StaticResource PrimaryBrush}" /></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NetworkPageTitleTextBlock" Text="الشبكات ومصادر المصادقة" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="NetworkPageSubtitleTextBlock" Text="اختر مصدر المصادقة لتدير إعداداته التقنية بشكل مستقل مع بقاء مستخدمي الشبكة موحدين في Nexora." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid x:Name="ProviderCardsGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="HotSpotCard" Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="#FBEDEF" CornerRadius="8" Padding="10"><TextBlock Text="HS" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="HotSpot" FontSize="18" FontWeight="Bold"/><TextBlock Text="بوابة دخول المستخدمين" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel>
                        <TextBlock Text="حدد طريقة مصادقة HotSpot: حسابات HotSpot أو مصدر RADIUS مرتبط بالنظام." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <Separator Background="{StaticResource BorderBrushSoft}"/>
                        <Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="حسابات مسجلة في Nexora" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HotSpotAccountsTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="ملف الباقة" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="HotSpotPackageBindingsTextBlock" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid>
                        <WrapPanel><Button Content="إدارة الباقات" Style="{StaticResource SecondaryButton}" Click="HotSpotPackagesButton_Click" Margin="0,0,8,0"/><Button Content="إصدار كروت" Style="{StaticResource PrimaryButton}" Tag="hotspot" Click="IssueForSystemButton_Click"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="UserManagerCard" Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="#FBEDEF" CornerRadius="8" Padding="10"><TextBlock Text="UM" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="User Manager" FontSize="18" FontWeight="Bold"/><TextBlock Text="إدارة الحسابات عبر RADIUS" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></DockPanel>
                        <TextBlock Text="إدارة الحسابات والمجموعات وحدود الاستخدام من خلال User Manager، مع إعدادات ربط خاصة بهذا المصدر." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <Separator Background="{StaticResource BorderBrushSoft}"/>
                        <Grid Margin="0,10,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="حسابات مسجلة في Nexora" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UserManagerAccountsTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="ملفات الباقات" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UserManagerPackageBindingsTextBlock" Text="—" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid>
                        <WrapPanel><Button Content="إدارة الباقات" Style="{StaticResource SecondaryButton}" Click="UserManagerPackagesButton_Click" Margin="0,0,8,0"/><Button Content="إصدار كروت" Style="{StaticResource PrimaryButton}" Tag="user-manager" Click="IssueForSystemButton_Click"/></WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="ProviderDetailPanel" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProviderDetailTitleTextBlock" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="ProviderDetailDescriptionTextBlock" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button Content="إدارة مستخدمي الشبكة" Style="{StaticResource SecondaryButton}" Click="OpenUsersButton_Click" Margin="0,0,8,0"/>
                        <Button Content="إصدار دفعة" Style="{StaticResource PrimaryButton}" Click="OpenIssuanceButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border x:Name="UserManagerSettingsPanel"
        Background="White"
        BorderBrush="{StaticResource BorderBrushSoft}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16"
        Margin="0,10,0,0"
        Visibility="Collapsed">
    <StackPanel>
        <TextBlock Text="مدير المستخدمين"
                   FontSize="21"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"/>

        <TextBlock Text="إدارة الخدمة والاتصال والبروفايلات وأجهزة RADIUS وربط الباقات."
                   FontSize="11.5"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,14"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource AppBgBrush}"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="الخدمة"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5"/>
                    <TextBlock x:Name="UserManagerStatusSummaryTextBlock"
                               Text="غير مفعّلة"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource AppBgBrush}"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="البروفايلات"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5"/>
                    <TextBlock x:Name="UserManagerProfileCountTextBlock"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Background="{StaticResource AppBgBrush}"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="أجهزة RADIUS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5"/>
                    <TextBlock x:Name="UserManagerRadiusClientCountTextBlock"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl MinHeight="430">

            <TabItem Header="الخدمة والاتصال">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="UserManagerEnabledCheckBox"
                                  Content="تفعيل الخدمة في إعدادات الديمو"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="اتصال الراوتر المرتبط"
                                   Margin="0,0,0,5"/>

                        <ComboBox x:Name="UserManagerRouterComboBox"
                                  Padding="8"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"/>

                        <Button Content="إدارة اتصالات الراوتر"
                                Style="{StaticResource SecondaryButton}"
                                Click="ManageRouterConnectionsButton_Click"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,16"/>

                        <Separator/>

                        <TextBlock Text="منافذ RADIUS"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="منفذ المصادقة"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="UserManagerAuthenticationPortTextBox"
                                         Text="1812"
                                         Padding="8"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="منفذ المحاسبة"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="UserManagerAccountingPortTextBox"
                                         Text="1813"
                                         Padding="8"
                                         FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="UserManagerAccountingEnabledCheckBox"
                                  Content="تسجيل المحاسبة"
                                  Margin="0,12,0,8"/>

                        <TextBlock Text="فترة تحديث المحاسبة بالثواني"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="UserManagerInterimUpdateTextBox"
                                 Text="300"
                                 Padding="8"
                                 FlowDirection="LeftToRight"/>

                        <CheckBox x:Name="UserManagerUseProfilesCheckBox"
                                  Content="استخدام بروفايلات User Manager"
                                  Margin="0,12,0,10"/>

                        <TextBlock Text="ملاحظات الإعداد"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="UserManagerCommentTextBox"
                                 Padding="8"
                                 MinHeight="55"
                                 MaxLength="300"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="حفظ إعدادات الخدمة"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SaveUserManagerSettingsButton_Click"
                                    Margin="0,0,8,8"/>
                            <Button Content="إعادة تحميل"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ReloadUserManagerSettingsButton_Click"
                                    Margin="0,0,8,8"/>
                            <Button Content="إدارة الباقات"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="UserManagerPackagesButton_Click"
                                    Margin="0,0,8,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="البروفايلات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ListBox x:Name="UserManagerProfilesListBox"
                                     Height="250"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="UserManagerProfilesListBox_SelectionChanged"/>

                            <Button Content="بروفايل جديد"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="NewUserManagerProfileButton_Click"
                                    Margin="0,8,0,5"/>

                            <Button Content="حذف المحدد"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="DeleteUserManagerProfileButton_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="اسم البروفايل"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerProfileNameTextBox"
                                     Padding="8"
                                     Margin="0,0,0,10"/>

                            <CheckBox x:Name="UserManagerProfileEnabledCheckBox"
                                      Content="البروفايل مفعّل"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="حد التنزيل (Kbps)"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerProfileDownloadLimitTextBox"
                                     Text="0"
                                     Padding="8"
                                     FlowDirection="LeftToRight"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="حد الرفع (Kbps)"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerProfileUploadLimitTextBox"
                                     Text="0"
                                     Padding="8"
                                     FlowDirection="LeftToRight"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="المستخدمون المتزامنون"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerProfileSharedUsersTextBox"
                                     Text="1"
                                     Padding="8"
                                     FlowDirection="LeftToRight"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="ملاحظات"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerProfileCommentTextBox"
                                     Padding="8"
                                     MinHeight="45"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>

                            <Button Content="حفظ البروفايل"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SaveUserManagerProfileButton_Click"
                                    Margin="0,12,0,0"/>

                            <TextBlock x:Name="UserManagerProfileStatusTextBlock"
                                       Text="اختر بروفايلًا أو أنشئ واحدًا."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="أجهزة RADIUS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ListBox x:Name="UserManagerClientsListBox"
                                     Height="250"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="UserManagerClientsListBox_SelectionChanged"/>

                            <Button Content="جهاز جديد"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="NewUserManagerClientButton_Click"
                                    Margin="0,8,0,5"/>

                            <Button Content="حذف المحدد"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="DeleteUserManagerClientButton_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="اسم الجهاز"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerClientNameTextBox"
                                     Padding="8"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="العنوان"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerClientAddressTextBox"
                                     Padding="8"
                                     FlowDirection="LeftToRight"
                                     Margin="0,0,0,10"/>

                            <TextBlock Text="بروتوكول النقل"
                                       Margin="0,0,0,5"/>
                            <ComboBox x:Name="UserManagerClientProtocolComboBox"
                                      Padding="8"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="منفذ CoA"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerClientCoaPortTextBox"
                                     Text="3799"
                                     Padding="8"
                                     FlowDirection="LeftToRight"
                                     Margin="0,0,0,10"/>

                            <CheckBox x:Name="UserManagerClientEnabledCheckBox"
                                      Content="الجهاز مفعّل"
                                      Margin="0,0,0,8"/>

                            <CheckBox x:Name="UserManagerClientSecretConfiguredCheckBox"
                                      Content="تم إعداد السر المشترك في البيئة المستهدفة"
                                      Margin="0,0,0,10"/>

                            <TextBlock Text="ملاحظات"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="UserManagerClientCommentTextBox"
                                     Padding="8"
                                     MinHeight="45"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>

                            <Button Content="حفظ عميل RADIUS"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="SaveUserManagerClientButton_Click"
                                    Margin="0,12,0,0"/>

                            <TextBlock x:Name="UserManagerClientStatusTextBlock"
                                       Text="الإعدادات محلية في الديمو."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="ربط الباقات">
                <StackPanel Margin="14">
                    <TextBlock Text="ربط الباقات التجارية بالموارد التقنية"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="تعريف الباقة وسعرها وحدودها التجارية يبقى في كتالوج Nexora. تُعرض هنا ملخصات الروابط المسجلة لذلك المصدر."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="UserManagerPackageBindingSummaryTextBlock"
                               Text="0"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <Button Content="فتح كتالوج الباقات"
                            Style="{StaticResource PrimaryButton}"
                            Click="UserManagerPackagesButton_Click"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="الجلسات والتشخيص">
                <StackPanel Margin="14">
                    <TextBlock Text="معاينة الجلسات"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <ListBox x:Name="UserManagerDemoSessionsListBox"
                             MinHeight="120"
                             MaxHeight="190"
                             IsHitTestVisible="False">
                        <ListBoxItem Content="demo-user-014 | 00:18:24 | 240 MB"/>
                        <ListBoxItem Content="demo-user-027 | 00:42:10 | 680 MB"/>
                        <ListBoxItem Content="demo-user-031 | 00:05:52 | 75 MB"/>
                    </ListBox>

                    <TextBlock Text="هذه بيانات عرض ثابتة؛ لا تمثل جلسات حقيقية أو نتائج من الراوتر."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,12"/>

                    <Button Content="تحديث التشخيص"
                            Style="{StaticResource SecondaryButton}"
                            Click="RefreshUserManagerDiagnosticsButton_Click"
                            HorizontalAlignment="Right"/>

                    <TextBlock x:Name="UserManagerDiagnosticsStatusTextBlock"
                               Text="لم يتم اختبار اتصال فعلي."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="UserManagerSettingsStatusTextBlock"
                   Text="الإعدادات محلية في الديمو."
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>
    </StackPanel>
</Border>
<Border x:Name="HotSpotSettingsPanel"
        Background="White"
        BorderBrush="{StaticResource BorderBrushSoft}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="16"
        Margin="0,10,0,0"
        Visibility="Collapsed">
    <StackPanel>
        <DockPanel Margin="0,0,0,14">
            <Border DockPanel.Dock="Left"
                    Background="{StaticResource PrimaryLightBrush}"
                    CornerRadius="8"
                    Padding="10,6">
                <TextBlock Text="بوابة الشبكة"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontWeight="SemiBold"/>
            </Border>
            <StackPanel>
                <TextBlock Text="إعدادات HotSpot"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="الخوادم، وطرق الدخول، والبروفايلات، وربط الباقات، وصفحة العميل."
                           FontSize="11.5"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource AppBgBrush}"
                    CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="الخدمة"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5"/>
                    <TextBlock x:Name="HotSpotStatusSummaryTextBlock"
                               Text="مفعّلة في النموذج"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource AppBgBrush}"
                    CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="البروفايلات"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5"/>
                    <TextBlock x:Name="HotSpotProfileCountTextBlock"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Background="{StaticResource AppBgBrush}"
                    CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="روابط الباقات"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10.5"/>
                    <TextBlock x:Name="HotSpotBindingCountTextBlock"
                               Text="0"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl MinHeight="440">

            <!-- Server and authentication -->
            <TabItem Header="الخادم والدخول">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="الخادم والواجهة"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <CheckBox x:Name="HotSpotEnabledCheckBox"
                                  Content="تفعيل HotSpot في نموذج الإعدادات"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="اتصال الراوتر"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="HotSpotRouterComboBox"
                                  Padding="8"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,0,10">
                                <TextBlock Text="اسم الخادم"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="HotSpotServerNameTextBox"
                                         Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="0,0,0,10">
                                <TextBlock Text="اسم بروفايل الخادم"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="HotSpotServerProfileNameTextBox"
                                         Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,0,10">
                                <TextBlock Text="واجهة الشبكة"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="HotSpotInterfaceNameTextBox"
                                         Padding="8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,0,10">
                                <TextBlock Text="مجموعة عناوين العملاء"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="HotSpotAddressPoolNameTextBox"
                                         Padding="8"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="اسم DNS لبوابة الدخول"
                                   Margin="0,0,0,5"/>
