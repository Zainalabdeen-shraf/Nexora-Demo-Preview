<UserControl x:Class="Nexora.Demo.Desktop.Features.Settings.Views.BackupSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="LOCAL DATA BACKUP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="النسخ الاحتياطي" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/>
                    <TextBlock Text="أنشئ حزمة ZIP من ملفات بيانات الديمو المحفوظة محليًا واحتفظ بها في مكان آمن." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,12"><TextBlock Text="النسخة تشمل ملفات NexoraProductDemo المحلية التي يمكن قراءتها، مع استبعاد السجلات المؤقتة وملفات السجل النصي. لا تشمل حالة جهاز RouterOS ولا أي بيانات لم تُحفظ محليًا." FontSize="11" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/></Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="إنشاء نسخة جديدة" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="DataPathTextBlock" Text="مجلد البيانات المحلي" FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                    <WrapPanel>
                        <Button Content="إنشاء نسخة احتياطية ZIP" Style="{StaticResource PrimaryButton}" Click="CreateBackupButton_Click" Margin="0,0,8,8"/>
                        <Button Content="فتح مجلد البيانات" Style="{StaticResource SecondaryButton}" Click="OpenDataFolderButton_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="BackupStatusTextBlock" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="10">
                <StackPanel>
                    <DockPanel Margin="4,2,4,10"><TextBlock Text="سجل النسخ الأخيرة" FontSize="14" FontWeight="Bold"/><TextBlock x:Name="BackupCountTextBlock" DockPanel.Dock="Left" Text="0 نسخ" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></DockPanel>
                    <DataGrid x:Name="BackupHistoryDataGrid" ItemsSource="{Binding BackupHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="90" MaxHeight="220" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="وقت الإنشاء" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1*"/>
                            <DataGridTextColumn Header="الملفات" Binding="{Binding FilesIncluded}" Width="0.6*"/>
                            <DataGridTextColumn Header="الحجم" Binding="{Binding SizeText}" Width="0.7*"/>
                            <DataGridTextColumn Header="المسار" Binding="{Binding BackupPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="يُحفظ سجل النسخ محليًا ضمن بيانات الديمو. حذف ملف النسخة من مستكشف الملفات لا يحذف سجله تلقائيًا." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>