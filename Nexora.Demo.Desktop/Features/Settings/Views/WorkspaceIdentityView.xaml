<UserControl x:Class="Nexora.Demo.Desktop.Features.Settings.Views.WorkspaceIdentityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="WORKSPACE IDENTITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="الموقع والهوية" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/>
                    <TextBlock Text="راجع معلومات مساحة الشبكة وموقعها. التعديل يستخدم نموذج الموقع الموجود ويحفظ بيانات الديمو محليًا." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="اسم مساحة العمل" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="WorkspaceNameTextBlock" Text="مساحة الشبكة" FontSize="18" FontWeight="Bold" Margin="0,4,0,14"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="حالة الموقع" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/><Border x:Name="LocationStatusBadge" Grid.Column="1" Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"><TextBlock x:Name="LocationStatusTextBlock" Text="غير مكتمل" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/></Border></Grid>
                    <TextBlock Text="العنوان المسجل" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
                    <TextBlock x:Name="LocationSummaryTextBlock" Text="لم يتم حفظ موقع بعد." FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <Button Content="تعديل معلومات الموقع" Style="{StaticResource PrimaryButton}" Click="EditLocationButton_Click" HorizontalAlignment="Right" Margin="0,16,0,0"/>
                    <TextBlock Text="لا يتم تحديد الموقع تلقائيًا أو إرسال بيانات إلى خدمة خارجية في هذا الديمو." FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>