<UserControl x:Class="Nexora.Demo.Desktop.Features.Settings.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="2">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SYSTEM PREFERENCES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="إعدادات النظام" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/>
                    <TextBlock Text="تحكم في سلوك مساحة العمل والبيانات المحلية. هذه التفضيلات خاصة ببيئة الديمو." FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="بيئة التشغيل" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="ديمو محلي" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0"/><TextBlock Text="لا يوجد اتصال فعلي بالراوتر" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="13"><StackPanel><TextBlock Text="التخزين" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="محلي على هذا الجهاز" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="JSON وإعدادات العرض المحفوظة" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel></Border>
            </Grid>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="طريقة بدء العمل" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="حدد الصفحة التي تظهر بعد تسجيل الدخول في المرة القادمة." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <ComboBox x:Name="StartupSectionComboBox" Padding="8" Margin="0,0,0,14"/>
                    <CheckBox x:Name="ConfirmBeforeBackupCheckBox" Content="طلب تأكيد قبل إنشاء حزمة النسخة الاحتياطية" FontSize="12" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ShowSuccessMessagesCheckBox" Content="إظهار رسالة منبثقة عند نجاح النسخ الاحتياطي" FontSize="12" Margin="0,0,0,14"/>
                    <WrapPanel>
                        <Button Content="حفظ التفضيلات" Style="{StaticResource PrimaryButton}" Click="SavePreferencesButton_Click" Margin="0,0,8,8"/>
                        <Button Content="فتح مجلد بيانات الديمو" Style="{StaticResource SecondaryButton}" Click="OpenDataFolderButton_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="SettingsStatusTextBlock" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DataDirectoryTextBlock" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="10"><TextBlock Text="هذه الإعدادات تحفظ تفضيلات الديمو وواجهة الاستخدام فقط؛ لا تُغيّر إعدادات RouterOS أو صلاحيات المستخدمين على الراوتر." FontSize="11" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>