<UserControl x:Class="Nexora.Demo.Desktop.Features.Cards.Views.IssuanceWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource AppBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="إصدار الكروت والدفعات" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="حدد جهة الإصدار أولًا؛ تتغير إعدادات الحساب والباقة وفق النظام المستهدف." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="جهة الإصدار" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="TargetSystemComboBox" Height="40" SelectionChanged="TargetSystemComboBox_SelectionChanged">
                        <ComboBoxItem Content="HotSpot — حساب محلي" Tag="hotspot" />
                        <ComboBoxItem Content="User Manager — RADIUS" Tag="user-manager" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Border x:Name="ChooseTargetPanel" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="28">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <Border Width="70" Height="70" Background="{StaticResource PrimaryLightBrush}" CornerRadius="18" Padding="15" HorizontalAlignment="Center">
                        <TextBlock Text="＋" FontSize="34" FontWeight="Light" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ابدأ بتحديد نظام الحسابات" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Text="سيتم بعد ذلك عرض الباقات وإعدادات الإصدار المناسبة للجهة المختارة. يبقى سجل الكروت والدفعات موحدًا داخل Nexora مع الاحتفاظ بمصدر كل حساب." FontSize="12" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <ContentControl x:Name="IssuanceContentHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
