<UserControl x:Class="Nexora.Demo.Desktop.Features.Cards.Views.IssuanceWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource AppBgBrush}">
    <UserControl.Resources>
        <Style x:Key="IssuanceSourceTabStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="35" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="8" Padding="4,3" Margin="0,0,0,4">
            <DockPanel LastChildFill="False" FlowDirection="RightToLeft" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="RightToLeft">
                    <RadioButton x:Name="UserManagerTargetTabButton" GroupName="IssuanceTargetSystem"
                                 Tag="user-manager" Content="يوزر منجر"
                                 Style="{StaticResource IssuanceSourceTabStyle}" Checked="TargetSystemTab_Checked" />
                    <RadioButton x:Name="HotSpotTargetTabButton" GroupName="IssuanceTargetSystem"
                                 Tag="hotspot" Content="هوتسبوت"
                                 Style="{StaticResource IssuanceSourceTabStyle}" Checked="TargetSystemTab_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Border x:Name="ChooseTargetPanel" Visibility="Collapsed" Background="White"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" />
            <ContentControl x:Name="IssuanceContentHost" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
        <ComboBox x:Name="TargetSystemComboBox" Visibility="Collapsed" IsTabStop="False"
                  SelectionChanged="TargetSystemComboBox_SelectionChanged">
            <ComboBoxItem Content="هوتسبوت — حساب محلي" Tag="hotspot" />
            <ComboBoxItem Content="يوزر منجر — حسابات الشبكة" Tag="user-manager" />
        </ComboBox>
    </Grid>
</UserControl>