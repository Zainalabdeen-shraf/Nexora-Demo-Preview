<UserControl x:Class="Nexora.Demo.Desktop.Features.Cards.Views.CardManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource AppBgBrush}"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ManagementPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="ManagementTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#F8FAFD" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ManagementComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Padding" Value="9,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FFF1F2" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFF1F2" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" />
                            <ContentPresenter IsHitTestVisible="False" Margin="8,0,28,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Right"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <ToggleButton HorizontalAlignment="Left" Width="27" Focusable="False"
                                          Background="Transparent" BorderThickness="0" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock Text="⌄" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#CBD5E1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManagementSmallButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFF1F2" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#F3A3AE" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#BE1E2D" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#BE1E2D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManagementIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ManagementSmallButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="ManagementInlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="CardStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="متاحة">
                    <Setter Property="Background" Value="#ECFDF5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="قيد الاستخدام">
                    <Setter Property="Background" Value="#EFF6FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="منتهية">
                    <Setter Property="Background" Value="#F1F5F9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="موقوفة">
                    <Setter Property="Background" Value="#FFF1F2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="مؤرشفة">
                    <Setter Property="Background" Value="#E5E7EB" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#047857" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="قيد الاستخدام">
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="منتهية">
                    <Setter Property="Foreground" Value="#64748B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="موقوفة">
                    <Setter Property="Foreground" Value="#BE123C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CardStatusLabel}" Value="مؤرشفة">
                    <Setter Property="Foreground" Value="#4B5563" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F6F8FB" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontFamily" Value="Tahoma" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#EEF0F3" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF1F2" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- عنوان فرعي مسطّح؛ إصدار الكروت والاستيراد موجودان أصلًا في تبويبات الشاشة الرئيسية. -->
        <Grid Grid.Row="0" Margin="3,0,3,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="إدارة الكروت" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="السجل العام للكروت الصادرة والمستوردة" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="  ·  " FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="TargetSystemTextBlock" Text="النظام المحدد" FontSize="10.5" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="↻" Style="{StaticResource ManagementIconButton}"
                    ToolTip="تحديث سجل الكروت" AutomationProperties.Name="تحديث سجل الكروت"
                    Click="RefreshButton_Click" />
        </Grid>

        <!-- مؤشرات تشغيلية محسوبة من سجل الكروت. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ManagementPanel}" Padding="9,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#ECFDF5" VerticalAlignment="Center">
                        <TextBlock Text="✓" Foreground="#047857" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="الكروت المتاحة" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="AvailableCardsCountTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="متاحة وغير مؤرشفة" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource ManagementPanel}" Padding="9,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#FFF1F2" VerticalAlignment="Center">
                        <TextBlock Text="▤" Foreground="{StaticResource PrimaryBrush}" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="إجمالي الكروت" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="TotalCardsCountTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="ضمن النظام المحدد" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource ManagementPanel}" Padding="9,7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#FFF7ED" VerticalAlignment="Center">
                        <TextBlock Text="!" Foreground="#C2410C" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="تحتاج مراجعة" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="ReviewCardsCountTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="سجلات موقوفة أو عليها خطأ" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- البحث والفلاتر؛ مصدر النظام يُحدد من تبويبي HotSpot وUser Manager خارج هذه المنطقة. -->
        <Border Grid.Row="4" Style="{StaticResource ManagementPanel}" Padding="9,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.55*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="بحث برقم الكرت أو المستخدم أو الدفعة أو الباقة" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="CardSearchTextBox" Style="{StaticResource ManagementTextBox}" ToolTip="ابحث في رقم الكرت واسم المستخدم ورقم الدفعة واسم الباقة" TextChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="حالة الكرت" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CardStatusFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="كل الحالات" Tag="all" IsSelected="True" />
                            <ComboBoxItem Content="متاحة" Tag="متاحة" />
                            <ComboBoxItem Content="قيد الاستخدام" Tag="قيد الاستخدام" />
                            <ComboBoxItem Content="منتهية" Tag="منتهية" />
                            <ComboBoxItem Content="موقوفة" Tag="موقوفة" />
                            <ComboBoxItem Content="مؤرشفة" Tag="archived" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="الباقة" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="PackageFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="الدفعة" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="BatchFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <Button Grid.Column="8" Content="× مسح الفلاتر" Style="{StaticResource ManagementSmallButton}" VerticalAlignment="Bottom" Click="ClearFiltersButton_Click" />
                </Grid>
                <Expander Grid.Row="1" Header="مزيد من الفلاتر" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,7,0,0">
                    <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <StackPanel Width="190" Margin="0,0,10,5">
                            <TextBlock Text="مصدر السجل" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="SourceFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="كل المصادر" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="إصدار" Tag="local" />
                                <ComboBoxItem Content="مستورد" Tag="import" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Width="205" Margin="0,0,10,5">
                            <TextBlock Text="حالة الطباعة" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="PrintFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectionChanged="Filter_Changed">
                                <ComboBoxItem Content="كل الحالات" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="غير مضافة للطباعة" Tag="not-scheduled" />
                                <ComboBoxItem Content="ضمن قائمة الطباعة" Tag="queued" />
                                <ComboBoxItem Content="مهمة طباعة مسجلة" Tag="submitted" />
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                </Expander>
            </Grid>
        </Border>

        <!-- السجل العام؛ مصدره DemoCardIssuanceService نفسه الذي تستخدمه شاشة الإصدار والاستيراد والدفعات. -->
        <Grid Grid.Row="6">
            <Border Style="{StaticResource ManagementPanel}" Padding="0" ClipToBounds="True">
                <DataGrid x:Name="CardsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          RowHeight="43"
                          ColumnHeaderHeight="35"
                          FontSize="11.5"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF0F3"
                          AlternationCount="2"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="CardsDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="تحديد" Width="48" CanUserSort="False" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsMarked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="تحديد هذا الكرت للإجراءات الجماعية" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="رقم الكرت / المستخدم" Width="1.55*" SortMemberPath="CardNumber" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="5,2">
                                        <TextBlock Text="{Binding CardNumber}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" Visibility="{Binding ShowUsername, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,2,0,0">
                                            <TextBlock Text="المستخدم: " FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding Username}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="الباقة" Binding="{Binding PackageName}" Width="1.25*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="رقم الدفعة" Width="1.2*" SortMemberPath="BatchId" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding BatchId}" Style="{StaticResource ManagementInlineButton}" ToolTip="فتح الدفعة الأصلية" Click="RowBatchButton_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAtLabel}" Width="1.15*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="حالة الكرت" Width="1.0*" SortMemberPath="CardStatusLabel" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStatusBadge}">
                                        <TextBlock Text="{Binding CardStatusLabel}" Style="{StaticResource CardStatusText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="المصدر" Binding="{Binding SourceLabel}" Width="0.8*" SortMemberPath="SourceLabel" IsReadOnly="True" />
                        <DataGridTextColumn Header="حالة الطباعة" Binding="{Binding PrintStatusLabel}" Width="1.05*" SortMemberPath="PrintStatusLabel" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="الإجراءات" Width="104" CanUserSort="False" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="ⓘ" Style="{StaticResource ManagementIconButton}" Width="29" Height="29" FontSize="15"
                                                Click="RowDetailsButton_Click" ToolTip="عرض تفاصيل الكرت" AutomationProperties.Name="عرض تفاصيل الكرت" />
                                        <Button Content="⋯" Style="{StaticResource ManagementIconButton}" Width="29" Height="29" FontSize="17"
                                                Click="RowActionsButton_Click" ToolTip="إجراءات الكرت" AutomationProperties.Name="إجراءات الكرت" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Background="#FCFDFE" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Padding="24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="سجل الكروت" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextAlignment="Center" />
                    <TextBlock x:Name="EmptyStateDescriptionTextBlock" Text="لا توجد سجلات مطابقة للفلاتر الحالية." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" FontSize="11.5" />
                    <Button Content="× مسح الفلاتر" Style="{StaticResource ManagementSmallButton}" HorizontalAlignment="Center" Margin="0,12,0,0" Click="ClearFiltersButton_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ملخص نتائج وتحديد جماعي؛ أزرار الإجراءات لا تظهر قبل تحديد سجل. -->
        <Border Grid.Row="8" Style="{StaticResource ManagementPanel}" Padding="9,7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ResultSummaryTextBlock" Text="جارٍ تحميل السجل..." FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="OperationStatusTextBlock" Text="" FontSize="10.5" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="SelectedCountTextBlock" Grid.Column="1" Text="المحدد: 0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="10,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="تحديد الظاهر" Style="{StaticResource ManagementSmallButton}" Click="SelectVisibleButton_Click" />
                        <Button Content="إلغاء التحديد" Style="{StaticResource ManagementSmallButton}" Click="ClearSelectionButton_Click" />
                    </StackPanel>
                </Grid>
                <Border x:Name="BulkActionsBorder" Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0" Visibility="Collapsed">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="إضافة المحددة لقائمة الطباعة" Style="{StaticResource ManagementSmallButton}" Click="BulkPrintButton_Click" />
                        <Button x:Name="BulkArchiveButton" Content="أرشفة المحددة" Style="{StaticResource ManagementSmallButton}" Click="BulkArchiveButton_Click" />
                        <Button x:Name="BulkRestoreButton" Content="استعادة المؤرشفة" Style="{StaticResource ManagementSmallButton}" Click="BulkRestoreButton_Click" />
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
