<UserControl x:Class="Nexora.Demo.Desktop.Features.Cards.Views.PendingCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI"
             FontSize="11.5"
             SnapsToDevicePixels="True"
             Background="{StaticResource AppBgBrush}">
    <UserControl.Resources>
        <Style x:Key="PendingPanel" TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="11" />
                    <Setter Property="Padding" Value="9" />
                </Style>

        <Style x:Key="PendingTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Height" Value="35" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                </Style>

        <Style x:Key="PendingComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Height" Value="33" />
                    <Setter Property="Padding" Value="7,3" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="ItemContainerStyle">
                        <Setter.Value>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Padding" Value="9,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#FCEEF2" />
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FCEEF2" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid SnapsToDevicePixels="True" FlowDirection="LeftToRight">
                                    <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                                    <ContentPresenter IsHitTestVisible="False" FlowDirection="RightToLeft" Margin="30,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                    <ToggleButton HorizontalAlignment="Left" Width="28" Focusable="False" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></ControlTemplate>
                                        </ToggleButton.Template>
                                        <Path Data="M3,4 L7,8 L11,4" Width="12" Height="8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </ToggleButton>
                                    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                            <ScrollViewer Margin="1" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#DFE4EB" /></Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.6" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

        <Style x:Key="PendingSmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Padding" Value="9,0" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="Background" Value="#FFFFFF" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FCEEF2" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B33D56" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#B33D56" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B33D56" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

        <Style x:Key="PendingIconButton" TargetType="Button" BasedOn="{StaticResource PendingSmallButton}">
                    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="2,0" />
                </Style>

        <Style x:Key="PendingFilterButton" TargetType="Button" BasedOn="{StaticResource PendingIconButton}">
                    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="34" /><Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="#FFFFFF" />
                </Style>

        <Style x:Key="PendingPagerButton" TargetType="Button" BasedOn="{StaticResource PendingSmallButton}">
                    <Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="30" /><Setter Property="Padding" Value="5,0" /><Setter Property="Margin" Value="2,0" /><Setter Property="FontSize" Value="11" />
                </Style>

        <Style x:Key="PendingPagerButtonCurrent" TargetType="Button" BasedOn="{StaticResource PendingPagerButton}">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="#FFFFFF" />
                </Style>

        <Style x:Key="PendingGridHeader" TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FBECEF" /><Setter Property="Foreground" Value="#26354D" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="11.5" /><Setter Property="Padding" Value="6,0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="BorderBrush" Value="#F2D6DD" /><Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>

        <Style x:Key="PendingGridCell" TargetType="DataGridCell">
                    <Setter Property="Padding" Value="3,0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#EDF0F4" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FCE2E8" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger></Style.Triggers>
                </Style>

        <Style x:Key="PendingGridText" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Margin" Value="2,0" /><Setter Property="FontSize" Value="11.3" /><Setter Property="FontFamily" Value="Segoe UI" />
                </Style>

        <Style x:Key="PendingGridRow" TargetType="DataGridRow">
                    <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#EDF0F4" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="MinHeight" Value="33" /><Setter Property="SnapsToDevicePixels" Value="True" />
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="#FFFFF8F9" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF5F7" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FDE7EC" /></Trigger>
                    </Style.Triggers>
                </Style>
        <Style x:Key="PendingPrimaryIconButton" TargetType="Button" BasedOn="{StaticResource PendingIconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#A91428"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A91428"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#860F20"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#860F20"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PendingRowIconButton" TargetType="Button" BasedOn="{StaticResource PendingIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact title band aligned with the batch-management screen. -->
        <Border Grid.Row="0" Style="{StaticResource PendingPanel}" Padding="10,8" Margin="2,0,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="المعلّقات" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="عناصر تحتاج معالجة" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#FCE9EC" BorderBrush="#F1C4CC" BorderThickness="1" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="عنصر معلّق" FontSize="10.5" Foreground="#8D1725" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="PendingCountTextBlock" Text="0" FontSize="20" FontWeight="Bold" Foreground="#B91C2B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Four compact KPI cards with vector icons (no font glyph substitutes). -->
        <UniformGrid Grid.Row="2" Columns="4" Margin="0">
            <Border Style="{StaticResource PendingPanel}" Padding="9,6" Margin="0,0,4,0" BorderBrush="#F0C8CF">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تحتاج مراجعة" FontSize="10.5" Foreground="#8B3340"/>
                        <TextBlock x:Name="ReviewNeededCountTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="#B42332" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="35" Height="35" CornerRadius="9" Background="#FCE9EC" VerticalAlignment="Center">
                        <Path Data="M12,3 L22,21 L2,21 Z M12,9 L12,14 M12,17 L12,17.1" Width="19" Height="19" Stretch="Uniform" Fill="Transparent" Stroke="#B42332" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource PendingPanel}" Padding="9,6" Margin="2,0,2,0" BorderBrush="#F1D9A7">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تحتاج مزامنة" FontSize="10.5" Foreground="#8B5B15"/>
                        <TextBlock x:Name="SyncNeededCountTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="#A85A00" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="35" Height="35" CornerRadius="9" Background="#FFF3D9" VerticalAlignment="Center">
                        <Path Data="M20,7 A8,8 0 0 0 5,5 L3,7 M3,3 L3,7 L7,7 M4,17 A8,8 0 0 0 19,19 L21,17 M21,21 L21,17 L17,17" Width="19" Height="19" Stretch="Uniform" Fill="Transparent" Stroke="#A85A00" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource PendingPanel}" Padding="9,6" Margin="2,0,2,0" BorderBrush="#CFE0FA">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تحتاج طباعة" FontSize="10.5" Foreground="#315C91"/>
                        <TextBlock x:Name="PrintNeededCountTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="#245EA8" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="35" Height="35" CornerRadius="9" Background="#EAF2FF" VerticalAlignment="Center">
                        <Path Data="M6,8 L6,3 L18,3 L18,8 M6,17 L3,17 L3,9 L21,9 L21,17 L18,17 M6,14 L18,14 L18,21 L6,21 Z M17,11 L18,11" Width="19" Height="19" Stretch="Uniform" Fill="Transparent" Stroke="#245EA8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Style="{StaticResource PendingPanel}" Padding="9,6" Margin="4,0,0,0" BorderBrush="#CFE8D8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="في قائمة الطباعة" FontSize="10.5" Foreground="#236849"/>
                        <TextBlock x:Name="PrintQueueCountTextBlock" Text="0" FontSize="19" FontWeight="Bold" Foreground="#187448" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="35" Height="35" CornerRadius="9" Background="#E8F7EE" VerticalAlignment="Center">
                        <Path Data="M5,4 L19,4 L19,20 L5,20 Z M8,8 L16,8 M8,12 L16,12 M8,16 L13,16" Width="19" Height="19" Stretch="Uniform" Fill="Transparent" Stroke="#187448" StrokeThickness="1.7" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Filter bar follows the batch-management layout: labeled controls, white fields, search icon on the left, compact actions. -->
        <Border Grid.Row="4" Style="{StaticResource PendingPanel}" Padding="8,7" Margin="0">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/><ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="1.05*"/><ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="0.95*"/><ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="1.7*"/><ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="حالة المعلّق" FontSize="10.8" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="StatusFilterComboBox" Style="{StaticResource PendingComboBox}" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="FilterSelectionChanged" ToolTip="تصفية حسب الحالة والإجراء المطلوب">
                        <ComboBoxItem Content="كل الحالات" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="تحتاج مراجعة" Tag="review"/>
                        <ComboBoxItem Content="تحتاج مزامنة" Tag="sync"/>
                        <ComboBoxItem Content="تحتاج طباعة" Tag="print"/>
                        <ComboBoxItem Content="في قائمة الطباعة" Tag="queued"/>
                        <ComboBoxItem Content="مزامنة وطباعة" Tag="both"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="الباقة" FontSize="10.8" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PackageFilterComboBox" Style="{StaticResource PendingComboBox}" SelectedValuePath="Tag" SelectionChanged="FilterSelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="فترة التحديث" FontSize="10.8" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DatePeriodFilterComboBox" Style="{StaticResource PendingComboBox}" SelectedValuePath="Tag" SelectedIndex="0" SelectionChanged="FilterSelectionChanged">
                        <ComboBoxItem Content="كل الفترات" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="اليوم" Tag="today"/>
                        <ComboBoxItem Content="آخر 7 أيام" Tag="7-days"/>
                        <ComboBoxItem Content="آخر 30 يوماً" Tag="30-days"/>
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Column="6" Height="35" VerticalAlignment="Bottom">
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource PendingTextBox}" Padding="32,3,10,3" TextChanged="SearchTextBox_TextChanged" ToolTip="ابحث برقم الكرت أو الدفعة أو اسم المستخدم أو الباقة"/>
                    <Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" Stroke="#52627A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholderTextBlock" Text="ابحث برقم الكرت أو الدفعة أو المستخدم..." FontSize="10.7" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="38,0,12,0" TextAlignment="Right" IsHitTestVisible="False"/>
                </Grid>

                <Button x:Name="RetrySyncButton" Grid.Column="8" Style="{StaticResource PendingFilterButton}" VerticalAlignment="Bottom" Click="RetrySyncButton_Click" ToolTip="إعادة مزامنة العناصر المحددة" AutomationProperties.Name="إعادة مزامنة العناصر المحددة" IsEnabled="False">
                    <Path Data="M20,7 A8,8 0 0 0 5,5 L3,7 M3,3 L3,7 L7,7 M4,17 A8,8 0 0 0 19,19 L21,17 M21,21 L21,17 L17,17" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="QueuePrintButton" Grid.Column="10" Style="{StaticResource PendingIconButton}" VerticalAlignment="Bottom" Click="QueuePrintButton_Click" ToolTip="إضافة العناصر المحددة للطباعة" AutomationProperties.Name="إضافة العناصر المحددة للطباعة" IsEnabled="False">
                    <Path Data="M6,8 L6,3 L18,3 L18,8 M6,17 L3,17 L3,9 L21,9 L21,17 L18,17 M6,14 L18,14 L18,21 L6,21 Z M17,11 L18,11" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#047857" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="ClearFiltersButton" Grid.Column="12" Style="{StaticResource PendingIconButton}" VerticalAlignment="Bottom" Click="ClearFiltersButton_Click" ToolTip="مسح البحث والفلاتر" AutomationProperties.Name="مسح البحث والفلاتر">
                    <Path Data="M5,5 L19,19 M19,5 L5,19" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Button x:Name="RefreshButton" Grid.Column="14" Style="{StaticResource PendingIconButton}" VerticalAlignment="Bottom" Click="RefreshButton_Click" ToolTip="تحديث المعلّقات" AutomationProperties.Name="تحديث المعلّقات">
                    <Path Data="M20,8 A8,8 0 1 0 20,14 M20,3 L20,8 L15,8" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
            </Grid>
        </Border>

        <!-- Dense, aligned exception table with visible reason and icon actions. -->
        <Border Grid.Row="6" Style="{StaticResource PendingPanel}" Padding="0" MinHeight="210" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="PendingCardsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          RowHeight="33"
                          ColumnHeaderHeight="36"
                          FontSize="10.8"
                          FlowDirection="RightToLeft"
                          Background="#FFFFFF"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF1F5"
                          RowBackground="#FFFFFF"
                          AlternatingRowBackground="#FFFFF8F9"
                          AlternationCount="2"
                          ColumnHeaderStyle="{StaticResource PendingGridHeader}"
                          CellStyle="{StaticResource PendingGridCell}"
                          RowStyle="{StaticResource PendingGridRow}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="PendingCardsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchId}" SortMemberPath="BatchId" Width="1.22*" ElementStyle="{StaticResource PendingGridText}"/>
                        <DataGridTextColumn Header="رقم الكرت" Binding="{Binding CardNumber}" SortMemberPath="CardNumber" Width="0.93*" ElementStyle="{StaticResource PendingGridText}"/>
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" SortMemberPath="Username" Width="0.95*" ElementStyle="{StaticResource PendingGridText}"/>
                        <DataGridTextColumn Header="الباقة" Binding="{Binding PackageName}" SortMemberPath="PackageName" Width="0.88*" ElementStyle="{StaticResource PendingGridText}"/>
                        <DataGridTextColumn Header="الإجراء المطلوب" Binding="{Binding ActionReasonLabel}" SortMemberPath="ActionReasonLabel" Width="1.18*" ElementStyle="{StaticResource PendingGridText}"/>
                        <DataGridTemplateColumn Header="الحالة" Width="1.12*" SortMemberPath="StatusLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BadgeBackground}" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding PendingActionLabel}">
                                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding BadgeForeground}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding BadgeForeground}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="آخر إجراء" Binding="{Binding LastActionLabel}" SortMemberPath="LastActionLabel" Width="0.92*" ElementStyle="{StaticResource PendingGridText}"/>
                        <DataGridTextColumn Header="تاريخ التحديث" Binding="{Binding UpdatedAtLabel}" SortMemberPath="UpdatedAt" Width="1.05*" ElementStyle="{StaticResource PendingGridText}"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="1.32*" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PendingRowIconButton}" Tag="review" IsEnabled="{Binding NeedsReview}" Click="RowActionButton_Click" ToolTip="فتح للمراجعة" AutomationProperties.Name="فتح الكرت للمراجعة">
                                            <Path Data="M12,3 L22,21 L2,21 Z M12,9 L12,14 M12,17 L12,17.1" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#B42332" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button Style="{StaticResource PendingRowIconButton}" Tag="sync" IsEnabled="{Binding CanRetrySync}" Click="RowActionButton_Click" ToolTip="إعادة المزامنة" AutomationProperties.Name="إعادة مزامنة الكرت">
                                            <Path Data="M20,7 A8,8 0 0 0 5,5 L3,7 M3,3 L3,7 L7,7 M4,17 A8,8 0 0 0 19,19 L21,17 M21,21 L21,17 L17,17" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#A85A00" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button Style="{StaticResource PendingRowIconButton}" Tag="print" IsEnabled="{Binding CanQueuePrint}" Click="RowActionButton_Click" ToolTip="إضافة للطباعة" AutomationProperties.Name="إضافة الكرت للطباعة">
                                            <Path Data="M6,8 L6,3 L18,3 L18,8 M6,17 L3,17 L3,9 L21,9 L21,17 L18,17 M6,14 L18,14 L18,21 L6,21 Z M17,11 L18,11" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#047857" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Button>
                                        <Button Style="{StaticResource PendingRowIconButton}" Tag="queued" IsEnabled="{Binding PrintQueued}" Click="RowActionButton_Click" ToolTip="فتح قائمة الطباعة" AutomationProperties.Name="فتح قائمة الطباعة">
                                            <Path Data="M5,4 L19,4 L19,20 L5,20 Z M8,8 L16,8 M8,12 L16,12 M8,16 L13,16" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="#2563EB" StrokeThickness="1.7" StrokeLineJoin="Round"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="EmptyStateBorder" Background="#FFFFFF" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="2" CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#FCEEF2" HorizontalAlignment="Center">
                            <Path Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15.5,15.5 L21,21" Width="20" Height="20" Stretch="Uniform" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="لا توجد عناصر معلّقة" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="غيّر الفلاتر أو حدّث القائمة." FontSize="10.8" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Same footer and numbered pager as batch management. -->
        <Border Grid.Row="8" Style="{StaticResource PendingPanel}" Padding="8,5" Margin="0">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultSummaryTextBlock" Grid.Column="0" Text="جارٍ تحميل المعلّقات..." FontSize="10.7" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <StackPanel x:Name="PagerButtonsPanel" Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                    <TextBlock Text="عدد الصفوف" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="PageSizeComboBox" Style="{StaticResource PendingComboBox}" SelectedValuePath="Tag" Width="64" Height="30" SelectionChanged="PageSizeComboBox_SelectionChanged">
                        <ComboBoxItem Content="9" Tag="9" IsSelected="True"/>
                        <ComboBoxItem Content="18" Tag="18"/>
                        <ComboBoxItem Content="27" Tag="27"/>
                        <ComboBoxItem Content="45" Tag="45"/>
                        <ComboBoxItem Content="90" Tag="90"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="PendingStatusTextBlock" Grid.Column="3" Text="" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="290" Margin="10,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
