<UserControl x:Class="Nexora.Demo.Desktop.Features.Cards.Views.CardBatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource AppBgBrush}"
             FontFamily="Segoe UI"
             FontSize="11.5"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ManagementPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9" />
        </Style>
        <Style x:Key="ManagementTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="35" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ManagementComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="33" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="9,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FCEEF2" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FCEEF2" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True" FlowDirection="LeftToRight">
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                            <ContentPresenter IsHitTestVisible="False" FlowDirection="RightToLeft" Margin="30,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <ToggleButton HorizontalAlignment="Left" Width="28" Focusable="False" Background="Transparent" BorderThickness="0" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></ControlTemplate>
                                </ToggleButton.Template>
                                <Path Data="M3,4 L7,8 L11,4" Width="12" Height="8" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#DFE4EB" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManagementSmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FCEEF2" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B33D56" /><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#B33D56" /><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B33D56" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ManagementIconButton" TargetType="Button" BasedOn="{StaticResource ManagementSmallButton}">
            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="2,0" />
        </Style>
        <Style x:Key="ManagementFilterButton" TargetType="Button" BasedOn="{StaticResource ManagementIconButton}">
            <Setter Property="Width" Value="36" /><Setter Property="Height" Value="34" /><Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="ManagementPagerButton" TargetType="Button" BasedOn="{StaticResource ManagementSmallButton}">
            <Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="30" /><Setter Property="Padding" Value="5,0" /><Setter Property="Margin" Value="2,0" /><Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ManagementPagerButtonCurrent" TargetType="Button" BasedOn="{StaticResource ManagementPagerButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="ManagementGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FBECEF" /><Setter Property="Foreground" Value="#26354D" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="11.5" /><Setter Property="Padding" Value="6,0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="BorderBrush" Value="#F2D6DD" /><Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="ManagementGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="3,0" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#EDF0F4" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FCE2E8" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="ManagementGridTextCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="Margin" Value="2,0" /><Setter Property="FontSize" Value="11.3" /><Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="ManagementGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#EDF0F4" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="MinHeight" Value="33" /><Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="#FFFFF8F9" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF5F7" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FDE7EC" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BatchStatusBadge" TargetType="Border">
            <Setter Property="Background" Value="#FFF4E1" /><Setter Property="BorderBrush" Value="#F3D9A6" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="6,3" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="MinWidth" Value="98" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}" Value="مكتملة المزامنة"><Setter Property="Background" Value="#E7FAF1" /><Setter Property="BorderBrush" Value="#BDEBD6" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="مكتملة جزئياً"><Setter Property="Background" Value="#EAF3FF" /><Setter Property="BorderBrush" Value="#C9DFFF" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="جارٍ المزامنة"><Setter Property="Background" Value="#EAF3FF" /><Setter Property="BorderBrush" Value="#C9DFFF" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="بانتظار المزامنة"><Setter Property="Background" Value="#FFF4E1" /><Setter Property="BorderBrush" Value="#F3D9A6" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="فشلت المزامنة"><Setter Property="Background" Value="#FFF0F2" /><Setter Property="BorderBrush" Value="#F4CBD4" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="تحتاج مراجعة"><Setter Property="Background" Value="#FFF0F2" /><Setter Property="BorderBrush" Value="#F4CBD4" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="معطلة"><Setter Property="Background" Value="#F1F3F5" /><Setter Property="BorderBrush" Value="#D6DBE1" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="معطلة ومؤرشفة"><Setter Property="Background" Value="#F2EEE8" /><Setter Property="BorderBrush" Value="#D9D0C4" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="منتهية ومؤرشفة"><Setter Property="Background" Value="#E9EDF2" /><Setter Property="BorderBrush" Value="#D2D9E2" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="غير متزامنة"><Setter Property="Background" Value="#FFF4E1" /><Setter Property="BorderBrush" Value="#F3D9A6" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BatchStatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" /><Setter Property="Height" Value="7" /><Setter Property="Fill" Value="#B45309" /><Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}" Value="مكتملة المزامنة"><Setter Property="Fill" Value="#047857" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="مكتملة جزئياً"><Setter Property="Fill" Value="#1D4ED8" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="جارٍ المزامنة"><Setter Property="Fill" Value="#1D4ED8" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="فشلت المزامنة"><Setter Property="Fill" Value="#B91C36" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="تحتاج مراجعة"><Setter Property="Fill" Value="#B91C36" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="معطلة"><Setter Property="Fill" Value="#64748B" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="معطلة ومؤرشفة"><Setter Property="Fill" Value="#766A5D" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="منتهية ومؤرشفة"><Setter Property="Fill" Value="#64748B" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BatchStatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B45309" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="10.6" /><Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusLabel}" Value="مكتملة المزامنة"><Setter Property="Foreground" Value="#047857" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="مكتملة جزئياً"><Setter Property="Foreground" Value="#1D4ED8" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="جارٍ المزامنة"><Setter Property="Foreground" Value="#1D4ED8" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="فشلت المزامنة"><Setter Property="Foreground" Value="#B91C36" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="تحتاج مراجعة"><Setter Property="Foreground" Value="#B91C36" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="معطلة"><Setter Property="Foreground" Value="#475569" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="معطلة ومؤرشفة"><Setter Property="Foreground" Value="#66594C" /></DataTrigger>
                <DataTrigger Binding="{Binding StatusLabel}" Value="منتهية ومؤرشفة"><Setter Property="Foreground" Value="#475569" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BatchActionButton" TargetType="Button" BasedOn="{StaticResource ManagementIconButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE2EA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="BatchPrimaryButton" TargetType="Button" BasedOn="{StaticResource ManagementSmallButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#A91428"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A91428"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#860F20"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#860F20"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: one clear page title and the primary action. -->
        <Grid Grid.Row="0" FlowDirection="RightToLeft" Margin="2,0,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="إدارة الدفعات" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="متابعة دفعات الإصدار وحالتها وطباعتها ومزامنتها مع النظام المستهدف." FontSize="11.2" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource BatchPrimaryButton}" Click="NewBatchButton_Click" ToolTip="الانتقال إلى إصدار الكروت وإنشاء دفعة جديدة" AutomationProperties.Name="إصدار دفعة جديدة">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center">
                    <Path Data="M12,4 L12,20 M4,12 L20,12" Width="14" Height="14" Stretch="Uniform" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,7,0"/>
                    <TextBlock Text="إصدار دفعة جديدة" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Four honest metrics: batch quantity comes from the batch record, not linked row counts. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource ManagementPanel}" Background="#F3F5F8" BorderBrush="#E1E7EF" Padding="10,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#E9EDF3" VerticalAlignment="Center"><Path Data="M4,5 L20,5 L20,9 L4,9 Z M4,11 L20,11 L20,15 L4,15 Z M4,17 L20,17 L20,21 L4,21 Z" Width="21" Height="21" Stretch="Uniform" Fill="Transparent" Stroke="#475569" StrokeThickness="1.7" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="إجمالي الدفعات" FontSize="11.2" FontWeight="SemiBold" Foreground="#334155"/><TextBlock x:Name="BatchCountTextBlock" Text="0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource ManagementPanel}" Background="#EFF5FF" BorderBrush="#D8E6FF" Padding="10,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#EAF2FF" VerticalAlignment="Center"><Path Data="M3,5 L21,5 L21,19 L3,19 Z M7,9 L17,9 M7,13 L14,13" Width="21" Height="21" Stretch="Uniform" Fill="Transparent" Stroke="#2563EB" StrokeThickness="1.8" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="إجمالي كروت الدفعات" FontSize="11.2" FontWeight="SemiBold" Foreground="#1E3A5F"/><TextBlock x:Name="CardCountTextBlock" Text="0" FontSize="21" FontWeight="Bold" Foreground="#1D4ED8"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource ManagementPanel}" Background="#ECFBF4" BorderBrush="#CDEFE0" Padding="10,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#E7F8EF" VerticalAlignment="Center"><Path Data="M4,7 L20,7 L20,19 L4,19 Z M8,4 L16,4 M8,11 L16,11 M8,15 L13,15" Width="21" Height="21" Stretch="Uniform" Fill="Transparent" Stroke="#047857" StrokeThickness="1.8" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="قيمة الإصدار المسجلة" FontSize="11.2" FontWeight="SemiBold" Foreground="#047857"/><TextBlock x:Name="IssuanceValueTextBlock" Text="0 ريال" FontSize="19" FontWeight="Bold" Foreground="#047857"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource ManagementPanel}" Background="#FFF4E1" BorderBrush="#F3D9A6" Padding="10,8">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#FFF0D1" VerticalAlignment="Center"><Path Data="M12,3 L12,13 M12,18 L12,18.1 M21,12 A9,9 0 1 0 3,12 A9,9 0 1 0 21,12" Width="21" Height="21" Stretch="Uniform" Fill="Transparent" Stroke="#B45309" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="بانتظار المزامنة" FontSize="11.2" FontWeight="SemiBold" Foreground="#92400E"/><TextBlock x:Name="PendingBatchesCountTextBlock" Text="0" FontSize="21" FontWeight="Bold" Foreground="#B45309"/></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Clean direct filters; the active target system is inherited from the top-level tabs. -->
        <Border Grid.Row="4" Style="{StaticResource ManagementPanel}" Padding="8,7">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/><ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="1.05*"/><ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="0.95*"/><ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="1.7*"/><ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="حالة الدفعة" FontSize="10.8" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="BatchStatusFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectedValuePath="Tag" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="كل الحالات" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="بانتظار المزامنة" Tag="waiting"/>
                        <ComboBoxItem Content="غير متزامنة" Tag="unsynced"/>
                        <ComboBoxItem Content="جارٍ المزامنة" Tag="syncing"/>
                        <ComboBoxItem Content="مكتملة جزئياً" Tag="partial"/>
                        <ComboBoxItem Content="مكتملة المزامنة" Tag="synced"/>
                        <ComboBoxItem Content="فشلت المزامنة" Tag="failed"/>
                        <ComboBoxItem Content="تحتاج مراجعة" Tag="review"/>
                        <ComboBoxItem Content="معطلة" Tag="disabled"/>
                        <ComboBoxItem Content="معطلة ومؤرشفة" Tag="disabled-archived"/>
                        <ComboBoxItem Content="منتهية ومؤرشفة" Tag="expired-archived"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="الباقة" FontSize="10.8" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PackageFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectedValuePath="Tag" SelectionChanged="Filter_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="تاريخ الإنشاء" FontSize="10.8" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CreatedPeriodFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectedValuePath="Tag" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="كل الفترات" Tag="all" IsSelected="True"/>
                        <ComboBoxItem Content="اليوم" Tag="today"/>
                        <ComboBoxItem Content="آخر 7 أيام" Tag="7-days"/>
                        <ComboBoxItem Content="آخر 30 يوماً" Tag="30-days"/>
                    </ComboBox>
                </StackPanel>
                <Grid Grid.Column="6" Height="35" VerticalAlignment="Bottom">
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource ManagementTextBox}" Padding="32,3,10,3" TextChanged="Filter_Changed" ToolTip="ابحث برقم الدفعة أو الباقة أو نقطة البيع أو ملف الراوتر"/>
                    <Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22" Width="17" Height="17" Stretch="Uniform" Fill="Transparent" Stroke="#52627A" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchPlaceholderTextBlock" Text="ابحث برقم الدفعة أو الباقة أو نقطة البيع..." FontSize="10.7" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="38,0,12,0" TextAlignment="Right" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="AdvancedFiltersButton" Grid.Column="8" Style="{StaticResource ManagementFilterButton}" VerticalAlignment="Bottom" Click="AdvancedFiltersButton_Click" ToolTip="فلاتر إضافية" AutomationProperties.Name="فلاتر إضافية">
                    <Path Data="M3,4 L21,4 L14,12 L14,19 L10,21 L10,12 Z" Width="15" Height="15" Stretch="Uniform" Fill="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button Grid.Column="10" Style="{StaticResource ManagementIconButton}" VerticalAlignment="Bottom" Click="ClearFiltersButton_Click" ToolTip="مسح الفلاتر" AutomationProperties.Name="مسح الفلاتر">
                    <Path Data="M4,4 L20,20 M20,4 L4,20" Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Button Grid.Column="12" Style="{StaticResource ManagementIconButton}" VerticalAlignment="Bottom" Click="RefreshButton_Click" ToolTip="تحديث سجل الدفعات" AutomationProperties.Name="تحديث سجل الدفعات">
                    <Path Data="M20,8 A8,8 0 1 0 20,14 M20,3 L20,8 L15,8" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>
            </Grid>
        </Border>

        <!-- Compact batch register with per-row actions and no inner vertical scrolling. -->
        <Grid Grid.Row="6">
            <Border Style="{StaticResource ManagementPanel}" Padding="0" ClipToBounds="True">
                <DataGrid x:Name="BatchesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True" CanUserSortColumns="True" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="34" ColumnHeaderHeight="36" FontSize="10.8" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F2F6" AlternationCount="2" AlternatingRowBackground="#FFFFF8F9" ColumnHeaderStyle="{StaticResource ManagementGridHeaderStyle}" CellStyle="{StaticResource ManagementGridCellStyle}" RowStyle="{StaticResource ManagementGridRowStyle}" CanUserResizeRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Sorting="BatchesGrid_Sorting" MouseDoubleClick="BatchesGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchId}" SortMemberPath="BatchId" Width="1.32*" ElementStyle="{StaticResource ManagementGridTextCellStyle}"/>
                        <DataGridTextColumn Header="الباقة" Binding="{Binding PackageName}" SortMemberPath="PackageName" Width="1.16*" ElementStyle="{StaticResource ManagementGridTextCellStyle}"/>
                        <DataGridTextColumn Header="نقطة البيع" Binding="{Binding PointOfSale}" SortMemberPath="PointOfSale" Width="0.9*" ElementStyle="{StaticResource ManagementGridTextCellStyle}"/>
                        <DataGridTextColumn Header="عدد الكروت" Binding="{Binding Quantity, StringFormat={}{0:N0}}" SortMemberPath="Quantity" Width="0.66*" ElementStyle="{StaticResource ManagementGridTextCellStyle}"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPriceLabel}" SortMemberPath="UnitPrice" Width="0.78*" ElementStyle="{StaticResource ManagementGridTextCellStyle}"/>
                        <DataGridTextColumn Header="قيمة الإصدار" Binding="{Binding TotalLabel}" SortMemberPath="Total" Width="0.86*" ElementStyle="{StaticResource ManagementGridTextCellStyle}"/>
                        <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAtLabel}" SortMemberPath="CreatedAt" Width="1.02*" ElementStyle="{StaticResource ManagementGridTextCellStyle}"/>
                        <DataGridTextColumn Header="أُرسل للطباعة" Binding="{Binding PrintedCountLabel}" SortMemberPath="PrintedCount" Width="0.72*" ElementStyle="{StaticResource ManagementGridTextCellStyle}"/>
                        <DataGridTemplateColumn Header="الحالة" Width="1.08*" SortMemberPath="StatusLabel">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <Border Style="{StaticResource BatchStatusBadge}"><StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center"><Ellipse Style="{StaticResource BatchStatusDot}"/><TextBlock Text="{Binding StatusLabel}" Style="{StaticResource BatchStatusText}" Margin="5,0,0,0"/></StackPanel></Border>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="الإجراءات" Width="1.32*" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BatchActionButton}" Tag="sync" IsEnabled="{Binding CanSync}" ToolTip="{Binding SyncToolTip}" Click="BatchActionButton_Click" AutomationProperties.Name="مزامنة الدفعة"><Path Data="M20,7 A8,8 0 0 0 5,5 L3,7 M3,3 L3,7 L7,7 M4,17 A8,8 0 0 0 19,19 L21,17 M21,21 L21,17 L17,17" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#2563EB" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
                                    <Button Style="{StaticResource BatchActionButton}" Tag="print" IsEnabled="{Binding CanPrint}" ToolTip="{Binding PrintToolTip}" Click="BatchActionButton_Click" AutomationProperties.Name="طباعة الدفعة"><Path Data="M6,8 L6,3 L18,3 L18,8 M6,17 L3,17 L3,9 L21,9 L21,17 L18,17 M6,14 L18,14 L18,21 L6,21 Z M17,11 L18,11" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#047857" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
                                    <Button Style="{StaticResource BatchActionButton}" Tag="toggle-disabled" IsEnabled="{Binding CanToggleDisabled}" ToolTip="{Binding DisableActionToolTip}" Click="BatchActionButton_Click" AutomationProperties.Name="تعطيل أو تفعيل الدفعة"><Path Data="M12,3 L12,12 M7,5 A9,9 0 1 0 17,5" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#B45309" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Button>
                                    <Button Style="{StaticResource BatchActionButton}" Tag="archive" IsEnabled="{Binding CanArchive}" ToolTip="{Binding ArchiveActionToolTip}" Click="BatchActionButton_Click" AutomationProperties.Name="أرشفة أو استعادة الدفعة"><Path x:Name="ArchiveActionPath" Data="M3,5 L21,5 L21,21 L3,21 Z M2,2 L22,2 L22,5 L2,5 Z M8,10 L16,10 M8,14 L16,14" Width="15" Height="15" Stretch="Uniform" Fill="Transparent" Stroke="#64748B" StrokeThickness="1.7" StrokeLineJoin="Round"/></Button>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                        <Setter TargetName="ArchiveActionPath" Property="Data" Value="M4,12 L12,4 L20,12 M12,4 L12,20 M5,16 L5,21 L19,21 L19,16"/>
                                        <Setter TargetName="ArchiveActionPath" Property="Stroke" Value="#047857"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450" Padding="24">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="14" Background="#FCEEF2" HorizontalAlignment="Center"><Path Data="M4,5 L20,5 L20,9 L4,9 Z M4,11 L20,11 L20,15 L4,15 Z M4,17 L20,17 L20,21 L4,21 Z" Width="23" Height="23" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="إدارة الدفعات" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock x:Name="EmptyStateDescriptionTextBlock" Text="لا توجد دفعات تطابق البحث والفلاتر الحالية." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" FontSize="11.5"/>
                    <Button Content="مسح الفلاتر" Style="{StaticResource ManagementSmallButton}" HorizontalAlignment="Center" Margin="0,12,0,0" Click="ClearFiltersButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer only contains result count, page controls, page size, and truthful operation feedback. -->
        <Border Grid.Row="8" Style="{StaticResource ManagementPanel}" Padding="8,5">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ResultSummaryTextBlock" Grid.Column="0" Text="جارٍ تحميل سجل الدفعات..." FontSize="10.7" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <StackPanel x:Name="PagerButtonsPanel" Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                    <TextBlock Text="عدد الصفوف" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox x:Name="PageSizeComboBox" Style="{StaticResource ManagementComboBox}" SelectedValuePath="Tag" Width="64" Height="30" SelectionChanged="PageSizeComboBox_SelectionChanged">
                        <ComboBoxItem Content="9" Tag="9" IsSelected="True"/><ComboBoxItem Content="18" Tag="18"/><ComboBoxItem Content="27" Tag="27"/><ComboBoxItem Content="45" Tag="45"/><ComboBoxItem Content="90" Tag="90"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="OperationStatusTextBlock" Grid.Column="3" Text="" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="300" Margin="10,0,0,0" Visibility="Collapsed"/>
                <TextBlock Grid.Column="4" Text="انقر مرتين على الدفعة لعرض كروتها" FontSize="9.8" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <Popup x:Name="AdvancedFiltersPopup" PlacementTarget="{Binding ElementName=AdvancedFiltersButton}" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" FlowDirection="RightToLeft">
            <Border Width="350" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="إغلاق" Style="{StaticResource ManagementSmallButton}" Padding="10,0" Click="AdvancedFiltersCloseButton_Click"/>
                        <TextBlock Text="فلاتر إضافية للدفعات" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="نقطة البيع" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PointOfSaleFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectedValuePath="Tag" SelectionChanged="Filter_Changed" Margin="0,0,0,10"/>
                    <TextBlock Text="ملف الراوتر" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="RouterProfileFilterComboBox" Style="{StaticResource ManagementComboBox}" SelectedValuePath="Tag" SelectionChanged="Filter_Changed" Margin="0,0,0,12"/>
                    <Button Content="مسح جميع الفلاتر" Style="{StaticResource ManagementSmallButton}" HorizontalAlignment="Stretch" Click="ClearFiltersButton_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
