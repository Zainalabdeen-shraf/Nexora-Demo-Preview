
<UserControl x:Class="Nexora.Demo.Desktop.Features.Cards.Views.UserManagerCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F4F6F8"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="UmInk" Color="#20242A"/>
        <SolidColorBrush x:Key="UmMuted" Color="#6D7480"/>
        <SolidColorBrush x:Key="UmPrimary" Color="#A01818"/>
        <SolidColorBrush x:Key="UmPrimaryDark" Color="#7F1118"/>
        <SolidColorBrush x:Key="UmPrimarySoft" Color="#F9EDED"/>
        <SolidColorBrush x:Key="UmSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="UmLine" Color="#DEE1E6"/>
        <SolidColorBrush x:Key="UmField" Color="#F8F9FB"/>
        <Style x:Key="UmPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource UmSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UmLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style x:Key="UmButton" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource UmInk}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UmLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="UmPrimaryButton" TargetType="Button" BasedOn="{StaticResource UmButton}">
            <Setter Property="Background" Value="{StaticResource UmPrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource UmPrimary}"/>
        </Style>
        <Style x:Key="UmSearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource UmInk}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UmLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource UmInk}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9ECF0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#F0F1F4"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9EDED"/>
            <Setter Property="Foreground" Value="#762027"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderBrush" Value="#E4D5D8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="2,0,2,10" LastChildFill="True">
            <Border DockPanel.Dock="Left" Background="{StaticResource UmPrimarySoft}" BorderBrush="#E8C8CC" BorderThickness="1" CornerRadius="7" Padding="10,5" VerticalAlignment="Center">
                <TextBlock Text="إدارة حسابات الشبكة" Foreground="{StaticResource UmPrimaryDark}" FontSize="10.5" FontWeight="SemiBold"/>
            </Border>
            <StackPanel>
                <TextBlock x:Name="CardsTitleTextBlock" Text="إدارة كروت User Manager" FontSize="21" FontWeight="Bold" Foreground="{StaticResource UmInk}"/>
                <TextBlock x:Name="CardsScopeTextBlock" Text="إدارة موحدة للحسابات مع إمكانية التصفية حسب المصدر والحالة والدفعة." FontSize="11" Foreground="{StaticResource UmMuted}" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="SearchTextBox" Style="{StaticResource UmSearchBox}" TextChanged="SearchTextBox_TextChanged" ToolTip="بحث باسم المستخدم أو رقم الكرت أو الدفعة أو الباقة"/>
                <TextBlock x:Name="SearchPlaceholderTextBlock" Text="ابحث باسم المستخدم أو الرقم التسلسلي أو الدفعة…" Foreground="#7A8390" FontSize="11.5" VerticalAlignment="Center" Margin="11,0,9,0" IsHitTestVisible="False"/>
            </Grid>
            <Button Grid.Column="2" Content="تصفية ▾" Style="{StaticResource UmButton}" Click="FilterButton_Click"/>
            <Button Grid.Column="3" Content="الأعمدة" Style="{StaticResource UmButton}" Click="ColumnsButton_Click"/>
            <Button Grid.Column="4" Content="تحديث" Style="{StaticResource UmButton}" Click="RefreshButton_Click"/>
            <Button Grid.Column="5" Content="طباعة" Style="{StaticResource UmButton}" Click="PrintButton_Click"/>
            <Button Grid.Column="6" Content="تصدير" Style="{StaticResource UmButton}" Click="ExportButton_Click"/>
            <Button Grid.Column="7" Content="إضافة كرت" Style="{StaticResource UmPrimaryButton}" Click="AddCardButton_Click"/>
            <Button Grid.Column="8" Content="المزيد ▾" Style="{StaticResource UmButton}" Click="MoreButton_Click"/>
        </Grid>

        <Border x:Name="SelectionActionsPanel" Grid.Row="2" Style="{StaticResource UmPanel}" Padding="7,5" Margin="0,0,0,8" Visibility="Collapsed" Background="#FCF7F7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionCountTextBlock" Text="تم تحديد 0" Foreground="{StaticResource UmPrimaryDark}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,5,0"/>
                    <Button x:Name="SelectionDetailsButton" Content="التفاصيل" Style="{StaticResource UmButton}" Click="SelectionDetailsButton_Click"/>
                    <Button Content="طباعة المحدد" Style="{StaticResource UmPrimaryButton}" Click="SelectionPrintButton_Click"/>
                    <Button Content="عمليات المحدد ▾" Style="{StaticResource UmButton}" Click="SelectionMoreButton_Click"/>
                </StackPanel>
                <Button DockPanel.Dock="Left" Content="إلغاء التحديد" Style="{StaticResource UmButton}" Click="ClearSelectionButton_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Border Style="{StaticResource UmPanel}" Padding="1">
                <DataGrid x:Name="CardsGrid" FlowDirection="RightToLeft" AutoGenerateColumns="False"
                          SelectionChanged="CardsGrid_SelectionChanged" Sorting="CardsGrid_Sorting"
                          MouseDoubleClick="CardsGrid_MouseDoubleClick" ContextMenuOpening="CardsGrid_ContextMenuOpening"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" />
            </Border>
            <Border x:Name="EmptyStateBorder" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="{StaticResource UmLine}" BorderThickness="1" CornerRadius="9" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="لا توجد كروت مطابقة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource UmInk}" HorizontalAlignment="Center"/>
                    <TextBlock Text="غيّر البحث أو التصفية، أو أضف كروت من شاشة الإصدار." Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource UmMuted}" HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="2,8,2,0" LastChildFill="True">
            <TextBlock x:Name="CardsCountSummaryTextBlock" DockPanel.Dock="Right" Text="الكروت: 0" FontSize="10.5" Foreground="{StaticResource UmMuted}" VerticalAlignment="Center"/>
            <Button x:Name="ClearFilterButton" DockPanel.Dock="Left" Content="مسح التصفية" Style="{StaticResource UmButton}" Height="29" MinWidth="90" Click="ClearFilterButton_Click" Visibility="Collapsed"/>
            <TextBlock x:Name="CurrentFilterTextBlock" Text="" FontSize="10.5" Foreground="{StaticResource UmPrimaryDark}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>