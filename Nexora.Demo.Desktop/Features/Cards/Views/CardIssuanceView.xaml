                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="54" Canvas.Top="45"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="38" Canvas.Top="53"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="46" Canvas.Top="53"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="63" Canvas.Top="39"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="71" Canvas.Top="47"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="79" Canvas.Top="39"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="63" Canvas.Top="55"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="79" Canvas.Top="55"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="39" Canvas.Top="67"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="47" Canvas.Top="75"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="55" Canvas.Top="83"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="63" Canvas.Top="71"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="71" Canvas.Top="79"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="79" Canvas.Top="87"/>
                          <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="87" Canvas.Top="71"/>
                        </Canvas>
                      </Viewbox>
                    </Border>
                    <Border x:Name="PreviewBarcodeBorder" Grid.Column="2" Width="48" Height="32" Padding="3" Background="White" BorderBrush="#E2C7C9" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" Visibility="Collapsed">
                      <Canvas ClipToBounds="True">
                        <Rectangle Width="2" Height="24" Fill="#111827" Canvas.Left="2" Canvas.Top="1"/>
                        <Rectangle Width="1" Height="24" Fill="#111827" Canvas.Left="5" Canvas.Top="1"/>
                        <Rectangle Width="3" Height="24" Fill="#111827" Canvas.Left="8" Canvas.Top="1"/>
