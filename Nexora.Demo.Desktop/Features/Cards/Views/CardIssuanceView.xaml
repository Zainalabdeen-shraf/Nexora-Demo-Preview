          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid FlowDirection="RightToLeft" Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Style="{StaticResource TabCardPanel}" Margin="0,0,0,2" Padding="4">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Height="3" Background="#C51B2B" HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
              <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="1"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="معلومات الدفعة والباقة" Style="{StaticResource TabCardSectionTitle}"/>
                <!-- معلومات الدفعة والباقة: الباقة والقالب ونقطة البيع في العمود الأيمن؛ الكمية والدخول وملف الاستخدام في العمود الأيسر. -->
                <Grid Grid.Row="2" FlowDirection="LeftToRight">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <!-- العمود الأيسر: الباقة، وزر الإضافة على الطرف المقابل للحقل -->
                  <Grid Grid.Row="0" Grid.Column="0" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="الباقة" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" FontSize="10.5" Margin="0,0,0,1"/>
                    <Grid Grid.Row="1" Height="26" FlowDirection="LeftToRight">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Button x:Name="AddPackageButton" Grid.Column="0" Content="+" Style="{StaticResource TabCardPlusButton}" Width="25" MinWidth="25" Height="25" ToolTip="إضافة باقة" Click="AddPackageButton_Click"/>
                      <ComboBox x:Name="PackageComboBox" Grid.Column="1" Height="25" Style="{StaticResource TabCardComboBox}" DisplayMemberPath="DisplayName" SelectionChanged="PackageComboBox_SelectionChanged"/>
                    </Grid>
                  </Grid>
                  <!-- العمود الأيمن: عدد الكروت -->
                  <Grid Grid.Row="0" Grid.Column="2" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="عدد الكروت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" FontSize="10.5" Margin="0,0,0,1"/>
                    <TextBox x:Name="QuantityTextBox" Grid.Row="1" Height="25" Style="{StaticResource TabCardTextBox}" Text="100" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" TextChanged="FormTextChanged"/>
                  </Grid>
                  <!-- العمود الأيسر: قالب الكرت، والزر يفتح شاشة التصميم الحالية -->
                  <Grid Grid.Row="2" Grid.Column="0" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="قالب الكرت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" FontSize="10.5" Margin="0,0,0,1"/>
                    <Grid Grid.Row="1" Height="26" FlowDirection="LeftToRight">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Button x:Name="OpenTemplateDesignerButton" Grid.Column="0" Content="+" Style="{StaticResource TabCardPlusButton}" Width="25" MinWidth="25" Height="25" ToolTip="فتح شاشة تصميم القالب" Click="OpenTemplateDesignerButton_Click"/>
                      <ComboBox x:Name="PrintTemplateComboBox" Grid.Column="1" Height="25" Style="{StaticResource TabCardComboBox}" ToolTip="القالب المحفوظ من شاشة الطباعة والتصميم">
                        <ComboBoxItem Content="القالب الافتراضي" Tag="designer" IsSelected="True"/>
                      </ComboBox>
                    </Grid>
                  </Grid>
                  <!-- العمود الأيمن: طريقة الدخول -->
                  <Grid Grid.Row="2" Grid.Column="2" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PasswordModeLabelTextBlock" Grid.Row="0" Text="صيغة الدخول" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" FontSize="10.5" Margin="0,0,0,1"/>
                    <ComboBox x:Name="PasswordModeComboBox" Grid.Row="1" Height="25" Style="{StaticResource TabCardComboBox}" SelectionChanged="PasswordModeComboBox_SelectionChanged">
                      <ComboBoxItem Content="كلمة مرور فارغة" Tag="Empty" IsSelected="True"/>
                      <ComboBoxItem Content="مثل اسم المستخدم" Tag="SameAsUsername"/>
                      <ComboBoxItem Content="كلمة مرور مختلفة" Tag="Generated"/>
                    </ComboBox>
                  </Grid>
                  <!-- العمود الأيسر: نقطة البيع -->
                  <Grid Grid.Row="4" Grid.Column="0" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="نقطة البيع" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" FontSize="10.5" Margin="0,0,0,1"/>
                    <Grid Grid.Row="1" Height="26" FlowDirection="LeftToRight">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Content="+" Style="{StaticResource TabCardPlusButton}" Width="25" MinWidth="25" Height="25" ToolTip="إضافة نقطة بيع" Click="AddPointOfSaleButton_Click"/>
                      <ComboBox x:Name="PointOfSaleComboBox" Grid.Column="1" Height="25" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged">
                        <ComboBoxItem Content="المركز الرئيسي" Tag="main" IsSelected="True"/>
                        <ComboBoxItem Content="نقطة بيع الحي" Tag="neighborhood"/>
                        <ComboBoxItem Content="وكيل الشبكة" Tag="agent"/>
                      </ComboBox>
                    </Grid>
                  </Grid>
                  <!-- العمود الأيمن: ملف الاستخدام، مع الحفاظ على TextBox واسمه ومعالج التغيير الحاليين. -->
                  <Grid Grid.Row="4" Grid.Column="2" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ملف الاستخدام" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" FontSize="10.5" Margin="0,0,0,1"/>
                    <TextBox x:Name="RouterProfileTextBox" Grid.Row="1" Height="25" Style="{StaticResource TabCardTextBox}" FlowDirection="LeftToRight" TextChanged="FormTextChanged" ToolTip="ملف الاستخدام المرتبط بالباقة ومصدر الإصدار"/>
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Row="1" Style="{StaticResource TabCardPanel}" Padding="4" Margin="0,0,0,2">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="2"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Height="3" Background="#C51B2B" HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
              <Border Grid.Row="1" Background="#FCEBED" CornerRadius="6" Padding="6,2" Margin="0,0,0,2">
                <TextBlock Text="بيانات الكرت" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TabCardInk}" HorizontalAlignment="Right"/>
              </Border>
              <Grid Grid.Row="2" Margin="0,0,0,0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,2" FlowDirection="RightToLeft">
                  <TextBlock x:Name="CardNumberPatternLabelTextBlock" Text="طول ونمط رقم الكرت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="0,0,0,2"/>
                  <Grid Height="25" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CardNumberLengthTextBox" Grid.Column="0" Height="25" Style="{StaticResource TabCardTextBox}" Text="8" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" TextChanged="FormTextChanged" ToolTip="طول رقم الكرت أو اسم المستخدم وفق جهة الإصدار"/>
                    <ComboBox x:Name="CardNumberCharacterSetComboBox" Grid.Column="1" Height="25" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged">
                      <ComboBoxItem Content="أرقام فقط" Tag="NumericOnly" IsSelected="True"/>
                      <ComboBoxItem Content="حروف وأرقام" Tag="AlphaNumeric"/>
                      <ComboBoxItem Content="حروف فقط" Tag="LettersOnly"/>
                    </ComboBox>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,2" FlowDirection="RightToLeft">
                  <TextBlock Text="بداية الكرت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="0,0,0,2"/>
                  <TextBox x:Name="CardPrefixTextBox" Height="25" Style="{StaticResource TabCardTextBox}" FlowDirection="LeftToRight" TextChanged="FormTextChanged" ToolTip="بادئة تضاف قبل رقم الكرت"/>
                </StackPanel>
                <Grid x:Name="CredentialIdentityPanel" Grid.Row="1" Grid.Column="0" Margin="0,0,0,3" FlowDirection="RightToLeft">

                  <StackPanel x:Name="ManagerUserPanel" Visibility="Collapsed" FlowDirection="RightToLeft">
                    <TextBlock Text="حساب مدير المستخدمين" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="ManagerUserComboBox" Height="25" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged" ToolTip="حساب الإدارة المستخدم في سياق User Manager، وليس اسم المستخدم المطبوع على الكرت.">
                      <ComboBoxItem Content="مدير النظام" Tag="admin" IsSelected="True"/>
                      <ComboBoxItem Content="مشغل الشبكة" Tag="network-operator"/>
                      <ComboBoxItem Content="مسؤول نقطة البيع" Tag="pos-operator"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,2" FlowDirection="RightToLeft">
                  <TextBlock Text="نهاية الكرت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="0,0,0,2"/>
                  <TextBox x:Name="CardSuffixTextBox" Height="25" Style="{StaticResource TabCardTextBox}" FlowDirection="LeftToRight" TextChanged="FormTextChanged" ToolTip="لاحقة تضاف بعد رقم الكرت"/>
                </StackPanel>
                <StackPanel x:Name="PasswordGenerationPanel" Grid.Row="2" Grid.Column="0" Margin="0,0,0,0" FlowDirection="RightToLeft">
                  <TextBlock Text="طول ونمط كلمة المرور" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="0,0,0,2"/>
                  <Grid Height="25" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="42"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PasswordLengthTextBox" Grid.Column="0" Height="25" Style="{StaticResource TabCardTextBox}" Text="4" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" TextChanged="FormTextChanged" ToolTip="طول كلمة المرور عند اختيار كلمة مرور مختلفة"/>
                    <ComboBox x:Name="PasswordCharacterSetComboBox" Grid.Column="1" Height="25" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged">
                      <ComboBoxItem Content="أرقام فقط" Tag="NumericOnly" IsSelected="True"/>
                      <ComboBoxItem Content="حروف وأرقام" Tag="AlphaNumeric"/>
                      <ComboBoxItem Content="حروف فقط" Tag="LettersOnly"/>
                    </ComboBox>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0" FlowDirection="RightToLeft">
                  <TextBlock Text="عدد الأجهزة المتزامنة" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="0,0,0,2"/>
                  <ComboBox x:Name="SharedUsersComboBox" Height="25" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged" ToolTip="الحد الأعلى لعدد الأجهزة أو الجلسات التي تستخدم بيانات الدخول نفسها في الوقت نفسه.">
                    <ComboBoxItem Content="جهاز واحد" Tag="1" IsSelected="True"/>
                    <ComboBoxItem Content="جهازان" Tag="2"/>
                    <ComboBoxItem Content="3 أجهزة" Tag="3"/>
                    <ComboBoxItem Content="5 أجهزة" Tag="5"/>
                    <ComboBoxItem Content="10 أجهزة" Tag="10"/>
                  </ComboBox>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource TabCardPanel}" Padding="4" Margin="0,0,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" FlowDirection="LeftToRight" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="AppendToPreviousBatchRadioButton" Grid.Column="0" GroupName="BatchRegistrationMode" Content="إلحاق بدفعة سابقة" Style="{StaticResource TabCardRadio}" FlowDirection="RightToLeft" Checked="BatchMode_Changed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="NewBatchRadioButton" Grid.Column="1" GroupName="BatchRegistrationMode" Content="دفعة جديدة" IsChecked="True" Style="{StaticResource TabCardRadio}" FlowDirection="RightToLeft" Checked="BatchMode_Changed" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="إعدادات الدفعة" Style="{StaticResource TabCardSectionTitle}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="1" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition Width="1.12*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="1.2*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PickExistingBatchButton" Grid.Column="0" Content="+" Style="{StaticResource TabCardPlusButton}" Click="PickExistingBatchButton_Click" ToolTip="اختيار دفعة سابقة وتحميل إعداداتها" Width="27" MinWidth="27" Height="27" IsEnabled="False"/>
                <Grid x:Name="ExistingBatchPanel" Grid.Column="1" IsEnabled="False">
                  <ComboBox x:Name="ExistingBatchComboBox" Style="{StaticResource TabCardComboBox}" DisplayMemberPath="BatchId" SelectionChanged="ExistingBatchComboBox_SelectionChanged"/>
                </Grid>
                <TextBlock Grid.Column="2" Text="الدفعة السابقة" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                <TextBox x:Name="CommentTextBox" Grid.Column="4" Style="{StaticResource TabCardTextBox}" FlowDirection="RightToLeft" TextAlignment="Right" TextChanged="FormTextChanged" ToolTip="ملاحظة اختيارية لهذه الدفعة"/>
                <TextBlock Grid.Column="5" Text="ملاحظة" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="5,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock x:Name="BatchRegistrationHintTextBlock" Grid.Row="2" Text="سيُنشأ رقم دفعة تلقائيًا." FontSize="9" Foreground="{StaticResource TabCardMuted}" TextWrapping="NoWrap" MaxHeight="14" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Visibility="Collapsed"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource TabCardPanel}" Padding="3,2" Margin="0,2,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="2"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Height="3" Background="#C51B2B" HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
          <UniformGrid Grid.Row="1" Columns="5" Rows="1" FlowDirection="RightToLeft" Height="31">
            <Button x:Name="PrintBatchActionButton" Style="{StaticResource TabCardActionButton}" Height="26" FontSize="11" Click="GenerateAndPrintButton_Click" Margin="1,0" MinWidth="0" Padding="4,0">
              <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                <TextBlock Text="إنشاء الدفعة والطباعة" VerticalAlignment="Center"/>
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
            </Button>
            <Button x:Name="AddBatchActionButton" Content="إنشاء الدفعة فقط" Style="{StaticResource TabCardActionButton}" Height="26" FontSize="11" Click="GenerateBatchButton_Click" Margin="1,0" MinWidth="0" Padding="4,0"/>
            <Button x:Name="OnlineSaleButton" Click="OnlineSaleButton_Click" Height="26" Content="إضافة للبيع الإلكتروني" Style="{StaticResource TabCardActionButton}" ToolTip="إعداد الدفعة للبيع عبر الإنترنت" FontSize="11" Margin="1,0" MinWidth="0" Padding="4,0"/>
            <Button x:Name="OffersButton" Content="العروض" Style="{StaticResource TabCardActionButton}" Height="26" FontSize="11" Click="OffersButton_Click" Margin="1,0" MinWidth="0" Padding="4,0"/>
            <Button x:Name="OpenPrintQueueButton" Content="معاينة الطباعة" Style="{StaticResource TabCardActionButton}" Height="26" FontSize="11" Click="OpenPrintQueueButton_Click" Margin="1,0" MinWidth="0" Padding="4,0"/>
          </UniformGrid>
          <TextBlock x:Name="IssuanceStatusTextBlock" Text="جاهز لإنشاء الدفعة." FontSize="8.5" Foreground="{StaticResource TabCardMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="11" Grid.Row="2" Margin="1,0,1,0"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
