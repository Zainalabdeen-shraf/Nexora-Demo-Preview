                        <Rectangle Width="1" Height="24" Fill="#111827" Canvas.Left="41" Canvas.Top="1"/>
                      </Canvas>
                    </Border>
                    <StackPanel Grid.Column="4" FlowDirection="RightToLeft" VerticalAlignment="Center">
                      <TextBlock x:Name="PreviewCredentialsCaptionTextBlock" Text="بيانات الدخول" FontSize="9.5" Foreground="{StaticResource TabCardMuted}" TextAlignment="Right"/>
                      <Grid Margin="0,1,0,1" FlowDirection="RightToLeft">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="رقم الكرت:" FontSize="9.5" Foreground="{StaticResource TabCardInk}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PreviewCardNumberTextBlock" Grid.Column="1" Text="••••••••" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TabCardInk}" FlowDirection="LeftToRight" TextAlignment="Right" Margin="2,0,0,0"/>
