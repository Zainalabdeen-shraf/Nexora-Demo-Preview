<UserControl x:Class="Nexora.Demo.Desktop.Features.Cards.Views.CardIssuanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nexora.Demo.Desktop.Features.Cards.Views" FlowDirection="RightToLeft" Background="#F7F8FA" SnapsToDevicePixels="True">

    <!-- NexoraIssuanceWorkspaceV1: task-first Arabic RTL issuance workspace; shared shell/navigation remain external. -->
    <UserControl.Resources>

        <SolidColorBrush x:Key="TabCardInk" Color="#20242A" />

        <SolidColorBrush x:Key="TabCardMuted" Color="#697078" />

        <SolidColorBrush x:Key="TabCardAccent" Color="#A01818" />

        <SolidColorBrush x:Key="TabCardAccentDark" Color="#7F1118" />

        <SolidColorBrush x:Key="TabCardAccentSoft" Color="#F9EDED" />

        <SolidColorBrush x:Key="TabCardLine" Color="#DEE1E6" />

        <SolidColorBrush x:Key="TabCardField" Color="#F7F8FA" />



        <Style x:Key="TabCardPanel" TargetType="Border">

            <Setter Property="Background" Value="#FFFFFF" />

            <Setter Property="BorderBrush" Value="{StaticResource TabCardLine}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="CornerRadius" Value="10" />

            <Setter Property="Padding" Value="7" />

        </Style>

        <Style x:Key="TabCardSectionTitle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="14" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="Foreground" Value="{StaticResource TabCardInk}" />

            <Setter Property="TextAlignment" Value="Right" />

            <Setter Property="VerticalAlignment" Value="Center" />

        </Style>

        <Style x:Key="TabCardLabel" TargetType="TextBlock">

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Foreground" Value="{StaticResource TabCardMuted}" />

            <Setter Property="Margin" Value="0,0,0,4" />

            <Setter Property="TextAlignment" Value="Right" />

            <Setter Property="TextWrapping" Value="Wrap" />

        </Style>

        <Style x:Key="TabCardTextBox" TargetType="TextBox">

            <Setter Property="Height" Value="33"/>

            <Setter Property="Padding" Value="8,4" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="BorderBrush" Value="#C9CDD3" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Background" Value="{StaticResource TabCardField}" />

            <Setter Property="Foreground" Value="{StaticResource TabCardInk}" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

        </Style>

        <Style x:Key="TabCardComboBox" TargetType="ComboBox">

            <Setter Property="Height" Value="33"/>

            <Setter Property="Padding" Value="6,3" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="BorderBrush" Value="#C9CDD3" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Background" Value="{StaticResource TabCardField}" />

            <Setter Property="Foreground" Value="{StaticResource TabCardInk}" />

            <Setter Property="FontSize" Value="12.5" />

            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>

        <Style x:Key="TabCardPrimaryButton" TargetType="Button">

            <Setter Property="Height" Value="35" />

            <Setter Property="Padding" Value="11,0" />

            <Setter Property="Background" Value="{StaticResource TabCardAccent}" />

            <Setter Property="BorderBrush" Value="{StaticResource TabCardAccent}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Foreground" Value="#FFFFFF" />

            <Setter Property="FontSize" Value="12.5" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Margin" Value="2" />

        </Style>

        <Style x:Key="TabCardSecondaryButton" TargetType="Button">

            <Setter Property="Height" Value="35" />

            <Setter Property="Padding" Value="10,0" />

            <Setter Property="Background" Value="{StaticResource TabCardAccentSoft}" />

            <Setter Property="BorderBrush" Value="#E2C7C9" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Foreground" Value="{StaticResource TabCardAccentDark}" />

            <Setter Property="FontSize" Value="12.5" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Margin" Value="2" />

        </Style>

        <Style x:Key="TabCardPlusButton" TargetType="Button" BasedOn="{StaticResource TabCardSecondaryButton}">

            <Setter Property="Width" Value="32" />

            <Setter Property="MinWidth" Value="32" />

            <Setter Property="Height" Value="29" />

            <Setter Property="Padding" Value="0" />

            <Setter Property="FontSize" Value="21" />

            <Setter Property="Margin" Value="0,0,5,0" />

        </Style>

        <Style x:Key="TabCardRadio" TargetType="RadioButton">

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="Foreground" Value="{StaticResource TabCardInk}" />

            <Setter Property="Margin" Value="0,2,8,2" />

            <Setter Property="VerticalAlignment" Value="Center" />

        </Style>

        <Style x:Key="TabCardCheck" TargetType="CheckBox">

            <Setter Property="FontSize" Value="11" />

            <Setter Property="Foreground" Value="{StaticResource TabCardInk}" />

            <Setter Property="Margin" Value="0,2,7,2" />

            <Setter Property="VerticalAlignment" Value="Center" />

        </Style>

        <Style TargetType="DataGrid">

            <Setter Property="Background" Value="#FFFFFF" />

            <Setter Property="BorderBrush" Value="#E9DDE4" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="GridLinesVisibility" Value="Horizontal" />

            <Setter Property="HorizontalGridLinesBrush" Value="#E8EAEE" />

            <Setter Property="VerticalGridLinesBrush" Value="#E8EAEE" />

            <Setter Property="HeadersVisibility" Value="Column" />

            <Setter Property="CanUserAddRows" Value="False" />

            <Setter Property="CanUserDeleteRows" Value="False" />

            <Setter Property="IsReadOnly" Value="True" />

            <Setter Property="RowHeight" Value="30" />

            <Setter Property="ColumnHeaderHeight" Value="34" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="EnableRowVirtualization" Value="True" />

            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />

            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

        </Style>

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#F9EDED" />

            <Setter Property="Foreground" Value="#762027" />

            <Setter Property="FontSize" Value="11.5" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="HorizontalContentAlignment" Value="Center" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="BorderBrush" Value="#E4D5D8" />

            <Setter Property="BorderThickness" Value="0,0,0,1" />

        </Style>

            <local:OneBasedAlternationIndexConverter x:Key="OneBasedAlternationIndexConverter" />

        <Style x:Key="TabCardInlineLabelRuntimeRepair" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#697078" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>

        <Style x:Key="TabCardInlineLabel" TargetType="TextBlock" BasedOn="{StaticResource TabCardLabel}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FlowDirection" Value="RightToLeft" />
        </Style>
</UserControl.Resources>


    <Grid>
    <Grid x:Name="IssuanceMainPage" Margin="3" FlowDirection="LeftToRight">
        <Grid.Resources>
            <Style x:Key="TabCardInlineLabel" TargetType="TextBlock" BasedOn="{StaticResource TabCardLabel}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="FlowDirection" Value="RightToLeft" />
            </Style>
            <Style x:Key="TabCardCompactCheck" TargetType="CheckBox" BasedOn="{StaticResource TabCardCheck}">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Margin" Value="0,1,8,1" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.82*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="2.08*" />
        </Grid.ColumnDefinitions>

        <!-- Physical left: recent operations and compact live preview. -->
        <Grid Grid.Column="0" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.08*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="0.92*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource TabCardPanel}" Padding="9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="آخر الدفعات" Style="{StaticResource TabCardSectionTitle}" FontSize="13" />
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="RecentBatchesGrid" FlowDirection="RightToLeft" AutoGenerateColumns="False" AlternationCount="1000000" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="22" ColumnHeaderHeight="25" FontSize="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="#" Width="27">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}, Path=AlternationIndex, Converter={StaticResource OneBasedAlternationIndexConverter}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الدفعة" Binding="{Binding BatchId}" Width="1.08*" />
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAtLabel}" Width="1.25*" />
                                <DataGridTextColumn Header="العدد" Binding="{Binding Quantity}" Width="42" />
                                <DataGridTextColumn Header="حالة الدفعة" Binding="{Binding LocalStatus}" Width="92" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="RecentBatchesEmptyPanel" Background="#FFFFFF" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="24" Foreground="#D0D6E3" HorizontalAlignment="Center" />
                                <TextBlock Text="لا توجد دفعات بعد" Foreground="{StaticResource TabCardMuted}" FontSize="11" Margin="0,5,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="3" Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource TabCardPanel}" Padding="7">
                <StackPanel>
                    <TextBlock Text="معاينة الكرت" Style="{StaticResource TabCardSectionTitle}" FontSize="13" Margin="0,0,0,3" />
                    <ComboBox x:Name="PreviewTemplateComboBox" Style="{StaticResource TabCardComboBox}" FlowDirection="RightToLeft" Visibility="Collapsed" Margin="0,0,0,8" SelectionChanged="PreviewTemplateComboBox_SelectionChanged">
                        <ComboBoxItem Content="info1" Tag="nexora" IsSelected="True" />
                        <ComboBoxItem Content="info2" Tag="light" />
                        <ComboBoxItem Content="info3" Tag="compact" />
                    </ComboBox>

                    <Border x:Name="CardPreviewBorder" Background="#FFFFFF" BorderBrush="#E2C7C9" BorderThickness="1" CornerRadius="11" Padding="6" Height="140" MinHeight="140" MaxHeight="140" HorizontalAlignment="Stretch" ClipToBounds="True">
                        <Grid FlowDirection="RightToLeft">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                    <TextBlock Text="◢" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TabCardAccent}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="TabCard" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TabCardAccentDark}" />
                                        <TextBlock Text="إدارة كروت الشبكة" FontSize="8.5" Foreground="{StaticResource TabCardMuted}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" FlowDirection="RightToLeft" VerticalAlignment="Center">
                                    <TextBlock Text="كرت إنترنت" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TabCardInk}" TextAlignment="Right" />
                                    <TextBlock x:Name="PreviewSourceTypeTextBlock" Text="HotSpot" FontSize="9" Foreground="{StaticResource TabCardInk}" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" Padding="2" Background="White" BorderBrush="#E2C7C9" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                                    <Viewbox Stretch="Uniform" Width="40" Height="40">
                                        <Canvas Width="96" Height="96" Background="White">
                                            <!-- Decorative sample only; it is not a scannable QR credential. -->
                                            <Border Width="31" Height="31" Background="#111827" Canvas.Left="2" Canvas.Top="2"><Border Margin="5" Background="White"><Border Margin="5" Background="#111827" /></Border></Border>
                                            <Border Width="31" Height="31" Background="#111827" Canvas.Left="63" Canvas.Top="2"><Border Margin="5" Background="White"><Border Margin="5" Background="#111827" /></Border></Border>
                                            <Border Width="31" Height="31" Background="#111827" Canvas.Left="2" Canvas.Top="63"><Border Margin="5" Background="White"><Border Margin="5" Background="#111827" /></Border></Border>
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="41" Canvas.Top="4" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="49" Canvas.Top="12" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="41" Canvas.Top="20" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="39" Canvas.Top="37" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="47" Canvas.Top="37" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="55" Canvas.Top="37" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="38" Canvas.Top="45" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="54" Canvas.Top="45" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="38" Canvas.Top="53" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="46" Canvas.Top="53" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="63" Canvas.Top="39" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="71" Canvas.Top="47" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="79" Canvas.Top="39" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="63" Canvas.Top="55" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="79" Canvas.Top="55" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="39" Canvas.Top="67" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="47" Canvas.Top="75" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="55" Canvas.Top="83" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="63" Canvas.Top="71" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="71" Canvas.Top="79" />
                                            <Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="79" Canvas.Top="87" /><Rectangle Width="6" Height="6" Fill="#111827" Canvas.Left="87" Canvas.Top="71" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Grid.Column="2" FlowDirection="RightToLeft" VerticalAlignment="Center">
                                    <TextBlock x:Name="PreviewCredentialsCaptionTextBlock" Text="بيانات الدخول" FontSize="9" Foreground="{StaticResource TabCardMuted}" TextAlignment="Right" />
                                    <Grid Margin="0,1,0,1" FlowDirection="RightToLeft">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="رقم الكرت:" FontSize="9.5" Foreground="{StaticResource TabCardInk}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PreviewCardNumberTextBlock" Grid.Column="1" Text="••••••••" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TabCardInk}" FlowDirection="LeftToRight" TextAlignment="Right" Margin="2,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="PreviewUsernameTextBlock" Text="اسم المستخدم: ••••••" FontSize="9.5" Foreground="{StaticResource TabCardInk}" Margin="0,1,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PreviewPasswordTextBlock" Text="كلمة المرور: ••••••" FontSize="9.5" Foreground="{StaticResource TabCardMuted}" Margin="0,1,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PreviewTimeTextBlock" Text="الوقت: —" FontSize="9" Foreground="{StaticResource TabCardInk}" Margin="0,1,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PreviewDataTextBlock" Text="التحميل: —" FontSize="9" Foreground="{StaticResource TabCardInk}" Margin="0,1,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PreviewSpeedTextBlock" Text="السرعة: —" FontSize="9" Foreground="{StaticResource TabCardMuted}" Margin="0,1,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4" FlowDirection="RightToLeft">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0" FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PreviewPackageTextBlock" Grid.Column="0" Text="الباقة والسعر" FontSize="8.5" Foreground="{StaticResource TabCardAccentDark}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PreviewValidityTextBlock" Grid.Column="1" Text="الصلاحية: —" FontSize="8.5" Foreground="{StaticResource TabCardMuted}" TextAlignment="Left" TextTrimming="CharacterEllipsis" Margin="5,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="PreviewProfileTextBlock" Grid.Row="1" Text="ملف الاستخدام" FontSize="8" Foreground="{StaticResource TabCardMuted}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PreviewPriceTextBlock" Visibility="Collapsed" Text="السعر: —" />
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PreviewBatchTextBlock" Text="اختر باقة لمعاينة بياناتها." FontSize="9" Foreground="{StaticResource TabCardMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" MaxHeight="16" />
                    <Expander Header="حقول تظهر في الكرت" IsExpanded="False" Margin="0,3,0,0" Foreground="{StaticResource TabCardAccentDark}">
                        <WrapPanel FlowDirection="RightToLeft" Margin="0,1,0,0">
                            <CheckBox x:Name="ShowCardNumberCheckBox" Style="{StaticResource TabCardCompactCheck}" Content="رقم الكرت" IsChecked="True" Checked="PreviewOptionChanged" Unchecked="PreviewOptionChanged" FlowDirection="RightToLeft" />
                            <CheckBox x:Name="ShowUsernameCheckBox" Style="{StaticResource TabCardCompactCheck}" Content="اسم المستخدم" IsChecked="True" Checked="PreviewOptionChanged" Unchecked="PreviewOptionChanged" FlowDirection="RightToLeft" />
                            <CheckBox x:Name="ShowPasswordCheckBox" Style="{StaticResource TabCardCompactCheck}" Content="كلمة المرور" IsChecked="True" Checked="PreviewOptionChanged" Unchecked="PreviewOptionChanged" FlowDirection="RightToLeft" />
                            <CheckBox x:Name="ShowPackageCheckBox" Style="{StaticResource TabCardCompactCheck}" Content="الباقة" IsChecked="True" Checked="PreviewOptionChanged" Unchecked="PreviewOptionChanged" FlowDirection="RightToLeft" />
                            <CheckBox x:Name="ShowPriceCheckBox" Style="{StaticResource TabCardCompactCheck}" Content="السعر" IsChecked="True" Checked="PreviewOptionChanged" Unchecked="PreviewOptionChanged" FlowDirection="RightToLeft" />
                        </WrapPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Physical right: settings and registration scroll; print actions remain pinned below. -->
        <Grid Grid.Column="2" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ClipToBounds="True">
                <StackPanel>
                <Border Style="{StaticResource TabCardPanel}" Margin="0,0,0,5" Padding="7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" FlowDirection="RightToLeft">
                            <TextBlock x:Name="IssuanceSettingsHeadingTextBlock" Text="بيانات الإصدار" Style="{StaticResource TabCardSectionTitle}" />
                            <TextBlock x:Name="IssuanceModeSubtitleTextBlock" Visibility="Collapsed" Text="حدد الباقة والكمية وبيانات الكرت." FontSize="10.5" Foreground="{StaticResource TabCardMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Visibility="Collapsed" Background="{StaticResource TabCardAccentSoft}" BorderBrush="#E2C7C9" BorderThickness="1" CornerRadius="9" Padding="10,6" VerticalAlignment="Center" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TabCardAccent}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TargetSystemBadgeTextBlock" Text="User Manager" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TabCardAccentDark}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Basic choices only: source-compatible package, quantity, output template and assignment. -->
                    <Grid Grid.Row="2" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Height="34" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <Button x:Name="AddPackageButton" Grid.Column="0" Content="+" Style="{StaticResource TabCardPlusButton}" ToolTip="إضافة باقة" Click="AddPackageButton_Click" />
                            <ComboBox x:Name="PackageComboBox" Grid.Column="1" Style="{StaticResource TabCardComboBox}" DisplayMemberPath="DisplayName" SelectionChanged="PackageComboBox_SelectionChanged" />
                            <TextBlock Grid.Column="2" Text="الباقة" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="2" Height="34" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="QuantityTextBox" Grid.Column="0" Style="{StaticResource TabCardTextBox}" Text="20" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" TextChanged="FormTextChanged" />
                            <TextBlock Grid.Column="1" Text="عدد الكروت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="0" Height="34" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+" Style="{StaticResource TabCardPlusButton}" ToolTip="إضافة قالب" Click="AddPrintTemplateButton_Click" />
