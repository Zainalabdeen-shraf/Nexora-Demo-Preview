                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="2" Height="34" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+" Style="{StaticResource TabCardPlusButton}" ToolTip="إضافة نقطة بيع" Click="AddPointOfSaleButton_Click" />
                            <ComboBox x:Name="PointOfSaleComboBox" Grid.Column="1" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged">
                                <ComboBoxItem Content="المركز الرئيسي" Tag="main" IsSelected="True" />
                                <ComboBoxItem Content="نقطة بيع الحي" Tag="neighborhood" />
                                <ComboBoxItem Content="وكيل الشبكة" Tag="agent" />
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="نقطة البيع" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="4" Grid.Column="0" Height="34" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="98" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="PasswordModeComboBox" Grid.Column="0" Style="{StaticResource TabCardComboBox}" SelectionChanged="PasswordModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="كلمة مرور فارغة" Tag="Empty" IsSelected="True" />
                                <ComboBoxItem Content="مثل اسم المستخدم" Tag="SameAsUsername" />
                                <ComboBoxItem Content="كلمة مرور مختلفة" Tag="Generated" />
                            </ComboBox>
                            <TextBlock x:Name="PasswordModeLabelTextBlock" Grid.Column="1" Text="كلمة المرور" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                        </Grid>

                        <Grid Grid.Row="4" Grid.Column="2">
                            <Border x:Name="HotSpotSourceInfoBorder" Visibility="Collapsed" Background="#F9EDED" BorderBrush="#E2C7C9" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="جهة الإصدار: هوتسبوت" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TabCardAccentDark}" />
                                    <TextBlock Text="يمكن ضبط نمط بيانات الدخول من الإعدادات المتقدمة." FontSize="9.5" Foreground="{StaticResource TabCardMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="UserManagerSourceInfoBorder" Visibility="Collapsed" Background="#F9EDED" BorderBrush="#E2C7C9" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="جهة الإصدار: يوزر منجر" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TabCardAccentDark}" />
                                    <TextBlock Text="خصائص الحساب المتقدمة منفصلة عن تعريف الباقة." FontSize="9.5" Foreground="{StaticResource TabCardMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Advanced generation details are collapsed by default and expand when a chosen mode needs them. -->
                                        <Button x:Name="AdvancedSettingsButton" Grid.Row="4" Content="الإعدادات المتقدمة  ⚙" Height="35" HorizontalAlignment="Stretch" Style="{StaticResource TabCardSecondaryButton}" FontSize="12.5" Click="AdvancedSettingsButton_Click" />

                </Grid>
            </Border>

                <Border Style="{StaticResource TabCardPanel}" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" FlowDirection="LeftToRight">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="17" Foreground="{StaticResource TabCardAccent}" VerticalAlignment="Center" DockPanel.Dock="Right" />
                            <TextBlock Text="الدفعة" Style="{StaticResource TabCardSectionTitle}" Margin="6,0,0,0" />
                        </DockPanel>
                        <Grid Grid.Row="2" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <RadioButton x:Name="AppendToPreviousBatchRadioButton" Grid.Column="0" GroupName="BatchRegistrationMode" Content="الإلحاق بدفعة سابقة" Style="{StaticResource TabCardRadio}" FlowDirection="RightToLeft" Checked="BatchMode_Changed" VerticalAlignment="Center" />
                            <RadioButton x:Name="NewBatchRadioButton" Grid.Column="2" GroupName="BatchRegistrationMode" Content="تسجيل دفعة جديدة" IsChecked="True" Style="{StaticResource TabCardRadio}" FlowDirection="RightToLeft" Checked="BatchMode_Changed" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="4" FlowDirection="LeftToRight">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" /><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PickExistingBatchButton" Grid.Column="0" Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource TabCardPlusButton}" Click="PickExistingBatchButton_Click" ToolTip="اختيار دفعة سابقة" />
                            <Grid x:Name="ExistingBatchPanel" Grid.Column="1" IsEnabled="False">
                                <ComboBox x:Name="ExistingBatchComboBox" Style="{StaticResource TabCardComboBox}" DisplayMemberPath="BatchId" SelectionChanged="ExistingBatchComboBox_SelectionChanged" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="رقم الدفعة السابقة" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="7,0,0,0" />
                            <TextBox x:Name="CommentTextBox" Grid.Column="4" Style="{StaticResource TabCardTextBox}" FlowDirection="RightToLeft" TextAlignment="Right" TextChanged="FormTextChanged" ToolTip="ملاحظة اختيارية لهذه الدفعة" />
                            <TextBlock Grid.Column="5" Text="ملاحظة" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="7,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="BatchRegistrationHintTextBlock" Grid.Row="6" Text="سيُنشأ رقم دفعة تلقائيًا." FontSize="9" Foreground="{StaticResource TabCardMuted}" TextWrapping="NoWrap" MaxHeight="18" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </StackPanel>
            </Grid>

            <!-- Action panel is pinned; the main workspace does not scroll. -->
            <Border Grid.Row="2" Style="{StaticResource TabCardPanel}" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="4" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="4" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="6" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" FlowDirection="LeftToRight">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" Foreground="{StaticResource TabCardAccent}" VerticalAlignment="Center" DockPanel.Dock="Right" />
                        <TextBlock Text="تنفيذ الدفعة" Style="{StaticResource TabCardSectionTitle}" Margin="8,0,0,0" />
                    </DockPanel>
                    <WrapPanel Grid.Row="2" FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
                        <Button x:Name="PrintOptionsButton" Content="إعدادات الطباعة" Style="{StaticResource TabCardSecondaryButton}" Height="35" FontSize="12.5" Click="PrintOptionsButton_Click" />
                        <Button x:Name="OffersButton" Content="العروض" Style="{StaticResource TabCardSecondaryButton}" Height="35" FontSize="12.5" Click="OffersButton_Click" />
                        <Button x:Name="OpenGeneratedCardsButton" Content="الكروت والدفعات" Style="{StaticResource TabCardSecondaryButton}" Height="35" FontSize="12.5" Click="OpenGeneratedCardsButton_Click" />
                        <Button x:Name="OpenPrintQueueButton" Content="قائمة الطباعة" Style="{StaticResource TabCardSecondaryButton}" Height="35" FontSize="12.5" Click="OpenPrintQueueButton_Click" />
                    </WrapPanel>
                    <Grid Grid.Row="4" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0" /><ColumnDefinition Width="1.13*" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
                        <RadioButton x:Name="FastFilePrintModeRadioButton" Grid.Column="0" GroupName="PrintMode" Content="طباعة ملف سريع لأكثر من ٥٬٠٠٠ كرت" IsEnabled="False" Visibility="Collapsed" FontSize="9.5" Foreground="{StaticResource TabCardMuted}" FlowDirection="RightToLeft" VerticalAlignment="Center" />
                        <RadioButton x:Name="SequentialPrintModeRadioButton" Grid.Column="1" GroupName="PrintMode" Content="طباعة بالتتابع" Style="{StaticResource TabCardRadio}" Checked="PrintMode_Changed" FlowDirection="RightToLeft" VerticalAlignment="Center" />
                        <RadioButton x:Name="DefaultPrintModeRadioButton" Grid.Column="2" GroupName="PrintMode" Content="طباعة انفرادية" IsChecked="True" Style="{StaticResource TabCardRadio}" Checked="PrintMode_Changed" FlowDirection="RightToLeft" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="6" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                        <Button x:Name="AddBatchActionButton" Grid.Column="0" Content="إنشاء الدفعة" Style="{StaticResource TabCardSecondaryButton}" Height="35" FontSize="12.5" Click="GenerateBatchButton_Click" />
                        <Button x:Name="PrintBatchActionButton" Grid.Column="2" Style="{StaticResource TabCardPrimaryButton}" Height="35" FontSize="12.5" Click="GenerateAndPrintButton_Click">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Center">
                                <TextBlock Text="إنشاء وتجهيز الطباعة" VerticalAlignment="Center" />
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="IssuanceStatusTextBlock" Grid.Row="8" Text="جاهز لإنشاء الدفعة." FontSize="9.5" Foreground="{StaticResource TabCardMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="16" />
                </Grid>
            </Border>
        </Grid>

        <!-- Retained legacy commands and single-card mode for code compatibility; not shown in this streamlined layout. -->
        <StackPanel Visibility="Collapsed" Width="0" Height="0">
            <TextBlock Text="" />
            <RadioButton x:Name="SingleCardModeRadioButton" GroupName="PrintMode" Content="كرت واحد" Checked="PrintMode_Changed" FlowDirection="RightToLeft" />
            <Button x:Name="GenerateLocalButton" Click="GenerateBatchButton_Click" />
            <Button x:Name="UploadRouterButton" Click="UploadRouterButton_Click" />
            <Button x:Name="UploadAndPrintButton" Click="GenerateAndPrintButton_Click" />
            <Button x:Name="OnlineSaleButton" Click="OnlineSaleButton_Click" />




        </StackPanel>
    </Grid>
    <Grid x:Name="AdvancedSettingsPage" Visibility="Collapsed" Margin="3" Background="#F7F8FA" FlowDirection="RightToLeft">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryDarkBrush}" BorderThickness="1" CornerRadius="9" Padding="13,10" Margin="0,0,0,8">
            <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="العودة إلى الإصدار" Style="{StaticResource TabCardSecondaryButton}" Height="36" Background="White" BorderBrush="White" Foreground="{StaticResource PrimaryDarkBrush}" Padding="14,0" Click="AdvancedSettingsBackButton_Click" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" FlowDirection="RightToLeft" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="الإعدادات المتقدمة" FontSize="18" FontWeight="Bold" Foreground="White" TextAlignment="Right"/><TextBlock Text="تخصيص أرقام الكروت وبيانات الدخول" FontSize="11.5" Foreground="#FFF2F2" Margin="0,3,0,0" TextAlignment="Right"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource TabCardLine}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0">
                            <Grid FlowDirection="LeftToRight">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="7" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="7" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="7" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="7" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Height="34" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="98" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CardNumberLengthTextBox" Grid.Column="0" Style="{StaticResource TabCardTextBox}" Text="8" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" TextChanged="FormTextChanged" ToolTip="طول رقم الكرت أو اسم المستخدم وفق جهة الإصدار" />
                                    <ComboBox x:Name="CardNumberCharacterSetComboBox" Grid.Column="1" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged">
                                        <ComboBoxItem Content="أرقام فقط" Tag="NumericOnly" IsSelected="True" />
                                        <ComboBoxItem Content="حروف وأرقام" Tag="AlphaNumeric" />
                                        <ComboBoxItem Content="حروف فقط" Tag="LettersOnly" />
                                    </ComboBox>
                                    <TextBlock x:Name="CardNumberPatternLabelTextBlock" Grid.Column="2" Text="طول رقم الكرت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                                </Grid>

                                <Grid Grid.Row="0" Grid.Column="2" Height="34" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CardPrefixTextBox" Grid.Column="0" Style="{StaticResource TabCardTextBox}" FlowDirection="LeftToRight" TextChanged="FormTextChanged" ToolTip="بادئة تضاف قبل رقم الكرت" />
                                    <TextBlock Grid.Column="1" Text="بادئة الكرت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                                </Grid>

                                <Border x:Name="UsernameSettingsPanel" Grid.Row="2" Grid.Column="0" Background="#FFF9EDED" BorderBrush="#FFE2C7C9" BorderThickness="1" CornerRadius="7" Padding="3" Visibility="Collapsed">
                                    <Grid Height="34" FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="UsernameLengthTextBox" Grid.Column="0" Style="{StaticResource TabCardTextBox}" Height="31" Text="6" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" TextChanged="FormTextChanged" ToolTip="طول اسم المستخدم في HotSpot" />
                                        <ComboBox x:Name="UsernameCharacterSetComboBox" Grid.Column="1" Style="{StaticResource TabCardComboBox}" Height="31" SelectionChanged="FormSelectionChanged">
                                            <ComboBoxItem Content="أرقام فقط" Tag="NumericOnly" IsSelected="True" />
                                            <ComboBoxItem Content="حروف وأرقام" Tag="AlphaNumeric" />
                                            <ComboBoxItem Content="حروف فقط" Tag="LettersOnly" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="اسم المستخدم" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="5,0,0,0" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" Grid.Column="2" Height="34" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="CardSuffixTextBox" Grid.Column="0" Style="{StaticResource TabCardTextBox}" FlowDirection="LeftToRight" TextChanged="FormTextChanged" ToolTip="لاحقة تضاف بعد رقم الكرت" />
                                    <TextBlock Grid.Column="1" Text="لاحقة الكرت" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                                </Grid>

                                <StackPanel x:Name="PasswordGenerationPanel" Grid.Row="4" Grid.Column="0" Visibility="Collapsed">
                                    <Grid Height="34" FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="*" /><ColumnDefinition Width="98" /></Grid.ColumnDefinitions>
                                        <TextBox x:Name="PasswordLengthTextBox" Grid.Column="0" Style="{StaticResource TabCardTextBox}" Text="4" FlowDirection="LeftToRight" HorizontalContentAlignment="Center" TextChanged="FormTextChanged" />
                                        <ComboBox x:Name="PasswordCharacterSetComboBox" Grid.Column="1" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged">
                                            <ComboBoxItem Content="أرقام فقط" Tag="NumericOnly" IsSelected="True" />
                                            <ComboBoxItem Content="حروف وأرقام" Tag="AlphaNumeric" />
                                            <ComboBoxItem Content="حروف فقط" Tag="LettersOnly" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="نمط كلمة المرور" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="5,0,0,0" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <Grid Height="34" FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="SharedUsersComboBox" Grid.Column="0" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged" ToolTip="{Binding Text, ElementName=SharedUsersHelpTextBlock}">
                                            <ComboBoxItem Content="جهاز واحد" Tag="1" IsSelected="True" />
                                            <ComboBoxItem Content="جهازان" Tag="2" />
                                            <ComboBoxItem Content="3 أجهزة" Tag="3" />
                                            <ComboBoxItem Content="5 أجهزة" Tag="5" />
                                            <ComboBoxItem Content="10 أجهزة" Tag="10" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="1" Text="عدد المتزامنين" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="SharedUsersHelpTextBlock" FontSize="9.5" Foreground="{StaticResource TabCardMuted}" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed" />
                                </StackPanel>

                                <Grid Grid.Row="6" Grid.Column="0" Height="34" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="RouterProfileTextBox" Grid.Column="0" Style="{StaticResource TabCardTextBox}" FlowDirection="LeftToRight" TextChanged="FormTextChanged" ToolTip="ملف الاستخدام أو Profile المرتبط بالباقة والمصدر" />
                                    <TextBlock Grid.Column="1" Text="ملف الاستخدام" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                                </Grid>

                                <StackPanel x:Name="ManagerUserPanel" Grid.Row="6" Grid.Column="2" Visibility="Collapsed">
                                    <Grid Height="34" FlowDirection="LeftToRight">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ManagerUserComboBox" Grid.Column="0" Style="{StaticResource TabCardComboBox}" SelectionChanged="FormSelectionChanged">
                                            <ComboBoxItem Content="admin" Tag="admin" IsSelected="True" />
                                            <ComboBoxItem Content="مشغل الشبكة" Tag="network-operator" />
                                            <ComboBoxItem Content="مسؤول نقطة البيع" Tag="pos-operator" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="1" Text="مستخدم يوزر" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="6,0,0,0" />
                                    </Grid>
                                </StackPanel>

                                <Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <WrapPanel Grid.Column="1" FlowDirection="RightToLeft" VerticalAlignment="Center">
                                        <RadioButton x:Name="RandomGenerationRadioButton" GroupName="CardNumberGeneration" Content="عشوائي" IsChecked="True" Style="{StaticResource TabCardRadio}" Checked="GenerationMode_Changed" FlowDirection="RightToLeft" />
                                        <RadioButton x:Name="SequentialGenerationRadioButton" GroupName="CardNumberGeneration" Content="بالتتابع" Style="{StaticResource TabCardRadio}" Checked="GenerationMode_Changed" FlowDirection="RightToLeft" />
                                    </WrapPanel>
                                    <TextBlock Grid.Column="2" Text="طريقة التوليد" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" />
                                    <StackPanel x:Name="SequenceStartPanel" Grid.Column="0" Orientation="Horizontal" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="بداية التسلسل" Style="{StaticResource TabCardInlineLabelRuntimeRepair}" Margin="0,0,6,0" />
                                        <TextBox x:Name="SequenceStartTextBox" Width="70" Height="31" Style="{StaticResource TabCardTextBox}" Text="1" FlowDirection="LeftToRight" TextChanged="FormTextChanged" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
    </Grid>

</Grid>
</UserControl>
