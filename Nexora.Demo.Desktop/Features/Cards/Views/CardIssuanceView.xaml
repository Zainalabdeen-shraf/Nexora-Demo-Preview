<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Nexora.Demo.Desktop.Features.Cards.Views" x:Class="Nexora.Demo.Desktop.Features.Cards.Views.CardIssuanceView" FlowDirection="RightToLeft" Background="#F7F8FA" SnapsToDevicePixels="True">
  <!-- NexoraIssuanceWorkspaceV1: task-first Arabic RTL issuance workspace; shared shell/navigation remain external. -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="TabCardInk" Color="#20242A"/>
    <SolidColorBrush x:Key="TabCardMuted" Color="#697078"/>
    <SolidColorBrush x:Key="TabCardAccent" Color="#A01818"/>
    <SolidColorBrush x:Key="TabCardAccentDark" Color="#7F1118"/>
    <SolidColorBrush x:Key="TabCardAccentSoft" Color="#F9EDED"/>
    <SolidColorBrush x:Key="TabCardLine" Color="#DEE1E6"/>
    <SolidColorBrush x:Key="TabCardField" Color="#F7F8FA"/>
    <Style x:Key="TabCardPanel" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="{StaticResource TabCardLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="7"/>
    </Style>
    <Style x:Key="TabCardSectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TabCardInk}"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TabCardLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TabCardMuted}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TabCardTextBox" TargetType="TextBox">
      <Setter Property="Height" Value="27"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#C9CDD3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{StaticResource TabCardField}"/>
      <Setter Property="Foreground" Value="{StaticResource TabCardInk}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="TabCardComboBox" TargetType="ComboBox">
      <Setter Property="Height" Value="27"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#C9CDD3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{StaticResource TabCardField}"/>
      <Setter Property="Foreground" Value="{StaticResource TabCardInk}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FlowDirection" Value="RightToLeft"/>
    </Style>
    <Style x:Key="TabCardPrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="35"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Background" Value="{StaticResource TabCardAccent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TabCardAccent}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
    <Style x:Key="TabCardSecondaryButton" TargetType="Button">
      <Setter Property="Height" Value="35"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Background" Value="{StaticResource TabCardAccentSoft}"/>
      <Setter Property="BorderBrush" Value="#E2C7C9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TabCardAccentDark}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="2"/>
    </Style>
    <Style x:Key="TabCardActionButton" TargetType="Button" BasedOn="{StaticResource TabCardSecondaryButton}">
      <Setter Property="Height" Value="27"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="Background" Value="#F7F8FA"/>
      <Setter Property="BorderBrush" Value="#CDD3DA"/>
      <Setter Property="Foreground" Value="#20242A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="1,0"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F9EDED"/>
          <Setter Property="BorderBrush" Value="#D8A5AA"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#C51B2B"/>
          <Setter Property="BorderBrush" Value="#C51B2B"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TabCardPlusButton" TargetType="Button" BasedOn="{StaticResource TabCardSecondaryButton}">
      <Setter Property="Width" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Background" Value="#C51B2B"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C51B2B"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="TabCardRadio" TargetType="RadioButton">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource TabCardInk}"/>
      <Setter Property="Margin" Value="0,2,8,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
<Style TargetType="DataGrid">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#E9DDE4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#E8EAEE"/>
      <Setter Property="VerticalGridLinesBrush" Value="#E8EAEE"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="RowHeight" Value="30"/>
      <Setter Property="ColumnHeaderHeight" Value="34"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="EnableRowVirtualization" Value="True"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#F9EDED"/>
      <Setter Property="Foreground" Value="#762027"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#E4D5D8"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="TabCardRecentBatchCellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <local:OneBasedAlternationIndexConverter x:Key="OneBasedAlternationIndexConverter"/>
    <Style x:Key="TabCardInlineLabelRuntimeRepair" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#697078"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="FlowDirection" Value="RightToLeft"/>
    </Style>
  </UserControl.Resources>
