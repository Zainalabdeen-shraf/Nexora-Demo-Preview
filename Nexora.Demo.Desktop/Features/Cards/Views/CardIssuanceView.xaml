                <TextBlock TextAlignment="Right" Grid.Row="0" Grid.Column="1" Text="{Binding Text, ElementName=QuantityTextBox}" TextWrapping="Wrap" MaxHeight="26" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TabCardInk}" Margin="1,2,3,2" VerticalAlignment="Center" ToolTip="عدد الكروت"/>
                <TextBlock TextAlignment="Right" Grid.Row="1" Grid.Column="0" Text="الباقة" FontSize="10" Foreground="{StaticResource TabCardMuted}" Margin="1,1,3,1" VerticalAlignment="Center" Grid.ColumnSpan="1"/>
                <TextBlock TextAlignment="Right" Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.DisplayName, ElementName=PackageComboBox}" TextWrapping="Wrap" MaxHeight="26" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TabCardInk}" Margin="1,2,3,2" VerticalAlignment="Center" ToolTip="الباقة"/>
                <TextBlock TextAlignment="Right" Grid.Row="2" Grid.Column="0" Text="نقطة البيع" FontSize="10" Foreground="{StaticResource TabCardMuted}" Margin="1,1,3,1" VerticalAlignment="Center" Grid.ColumnSpan="1"/>
                <TextBlock TextAlignment="Right" Grid.Row="2" Grid.Column="1" Text="{Binding Text, ElementName=PointOfSaleComboBox}" TextWrapping="Wrap" MaxHeight="26" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TabCardInk}" Margin="1,2,3,2" VerticalAlignment="Center" ToolTip="نقطة البيع"/>
                <TextBlock TextAlignment="Right" Grid.Row="3" Grid.Column="0" Text="قالب الكرت" FontSize="10" Foreground="{StaticResource TabCardMuted}" Margin="1,1,3,1" VerticalAlignment="Center" Grid.ColumnSpan="1"/>
