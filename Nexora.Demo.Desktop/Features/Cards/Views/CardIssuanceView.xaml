                </Grid>
              </Border>
              <TextBlock x:Name="PreviewBatchTextBlock" Text="اختر باقة لمعاينة بياناتها." FontSize="9.5" Foreground="{StaticResource TabCardMuted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxHeight="18"/>
</StackPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource TabCardPanel}" Padding="5" Margin="0,0,0,0" Grid.Row="2" Grid.Column="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="2"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Height="3" Background="#C51B2B" HorizontalAlignment="Stretch" IsHitTestVisible="False"/>
            <Grid Grid.Row="1">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#FCEBED" CornerRadius="6" Padding="7,4">
                <TextBlock Text="بيانات الدفعة الحالية" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TabCardInk}" HorizontalAlignment="Right"/>
