<UserControl x:Class="Nexora.Demo.Desktop.Features.Cards.Views.ImportCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource AppBgBrush}">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12"
                Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="استيراد الكروت"
                           FontSize="17"
                           FontWeight="Bold"/>
                <TextBlock Text="استيراد أرقام جاهزة من ملف وإضافتها إلى سجل الكروت والدفعات."
                           FontSize="11.5"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="TargetSystemTextBlock"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم الدفعة"
                           VerticalAlignment="Center" Margin="0,4,8,8"/>
                <TextBox x:Name="BatchIdTextBox" Grid.Row="0" Grid.Column="1"
                         Margin="0,0,12,8" Padding="7"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="الباقة"
                           VerticalAlignment="Center" Margin="0,4,8,8"/>
                <ComboBox x:Name="PackageComboBox" Grid.Row="0" Grid.Column="3"
                          DisplayMemberPath="DisplayName"
                          MinHeight="30" Margin="0,0,0,8"
                          SelectionChanged="PackageComboBox_SelectionChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="الملف"
                           VerticalAlignment="Center" Margin="0,4,8,8"/>
                <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                           LastChildFill="True" Margin="0,0,0,8">
                    <Button Content="اختيار ملف"
                            DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,0,0"
                            Padding="12,5"
                            Click="BrowseFileButton_Click"/>
                    <TextBox x:Name="FilePathTextBox"
                             IsReadOnly="True"
                             Padding="7"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="الملف الشخصي"
                           VerticalAlignment="Center" Margin="0,4,8,8"/>
                <TextBox x:Name="RouterProfileTextBox" Grid.Row="2" Grid.Column="1"
                         Margin="0,0,12,8" Padding="7"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="نقطة البيع"
                           VerticalAlignment="Center" Margin="0,4,8,8"/>
                <TextBox x:Name="PointOfSaleTextBox" Grid.Row="2" Grid.Column="3"
                         Margin="0,0,0,8" Padding="7"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="حساب المدير"
                           VerticalAlignment="Center" Margin="0,4,8,0"/>
                <TextBox x:Name="ManagerAccountTextBox" Grid.Row="3" Grid.Column="1"
                         Margin="0,0,12,0" Padding="7" Text="admin"/>

                <TextBlock Grid.Row="3" Grid.Column="2" Text="عدد المستخدمين"
                           VerticalAlignment="Center" Margin="0,4,8,0"/>
                <TextBox x:Name="SharedUsersTextBox" Grid.Row="3" Grid.Column="3"
                         Padding="7" Text="1"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock x:Name="PreviewCountTextBlock"
                           Text="لا توجد أرقام للمعاينة"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="معاينة الملف"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,6,0"
                            Padding="12,5"
                            Click="PreviewFileButton_Click"/>
                    <Button Content="اعتماد الاستيراد"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,5"
                            Click="ImportButton_Click"/>
                </StackPanel>
            </DockPanel>

            <DataGrid x:Name="PreviewGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      FlowDirection="RightToLeft"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="السطر"
                                        Binding="{Binding RowNumber}"
                                        Width="80"/>
                    <DataGridTextColumn Header="رقم الكرت المستورد"
                                        Binding="{Binding CardNumber}"
                                        Width="*"
                                        MinWidth="180"/>
                    <DataGridTextColumn Header="التحقق"
                                        Binding="{Binding ValidationStatus}"
                                        Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="3"
                   FontSize="11.5"
                   Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap"
                   Margin="0,7,0,0"/>
    </Grid>
</UserControl>