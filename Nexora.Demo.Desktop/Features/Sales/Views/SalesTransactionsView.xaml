<UserControl x:Class="Nexora.Demo.Desktop.Features.Sales.Views.SalesTransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}">
    <Grid Margin="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="معاملات البيع" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="مراجعة تفاصيل المبيعات حسب الفترة ونقطة البيع وطريقة الدفع." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Left" Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="10,7" VerticalAlignment="Center"><TextBlock Text="سجل المبيعات" Foreground="{StaticResource PrimaryBrush}" FontSize="10.5" FontWeight="SemiBold"/></Border>
        </DockPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,9">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" Height="36" VerticalContentAlignment="Center" Padding="10,4" ToolTip="ابحث برقم العملية أو الباقة أو نقطة البيع أو الموظف" TextChanged="Filter_Changed"/>
                <ComboBox x:Name="PeriodComboBox" Grid.Column="2" Height="36" SelectedIndex="0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="كل الفترات" Tag="all"/><ComboBoxItem Content="آخر 7 أيام" Tag="week"/><ComboBoxItem Content="آخر يوم مسجل" Tag="last-day"/></ComboBox>
                <Button Grid.Column="4" Content="تحديث" Style="{StaticResource SecondaryButton}" Height="36" Padding="13,0" Click="RefreshButton_Click"/>
                <Button Grid.Column="6" Content="تصدير CSV" Style="{StaticResource PrimaryButton}" Height="36" Padding="13,0" Click="ExportButton_Click"/>
            </Grid>
        </Border>
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,9">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,6,0"><StackPanel><TextBlock Text="قيمة المبيعات المطابقة" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalSalesTextBlock" Text="—" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="3,0"><StackPanel><TextBlock Text="عدد المعاملات" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TransactionCountTextBlock" Text="—" FontSize="21" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="6,0,0,0"><StackPanel><TextBlock Text="الكروت ضمن المعاملات" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CardsCountTextBlock" Text="—" FontSize="21" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="8">
            <Grid><DataGrid x:Name="TransactionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeight="37" ColumnHeaderHeight="40" FontSize="11.5" MouseDoubleClick="TransactionsGrid_MouseDoubleClick" Sorting="TransactionsGrid_Sorting" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم العملية" Binding="{Binding TransactionNumber}" SortMemberPath="TransactionNumber" Width="145"/>
                    <DataGridTextColumn Header="تاريخ البيع" Binding="{Binding OccurredAtLabel}" SortMemberPath="OccurredAt" Width="140"/>
                    <DataGridTextColumn Header="الباقة" Binding="{Binding PackageName}" SortMemberPath="PackageName" Width="130"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" SortMemberPath="Quantity" Width="75"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPriceLabel}" SortMemberPath="UnitPrice" Width="105"/>
                    <DataGridTextColumn Header="الإجمالي المسجل" Binding="{Binding TotalLabel}" SortMemberPath="Total" Width="120"/>
                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" SortMemberPath="PaymentMethod" Width="125"/>
                    <DataGridTextColumn Header="نقطة البيع" Binding="{Binding PointOfSale}" SortMemberPath="PointOfSale" Width="135"/>
                    <DataGridTextColumn Header="الموظف" Binding="{Binding OperatorName}" SortMemberPath="OperatorName" Width="125"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" SortMemberPath="Status" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="EmptyStatePanel" Background="#F8F9FB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430"><TextBlock x:Name="EmptyStateTitleTextBlock" Text="لا توجد معاملات مطابقة" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyStateDescriptionTextBlock" Text="غيّر الفترة أو عبارة البحث." FontSize="12" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
            </Grid>
        </Border>
        <DockPanel Grid.Row="4" Margin="0,8,0,0"><TextBlock x:Name="ResultSummaryTextBlock" Text="—" FontSize="10.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock x:Name="SelectedTransactionTextBlock" DockPanel.Dock="Left" Text="انقر مرتين على معاملة لعرض تفاصيلها." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/></DockPanel>
    </Grid>
</UserControl>