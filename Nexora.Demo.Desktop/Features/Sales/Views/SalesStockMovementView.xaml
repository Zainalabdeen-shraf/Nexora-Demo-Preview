<UserControl x:Class="Nexora.Demo.Desktop.Features.Sales.Views.SalesStockMovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}" FontFamily="Tahoma">
    <Grid Margin="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="حركة الكروت وتوريد نقاط البيع" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="اختيار دفعة موجودة، احتساب عمولة نقطة البيع، وإصدار مطالبة مالية فورية أو آجلة مع تكلفة التجهيز." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="＋ تسجيل مصروف" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,8,0" Click="ExpenseButton_Click" />
                <Button Content="تحديث الدفعات" Style="{StaticResource SecondaryButton}" Height="38" Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFF6E8" BorderBrush="#EBD09D" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,0,0,11">
            <TextBlock x:Name="StockNoticeTextBlock" Text="التوزيع هنا يُسجّل حركة الكمية والفاتورة المالية على مستوى رقم الدفعة. لا ينقل بيانات كل كرت داخل وحدة الكروت ولا يبدأ الطباعة تلقائيًا؛ يجب أن تكون الدفعة جاهزة فعليًا قبل تسليمها للمنفذ." FontSize="10.5" Foreground="#845900" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="11" Padding="17">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="تسجيل توريد / فاتورة نقطة بيع" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="دفعة الكروت" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="BatchComboBox" Height="41" DisplayMemberPath="DisplayLabel" SelectionChanged="Inputs_Changed" />
                        <Grid Margin="0,10,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="نقطة البيع / البقالة" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PointComboBox" Height="39" DisplayMemberPath="Name" SelectionChanged="Inputs_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="الكمية المسلّمة" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="QuantityTextBox" Text="1" Height="39" FlowDirection="LeftToRight" VerticalContentAlignment="Center" TextChanged="Inputs_TextChanged" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="المبلغ المدفوع الآن (ريال)" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PaidTextBox" Text="0" Height="39" FlowDirection="LeftToRight" VerticalContentAlignment="Center" TextChanged="Inputs_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="تكلفة الطباعة والخدش للكرت" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="PrintingCostPerCardTextBox" Text="0" Height="39" FlowDirection="LeftToRight" VerticalContentAlignment="Center" TextChanged="Inputs_TextChanged" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="ملاحظات الفاتورة (اختياري)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NotesTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8" />
                        <Border Background="#F7F8FB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,13,0,0">
                            <StackPanel>
                                <TextBlock Text="شروط الحساب من ملف النقطة" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="PointTermsTextBlock" Text="اختر نقطة البيع لعرض العمولة وسياسة الآجل." FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="SaveTransferButton" Content="اعتماد التوريد وإنشاء المطالبة" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,14,0,0" Click="SaveTransferButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Column="2">
                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,5,0">
                        <StackPanel><TextBlock Text="الكميات المتاحة في الدفعة" FontSize="9.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/><TextBlock x:Name="AvailableQuantityTextBlock" Text="—" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="3,0">
                        <StackPanel><TextBlock Text="عمولة المنفذ" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CommissionTextBlock" Text="0 ريال" FontSize="21" FontWeight="Bold" Foreground="#A75A00" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="5,0,0,0">
                        <StackPanel><TextBlock Text="صافي المستحق للشبكة" FontSize="9.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="NetAmountTextBlock" Text="0 ريال" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>
                <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,9">
                            <TextBlock Text="آخر عمليات التوريد" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="TransferResultsTextBlock" DockPanel.Dock="Left" Text="سجل محلي" FontSize="9.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TransferSearchTextBox" Grid.Column="0" Height="34" Padding="9,3" ToolTip="ابحث بالمرجع أو البقالة أو رقم الدفعة" TextChanged="TransferSearchTextBox_TextChanged" />
                            <ComboBox x:Name="TransferStatusFilterComboBox" Grid.Column="2" Height="34" SelectedIndex="0" SelectedValuePath="Tag" SelectionChanged="TransferStatusFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="كل الفواتير" Tag="all"/><ComboBoxItem Content="رصيد مفتوح" Tag="open"/><ComboBoxItem Content="مسددة" Tag="settled"/>
                            </ComboBox>
                        </Grid>
                        <DataGrid Grid.Row="2" x:Name="TransfersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="38" ColumnHeaderHeight="35" FontSize="10.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="112" />
                                <DataGridTextColumn Header="نقطة البيع" Binding="{Binding PointName}" Width="1.2*" />
                                <DataGridTextColumn Header="الدفعة" Binding="{Binding BatchId}" Width="1.15*" />
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="62" />
                                <DataGridTextColumn Header="الصافي" Binding="{Binding NetAmountLabel}" Width="105" />
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding BalanceLabel}" Width="105" />
                                <DataGridTemplateColumn Header="الحالة" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="TransferStatusBadge" Background="#FFF3E5" CornerRadius="10" Padding="7,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="TransferStatusText" Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#9A4D00"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding StatusLabel}" Value="مسدد">
                                                    <Setter TargetName="TransferStatusBadge" Property="Background" Value="#EAF7F0"/>
                                                    <Setter TargetName="TransferStatusText" Property="Foreground" Value="#236E4A"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="EmptyTransfersPanel" Grid.Row="2" Background="#F8F9FB" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="لا توجد فواتير توريد مطابقة" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="غيّر البحث أو الفلتر، أو سجّل أول توريد للبقالة." FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border Background="#F0F7F4" BorderBrush="#B9D9CE" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="نموذج المحاسبة" FontSize="12" FontWeight="Bold" Foreground="#24644E" />
                        <TextBlock Text="قيمة الدفعة − عمولة نقطة البيع = صافي مستحق الشبكة. ما يدفعه المنفذ الآن يخصم من المستحق، وأي رصيد باقٍ يظهر في حسابات نقاط البيع ويُغلق بتسوية موثقة." TextWrapping="Wrap" FontSize="10.5" Foreground="#315F53" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
