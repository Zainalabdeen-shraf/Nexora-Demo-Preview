<Window x:Class="Nexora.Demo.Desktop.Features.Sales.Views.SalesPointEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة نقطة البيع" Width="720" Height="790" MinWidth="660" MinHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}" FontFamily="Tahoma">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="EditorTitleTextBlock" Text="إضافة نقطة بيع" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="أدخل البيانات التعريفية. يمكن استكمال بيانات التواصل لاحقًا دون تعطيل حفظ النقطة." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="البيانات الأساسية" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,0,13">
                            <TextBlock Text="اسم نقطة البيع *" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="NameTextBox" MaxLength="100" Height="39" ToolTip="اسم واضح ومميز لنقطة البيع" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,13">
                            <TextBlock Text="رمز النقطة" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="CodeTextBox" Height="39" IsReadOnly="True" Background="#F3F5F8" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,13">
                            <TextBlock Text="نوع النقطة *" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="PointTypeComboBox" Height="39" SelectedIndex="1" SelectedValuePath="Tag">
                                <ComboBoxItem Content="فرع رئيسي" Tag="فرع رئيسي" />
                                <ComboBoxItem Content="بقالة" Tag="بقالة" />
                                <ComboBoxItem Content="وكيل" Tag="وكيل" />
                                <ComboBoxItem Content="فرع" Tag="فرع" />
                                <ComboBoxItem Content="منفذ بيع" Tag="منفذ بيع" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,13">
                            <TextBlock Text="المسؤول عن النقطة" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="ContactNameTextBox" MaxLength="100" Height="39" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,13">
                            <TextBlock Text="رقم التواصل" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="PhoneTextBox" MaxLength="32" Height="39" FlowDirection="LeftToRight" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,13">
                            <TextBlock Text="الموقع أو العنوان" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="LocationTextBox" MaxLength="160" Height="39" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,13">
                            <TextBlock Text="عمولة نقطة البيع (%)" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="CommissionPercentTextBox" Text="0" Height="39" FlowDirection="LeftToRight" VerticalContentAlignment="Center" ToolTip="تُحفظ النسبة داخل الفاتورة عند كل تسليم، فلا تتغير الحركات السابقة عند تعديلها لاحقًا." />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,13">
                            <TextBlock Text="دورية الحساب المعتادة" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="SettlementCycleComboBox" Height="39" SelectedIndex="0" SelectedValuePath="Tag">
                                <ComboBoxItem Content="فوري" Tag="فوري" />
                                <ComboBoxItem Content="يومي" Tag="يومي" />
                                <ComboBoxItem Content="أسبوعي" Tag="أسبوعي" />
                                <ComboBoxItem Content="حسب الاتفاق" Tag="حسب الاتفاق" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="AllowCreditCheckBox" Content="السماح بالتوريد الآجل أو الدفع الجزئي لهذه النقطة" Margin="0,1,0,14" FontSize="11.5" />
                    <TextBlock Text="ملاحظات إدارية" FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,6" />
                    <TextBox x:Name="NotesTextBox" MinHeight="96" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" Height="100" />
                    <TextBlock Text="تُحفظ بيانات النقطة وشروط الحساب محليًا. تُثبّت نسبة العمولة وقت تسليم كل دفعة حتى تبقى الفواتير التاريخية دقيقة." Foreground="{StaticResource MutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,13,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="105" Height="40" Click="CancelButton_Click" />
            <Button Content="حفظ البيانات" Style="{StaticResource PrimaryButton}" Width="145" Height="40" Margin="0,0,9,0" Click="SaveButton_Click" />
        </DockPanel>
    </Grid>
</Window>
