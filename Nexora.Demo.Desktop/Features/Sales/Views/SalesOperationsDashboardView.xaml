<UserControl x:Class="Nexora.Demo.Desktop.Features.Sales.Views.SalesOperationsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}" FontFamily="Segoe UI">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- عنوان الشاشة وزر التحديث فقط -->
        <DockPanel Grid.Row="0"
                   FlowDirection="RightToLeft"
                   LastChildFill="False"
                   Margin="0,2,0,14">
            <TextBlock DockPanel.Dock="Left"
                       Text="العمليات"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButton}"
                    Height="40"
                    MinWidth="112"
                    Padding="14,0"
                    FontSize="13"
                    Click="RefreshButton_Click"
                    ToolTip="تحديث المؤشرات والسجلات">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Margin="0,0,7,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- بطاقات المؤشرات: القيم من خدمة العمليات الحالية -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,4,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#FCE9EC" CornerRadius="7" Width="43" Height="43" VerticalAlignment="Top"><TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#B51F32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="إجمالي البيع المسجل" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="GrossSalesTextBlock" Text="0 ريال" FontSize="25" FontWeight="Bold" Foreground="#B51F32" Margin="0,5,0,0"/><TextBlock x:Name="SalesCountTextBlock" Text="0 عملية" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="3,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#FFF2E2" CornerRadius="7" Width="43" Height="43" VerticalAlignment="Top"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#B46A13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="مستحق على نقاط البيع" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReceivablesTextBlock" Text="0 ريال" FontSize="25" FontWeight="Bold" Foreground="#B46A13" Margin="0,5,0,0"/><TextBlock x:Name="ReceivablesDetailTextBlock" Text="لا توجد أرصدة آجلة" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="3,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#EAF3FF" CornerRadius="7" Width="43" Height="43" VerticalAlignment="Top"><TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#3979C6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="تحصيل القنوات الإلكترونية" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CentralCollectionTextBlock" Text="0 ريال" FontSize="25" FontWeight="Bold" Foreground="#3979C6" Margin="0,5,0,0"/><TextBlock x:Name="CentralCollectionDetailTextBlock" Text="لا توجد عمليات محصلة حالياً" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="3,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#E7F7F0" CornerRadius="7" Width="43" Height="43" VerticalAlignment="Top"><TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#16845B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="تكلفة الطباعة والختم" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PrintingCostsTextBlock" Text="0 ريال" FontSize="25" FontWeight="Bold" Foreground="#16845B" Margin="0,5,0,0"/><TextBlock x:Name="PrintingCardsTextBlock" Text="0 كرت تم تجهيزه" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="13" Margin="4,0,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#F1F3F6" CornerRadius="7" Width="43" Height="43" VerticalAlignment="Top"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#596779" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="مصروفات تشغيل أخرى" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="OtherExpensesTextBlock" Text="0 ريال" FontSize="25" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0"/><TextBlock x:Name="OtherExpensesDetailTextBlock" Text="لا توجد مصروفات أخرى" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- محتوى العمليات: تحليل القنوات وجداول الأرصدة والحركات -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.RowSpan="3" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.7*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <Border DockPanel.Dock="Left" Width="38" Height="38" Background="#FCEBED" CornerRadius="8"><TextBlock Text="&#xEB05;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#B51F32" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="حركة قنوات البيع" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <!-- Existing service populates this grid; it remains the source for the chart -->
                        <DataGrid x:Name="ChannelsGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" HeadersVisibility="Column">
                            <DataGrid.Columns><DataGridTextColumn Header="القناة" Binding="{Binding ChannelLabel}"/><DataGridTextColumn Header="العمليات" Binding="{Binding CountLabel}"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding GrossLabel}"/><DataGridTextColumn Header="العمولة" Binding="{Binding FeeLabel}"/><DataGridTextColumn Header="الصافي" Binding="{Binding NetLabel}"/></DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=ChannelsGrid}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFBFD" BorderBrush="#EDF0F4" BorderThickness="1" CornerRadius="8" Padding="7" Margin="3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding GrossLabel}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                                <Grid Height="76" Margin="0,5,0,4">
                                                    <Border Background="#F0F2F6" CornerRadius="6" Width="34" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                                    <Border Background="#B51F32" Width="34" Height="{Binding BarHeight}" CornerRadius="6,6,1,1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ChannelLabel}" FontSize="9.2" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextAlignment="Center" TextWrapping="Wrap" MinHeight="26"/>
                                                <TextBlock Text="{Binding OperationsLabel}" FontSize="8.8" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Border Background="White" BorderBrush="#EEF0F4" BorderThickness="1" CornerRadius="8" Padding="20" Margin="2">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ChannelsGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M 2,17 L 2,11 L 5,11 L 5,17 Z M 7,17 L 7,6 L 10,6 L 10,17 Z M 12,17 L 12,2 L 15,2 L 15,17 Z" Fill="#B8C0CC" Stroke="#B8C0CC" StrokeThickness="1" Width="25" Height="30" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="لا توجد بيانات لعرضها حالياً" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                <TextBlock Text="سيظهر هنا توزيع عمليات البيع على القنوات المختلفة عند توفر البيانات." FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="ملخص القنوات" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,7,0,7"/>
                    <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,0">
                        <Border Background="#FCEBED" CornerRadius="8" Padding="7" Margin="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#B51F32" HorizontalAlignment="Center"/>
                                <TextBlock Text="البيع المباشر" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextAlignment="Center"/>
                                <TextBlock x:Name="DirectChannelCountTextBlock" Text="0 عملية" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFF4E8" CornerRadius="8" Padding="7" Margin="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#B46A13" HorizontalAlignment="Center"/>
                                <TextBlock Text="نقاط البيع" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextAlignment="Center"/>
                                <TextBlock x:Name="PointChannelCountTextBlock" Text="0 عملية" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#EEF5FF" CornerRadius="8" Padding="7" Margin="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#3979C6" HorizontalAlignment="Center"/>
                                <TextBlock Text="المتجر الإلكتروني" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextAlignment="Center"/>
                                <TextBlock x:Name="NetworkChannelCountTextBlock" Text="0 عملية" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F4EDFF" CornerRadius="8" Padding="7" Margin="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#8053BD" HorizontalAlignment="Center"/>
                                <TextBlock Text="التطبيقات" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextAlignment="Center"/>
                                <TextBlock x:Name="WalletChannelCountTextBlock" Text="0 عملية" FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Grid.Row="4" x:Name="ChannelFootnoteTextBlock" Text="تُعرض القيم من السجلات المحلية؛ التجميع الإلكتروني ليس رصيداً نقدياً مؤكداً حتى تتم التسوية." TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="11">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
           LastChildFill="False"
           Margin="0,0,0,8">

    <StackPanel DockPanel.Dock="Left"
                Orientation="Horizontal"
                FlowDirection="RightToLeft"
                VerticalAlignment="Center">

        <Border Width="36"
                Height="36"
                Background="#FCEBED"
                CornerRadius="8"
                VerticalAlignment="Center">
            <Path Data="M 5,2 L 11,2 L 15,6 L 15,16 L 4,16 L 4,2 Z M 11,2 L 11,6 L 15,6 M 7,9 L 12,9 M 7,12 L 12,12"
                  Stroke="#B51F32"
                  StrokeThickness="1.3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="17"
                  Height="19"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
        </Border>

        <TextBlock Text="أرصدة نقاط البيع المفتوحة"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>
    </StackPanel>

</DockPanel>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="ReceivablesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="38" ColumnHeaderHeight="38" FontSize="11.5">
                            <DataGrid.Columns><DataGridTextColumn Header="نقطة البيع" Binding="{Binding PointName}" Width="1.3*"/><DataGridTextColumn Header="التوريدات" Binding="{Binding TransferCount}" Width="65"/><DataGridTextColumn Header="العمولة" Binding="{Binding CommissionValueLabel}" Width="1*"/><DataGridTextColumn Header="الرصيد" Binding="{Binding BalanceLabel}" Width="1*"/></DataGrid.Columns>
                        </DataGrid>
                        <Border Background="White" BorderBrush="#EEF0F4" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,38,0,0">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ReceivablesGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 5,2 L 11,2 L 15,6 L 15,16 L 4,16 L 4,2 Z M 11,2 L 11,6 L 15,6 M 7,9 L 12,9 M 7,12 L 12,12" Stroke="#BAC2CE" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="27" Height="30" Stretch="Uniform" HorizontalAlignment="Center"/><TextBlock Text="لا توجد نقاط بيع مفتوحة حالياً" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" HorizontalAlignment="Center"/><TextBlock Text="ستظهر هنا أرصدة نقاط البيع النشطة." FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="11">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
           LastChildFill="False"
           Margin="0,0,0,8">

    <StackPanel DockPanel.Dock="Left"
                Orientation="Horizontal"
                FlowDirection="RightToLeft"
                VerticalAlignment="Center">

        <Border Width="36"
                Height="36"
                Background="#FCEBED"
                CornerRadius="8"
                VerticalAlignment="Center">
            <TextBlock Text="&#xE8CB;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="18"
                       Foreground="#B51F32"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <TextBlock Text="آخر الحركات المالية"
                   FontSize="13"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>
    </StackPanel>

</DockPanel>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="RecentGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="36" FontSize="11">
                            <DataGrid.Columns><DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding OccurredAtLabel}" Width="110"/><DataGridTextColumn Header="الحركة" Binding="{Binding ActivityType}" Width="90"/><DataGridTextColumn Header="نقطة البيع" Binding="{Binding PointName}" Width="1.2*"/><DataGridTextColumn Header="القيمة" Binding="{Binding NetLabel}" Width="90"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="85"/></DataGrid.Columns>
                        </DataGrid>
                        <Border Background="White" BorderBrush="#EEF0F4" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,36,0,0">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RecentGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#BAC2CE" HorizontalAlignment="Center"/><TextBlock Text="لا توجد حركات مالية حالياً" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" HorizontalAlignment="Center"/><TextBlock Text="ستظهر هنا آخر عمليات البيع والتوريد والتحصيل المسجلة." FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
