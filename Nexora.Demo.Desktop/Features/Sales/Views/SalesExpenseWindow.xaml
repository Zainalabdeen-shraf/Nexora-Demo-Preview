<Window x:Class="Nexora.Demo.Desktop.Features.Sales.Views.SalesExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل مصروف مبيعات" Width="540" Height="600" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft" Background="{StaticResource AppBgBrush}" FontFamily="Tahoma">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="تسجيل مصروف تشغيلي" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="سجّل المصروف الفعلي فقط. لا تُقدَّر تكاليف الورق أو الخدش تلقائيًا دون إدخال مبلغها." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Text="تصنيف المصروف" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryComboBox" Height="39" SelectedIndex="0" SelectedValuePath="Tag" Margin="0,0,0,10">
                    <ComboBoxItem Content="ورق وتغليف" Tag="ورق وتغليف"/>
                    <ComboBoxItem Content="مستلزمات طباعة إضافية" Tag="مستلزمات طباعة إضافية"/>
                    <ComboBoxItem Content="عمولة تشغيل أخرى" Tag="عمولة تشغيل أخرى"/>
                    <ComboBoxItem Content="نقل وتوصيل" Tag="نقل وتوصيل"/>
                    <ComboBoxItem Content="أخرى" Tag="أخرى"/>
                </ComboBox>
                <TextBlock Text="وصف المصروف" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DescriptionTextBox" Height="39" Margin="0,0,0,10"/>
                <TextBlock Text="المبلغ الفعلي (ريال)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AmountTextBox" Height="39" FlowDirection="LeftToRight" Margin="0,0,0,10"/>
                <TextBlock Text="رقم فاتورة / مرجع مرتبط (اختياري)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ReferenceTextBox" Height="39" Margin="0,0,0,10"/>
                <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NotesTextBox" Height="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8"/>
            </StackPanel>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="إلغاء" Style="{StaticResource SecondaryButton}" Width="100" Height="40" Click="CancelButton_Click"/>
            <Button Content="حفظ المصروف" Style="{StaticResource PrimaryButton}" Width="140" Height="40" Margin="0,0,8,0" Click="SaveButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
