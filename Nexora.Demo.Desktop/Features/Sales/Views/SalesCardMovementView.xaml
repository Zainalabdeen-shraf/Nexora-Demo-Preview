<UserControl x:Class="Nexora.Demo.Desktop.Features.Sales.Views.SalesCardMovementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F3F5F9"
             FontFamily="Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MoveInk" Color="#172849"/>
        <SolidColorBrush x:Key="MoveMuted" Color="#71809A"/>
        <SolidColorBrush x:Key="MoveRed" Color="#C71932"/>
        <SolidColorBrush x:Key="MoveRedDark" Color="#A70F25"/>
        <SolidColorBrush x:Key="MoveRedSoft" Color="#FFF0F3"/>
        <SolidColorBrush x:Key="MoveLine" Color="#DCE4EF"/>
        <SolidColorBrush x:Key="MoveGreen" Color="#16845B"/>
        <SolidColorBrush x:Key="MoveGreenSoft" Color="#DDF7E7"/>
        <SolidColorBrush x:Key="MoveBlue" Color="#2369AD"/>
        <SolidColorBrush x:Key="MoveBlueSoft" Color="#E2EEFF"/>
        <SolidColorBrush x:Key="MoveAmber" Color="#A96500"/>
        <SolidColorBrush x:Key="MoveAmberSoft" Color="#FFF0D2"/>
        <SolidColorBrush x:Key="MoveGray" Color="#64748B"/>
        <SolidColorBrush x:Key="MoveGraySoft" Color="#EEF1F6"/>
        <SolidColorBrush x:Key="MoveDanger" Color="#B42338"/>
        <SolidColorBrush x:Key="MoveDangerSoft" Color="#FFE4E9"/>

        <Style x:Key="MovePanel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource MoveLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="9"/>
        </Style>
        <Style x:Key="MoveTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource MoveInk}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="MoveLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource MoveMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="1,0,1,5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="MoveTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="11,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FCFDFE"/>
            <Setter Property="BorderBrush" Value="#D3DDEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource MoveInk}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="MoveComboItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource MoveInk}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#FFF0F3"/>
                    <Setter Property="Foreground" Value="{StaticResource MoveRedDark}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFF6F7"/>
                    <Setter Property="Foreground" Value="{StaticResource MoveRedDark}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MoveCombo" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CED9E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource MoveInk}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MoveComboItem}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="MovePrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Background" Value="{StaticResource MoveRed}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MoveRed}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource MoveRedDark}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource MoveRedDark}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MoveSecondaryButton" TargetType="Button" BasedOn="{StaticResource MovePrimaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D3DDEA"/>
            <Setter Property="Foreground" Value="{StaticResource MoveInk}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E49AA8"/><Setter TargetName="Chrome" Property="Background" Value="#FFF8F9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MoveHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFF0F3"/>
            <Setter Property="Foreground" Value="{StaticResource MoveInk}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#F1D9DE"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
        </Style>
        <Style x:Key="MoveCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource MoveInk}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
        <Style x:Key="MoveCellLtr" TargetType="TextBlock" BasedOn="{StaticResource MoveCellText}">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderBrush" Value="#E9EDF4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource MoveInk}"/>
            <Setter Property="BorderBrush" Value="#E9EDF4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF8F9"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFE7EC"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7EDF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EAF2"/>
            <Setter Property="VerticalGridLinesBrush" Value="#EEF1F6"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="31"/>
            <Setter Property="ColumnHeaderHeight" Value="35"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="7"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <!-- Header / actions: a single title, consistent with NetworkUsersView -->
        <Border Grid.Row="0" Style="{StaticResource MovePanel}" Padding="10,8">
            <Grid FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Style="{StaticResource MovePrimaryButton}" Click="NewTransferButton_Click" Padding="12,0" MinWidth="118">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <TextBlock Text="تسجيل توريد" VerticalAlignment="Center"/>
                            <TextBlock Text="＋" FontSize="17" FontWeight="Bold" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MoveSecondaryButton}" Click="RefreshButton_Click" Margin="7,0,0,0" MinWidth="92">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                            <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                            <Path Data="M20,8 A8,8 0 1 0 20,16 M20,4 L20,9 L15,9" Stroke="{StaticResource MoveInk}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="16" Height="16" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <TextBlock Text="حركة الكروت" FontSize="21" FontWeight="Bold" Foreground="{StaticResource MoveInk}" TextAlignment="Right"/>
                    <TextBlock Text="متابعة حالة كل كرت من المخزون إلى نقطة البيع ثم الاستخدام أو الإرجاع." FontSize="10.5" Foreground="{StaticResource MoveMuted}" Margin="0,3,0,0" TextAlignment="Right" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="4" Width="44" Height="44" Background="{StaticResource MoveRedSoft}" CornerRadius="9" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid Width="27" Height="23">
                        <Rectangle RadiusX="3" RadiusY="3" Stroke="{StaticResource MoveRedDark}" StrokeThickness="2" Fill="White"/>
                        <Rectangle Height="4" Fill="{StaticResource MoveRedDark}" VerticalAlignment="Top" Margin="1,5,1,0"/>
                        <Rectangle Width="6" Height="2.5" Fill="{StaticResource MoveRedDark}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MoveRedDark}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Filters. Plain TextBox + Calendar popups avoid WPF's hard-coded English date watermark. -->
        <Border Grid.Row="2" Style="{StaticResource MovePanel}" Padding="10,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" FlowDirection="RightToLeft">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                        <Path Data="M1,2 L18,2 L11,10 L11,16 L7,18 L7,10 Z" Stroke="{StaticResource MoveInk}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent" Width="18" Height="18" Margin="0,0,0,0"/>
                        <TextBlock Text="خيارات البحث" Style="{StaticResource MoveTitle}" Margin="7,0,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.65*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.18*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.18*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.12*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1.12*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" FlowDirection="RightToLeft" VerticalAlignment="Bottom">
                        <TextBlock Text="إعادة تعيين" Style="{StaticResource MoveLabel}"/>
                        <Button Style="{StaticResource MoveSecondaryButton}" Click="ResetButton_Click" MinWidth="98">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="إعادة تعيين" VerticalAlignment="Center"/>
                                <Path Data="M20,8 A8,8 0 1 0 20,16 M20,4 L20,9 L15,9" Stroke="{StaticResource MoveInk}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="16" Height="16" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" FlowDirection="RightToLeft" VerticalAlignment="Bottom">
                        <TextBlock Text="تنفيذ البحث" Style="{StaticResource MoveLabel}"/>
                        <Button Style="{StaticResource MovePrimaryButton}" Click="ApplyButton_Click" MinWidth="92">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="بحث" VerticalAlignment="Center"/>
                                <Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="20" Height="20" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="4" FlowDirection="RightToLeft">
                        <TextBlock Text="رقم الكرت أو الدفعة" Style="{StaticResource MoveLabel}"/>
                        <Grid>
                            <TextBox x:Name="SearchTextBox" Style="{StaticResource MoveTextBox}" FlowDirection="RightToLeft" TextChanged="SearchTextBox_TextChanged" ToolTip="ابحث برقم الكرت أو رقم الدفعة أو الباقة أو نقطة البيع"/>
                            <Path Data="M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 M16,16 L22,22" Stroke="#697B97" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="19" Height="19" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="6" FlowDirection="RightToLeft">
                        <TextBlock Text="حالة الكرت" Style="{StaticResource MoveLabel}"/>
                        <ComboBox x:Name="CardStatusComboBox" Style="{StaticResource MoveCombo}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Filter_Changed" ToolTip="تصفية حسب حالة الكرت"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8" FlowDirection="RightToLeft">
                        <TextBlock Text="نقطة البيع" Style="{StaticResource MoveLabel}"/>
                        <ComboBox x:Name="PointFilterComboBox" Style="{StaticResource MoveCombo}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Filter_Changed" ToolTip="تصفية الكروت حسب نقطة البيع"/>
                    </StackPanel>
                    <StackPanel Grid.Column="10" FlowDirection="RightToLeft">
                        <TextBlock Text="إلى تاريخ الإصدار" Style="{StaticResource MoveLabel}"/>
                        <Grid FlowDirection="RightToLeft">
                            <TextBox x:Name="ToDateTextBox" Style="{StaticResource MoveTextBox}" FlowDirection="LeftToRight" TextAlignment="Center" Padding="8,3,35,3" TextChanged="DateTextBox_TextChanged" ToolTip="اكتب التاريخ بصيغة yyyy/MM/dd أو اختره من التقويم"/>
                            <TextBlock x:Name="ToDatePlaceholderTextBlock" Text="yyyy/MM/dd" FontSize="10.5" Foreground="{StaticResource MoveMuted}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" Margin="0,0,35,0" IsHitTestVisible="False"/>
                            <Button Width="31" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="ToCalendarButton_Click" ToolTip="اختيار تاريخ النهاية">
                                <Path Data="M3,5 L21,5 L21,21 L3,21 Z M7,2 L7,8 M17,2 L17,8 M3,10 L21,10 M7,13 L10,13 M13,13 L16,13" Stroke="#62738F" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="19" Height="19"/>
                            </Button>
                            <Popup x:Name="ToCalendarPopup" PlacementTarget="{Binding ElementName=ToDateTextBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#CED9E8" BorderThickness="1" CornerRadius="7" Padding="4">
                                    <Calendar x:Name="ToCalendar" SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="12" FlowDirection="RightToLeft">
                        <TextBlock Text="من تاريخ الإصدار" Style="{StaticResource MoveLabel}"/>
                        <Grid FlowDirection="RightToLeft">
                            <TextBox x:Name="FromDateTextBox" Style="{StaticResource MoveTextBox}" FlowDirection="LeftToRight" TextAlignment="Center" Padding="8,3,35,3" TextChanged="DateTextBox_TextChanged" ToolTip="اكتب التاريخ بصيغة yyyy/MM/dd أو اختره من التقويم"/>
                            <TextBlock x:Name="FromDatePlaceholderTextBlock" Text="yyyy/MM/dd" FontSize="10.5" Foreground="{StaticResource MoveMuted}" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center" Margin="0,0,35,0" IsHitTestVisible="False"/>
                            <Button Width="31" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="FromCalendarButton_Click" ToolTip="اختيار تاريخ البداية">
                                <Path Data="M3,5 L21,5 L21,21 L3,21 Z M7,2 L7,8 M17,2 L17,8 M3,10 L21,10 M7,13 L10,13 M13,13 L16,13" Stroke="#62738F" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="19" Height="19"/>
                            </Button>
                            <Popup x:Name="FromCalendarPopup" PlacementTarget="{Binding ElementName=FromDateTextBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#CED9E8" BorderThickness="1" CornerRadius="7" Padding="4">
                                    <Calendar x:Name="FromCalendar" SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="DateRangeWarningTextBlock" Grid.Row="3" Text="" FontSize="10.5" Foreground="{StaticResource MoveDanger}" Margin="1,6,1,0" Visibility="Collapsed" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- The cards below count individual card records, never batch quantities. -->
        <UniformGrid Grid.Row="4" Columns="5" FlowDirection="RightToLeft" Margin="0,0,0,0">
            <Border Background="#F4FCF7" BorderBrush="#D8EDE0" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,0,4,0">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <TextBlock Text="مخزون مركزي" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MoveGreen}"/>
                        <TextBlock x:Name="CentralStockCountTextBlock" Text="0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource MoveInk}" Margin="0,3,0,0"/>
                        <TextBlock Text="متاح ولم يُسلّم بعد" FontSize="9" Foreground="{StaticResource MoveMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="32" Height="32" Background="{StaticResource MoveGreenSoft}" CornerRadius="17" VerticalAlignment="Top">
                        <Path Data="M2,8 L16,8 L16,20 L2,20 Z M1,4 L17,4 L17,8 L1,8 Z M5,12 L8,12" Stroke="{StaticResource MoveGreen}" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" Width="19" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Background="#F4F8FF" BorderBrush="#DCE9FB" BorderThickness="1" CornerRadius="9" Padding="9" Margin="3,0">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <TextBlock Text="مسلّم للبيع" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MoveBlue}"/>
                        <TextBlock x:Name="DeliveredForSaleCountTextBlock" Text="0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource MoveInk}" Margin="0,3,0,0"/>
                        <TextBlock Text="موجود لدى نقطة البيع" FontSize="9" Foreground="{StaticResource MoveMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="32" Height="32" Background="{StaticResource MoveBlueSoft}" CornerRadius="17" VerticalAlignment="Top">
                        <Path Data="M1,5 L12,5 L12,16 L1,16 Z M12,8 L17,8 L21,12 L21,16 L12,16 Z M4,18 A2.2,2.2 0 1 0 8.4,18 A2.2,2.2 0 1 0 4,18 M15,18 A2.2,2.2 0 1 0 19.4,18 A2.2,2.2 0 1 0 15,18" Stroke="{StaticResource MoveBlue}" StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Background="#FFFAF1" BorderBrush="#F2E2C9" BorderThickness="1" CornerRadius="9" Padding="9" Margin="3,0">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <TextBlock Text="مباع" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MoveAmber}"/>
                        <TextBlock x:Name="SoldCountTextBlock" Text="0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource MoveInk}" Margin="0,3,0,0"/>
                        <TextBlock Text="قيد الاستخدام" FontSize="9" Foreground="{StaticResource MoveMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="32" Height="32" Background="{StaticResource MoveAmberSoft}" CornerRadius="17" VerticalAlignment="Top">
                        <Path Data="M2,5 L21,5 L18,15 L5,15 Z M2,5 L1,2 M7,20 L7,20.1 M17,20 L17,20.1" Stroke="{StaticResource MoveAmber}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Background="#F5F6F9" BorderBrush="#DEE4EC" BorderThickness="1" CornerRadius="9" Padding="9" Margin="3,0">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <TextBlock Text="موقوف / منتهي" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MoveGray}"/>
                        <TextBlock x:Name="InactiveCountTextBlock" Text="0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource MoveInk}" Margin="0,3,0,0"/>
                        <TextBlock Text="حالة الحساب غير متاحة" FontSize="9" Foreground="{StaticResource MoveMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="32" Height="32" Background="{StaticResource MoveGraySoft}" CornerRadius="17" VerticalAlignment="Top">
                        <Path Data="M5,3 L5,21 M12,3 L12,21 M19,3 L19,21" Stroke="{StaticResource MoveGray}" StrokeThickness="2.2" StrokeStartLineCap="Round" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Background="#FFF7F8" BorderBrush="#F4DDE0" BorderThickness="1" CornerRadius="9" Padding="9" Margin="4,0,0,0">
                <Grid FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <TextBlock Text="مرتجع / مستبعد" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MoveDanger}"/>
                        <TextBlock x:Name="ReturnedCountTextBlock" Text="0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource MoveInk}" Margin="0,3,0,0"/>
                        <TextBlock Text="مرتجع أو استبعاد مسجّل" FontSize="9" Foreground="{StaticResource MoveMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="32" Height="32" Background="{StaticResource MoveDangerSoft}" CornerRadius="17" VerticalAlignment="Top">
                        <Path Data="M4,7 L4,3 L0,7 L4,11 L4,7 M4,7 L11,7 C16,7 20,11 20,16" Stroke="{StaticResource MoveDanger}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Card-level status table. Each row represents one generated card, not a batch movement event. -->
        <Border Grid.Row="6" Style="{StaticResource MovePanel}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="*" MinHeight="130"/>
                    <RowDefinition Height="7"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="9"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultCountTextBlock" Grid.Column="0" Text="0 كرت" FontSize="10.5" Foreground="{StaticResource MoveMuted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="سجل حالة الكروت" Style="{StaticResource MoveTitle}" HorizontalAlignment="Right"/>
                    <Border Grid.Column="3" Width="36" Height="36" Background="{StaticResource MoveRedSoft}" CornerRadius="8" HorizontalAlignment="Right">
                        <Grid Width="20" Height="20">
                            <Rectangle Stroke="{StaticResource MoveRedDark}" StrokeThickness="1.6" RadiusX="2" RadiusY="2" Fill="Transparent"/>
                            <Path Data="M2,6 L18,6 M2,11 L18,11 M2,16 L18,16 M7,1 L7,19 M13,1 L13,19" Stroke="{StaticResource MoveRedDark}" StrokeThickness="1.1"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="2" ClipToBounds="True">
                    <DataGrid x:Name="CardsGrid"
                              FlowDirection="RightToLeft"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ColumnHeaderStyle="{StaticResource MoveHeaderStyle}"
                              ClipboardCopyMode="IncludeHeader"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              RowHeight="31"
                              ColumnHeaderHeight="35"
                              FontFamily="Segoe UI"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="م" Binding="{Binding Index}" Width="42" ElementStyle="{StaticResource MoveCellText}"/>
                            <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchId}" Width="1.18*" ElementStyle="{StaticResource MoveCellLtr}"/>
                            <DataGridTextColumn Header="رقم الكرت" Binding="{Binding CardNumber}" Width="1.1*" ElementStyle="{StaticResource MoveCellLtr}"/>
                            <DataGridTextColumn Header="نقطة البيع" Binding="{Binding PointName}" Width="1.2*" ElementStyle="{StaticResource MoveCellText}"/>
                            <DataGridTextColumn Header="الباقة" Binding="{Binding PackageName}" Width="1.2*" ElementStyle="{StaticResource MoveCellText}"/>
                            <DataGridTextColumn Header="سعر الكرت" Binding="{Binding PriceLabel}" Width="0.85*" ElementStyle="{StaticResource MoveCellText}"/>
                            <DataGridTextColumn Header="تاريخ الإصدار" Binding="{Binding CreatedAtLabel}" Width="1.1*" ElementStyle="{StaticResource MoveCellLtr}"/>
                            <DataGridTemplateColumn Header="الحالة" Width="1.15*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" ToolTip="{Binding StatusDetails}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EEF1F6"/>
                                                    <Setter Property="BorderBrush" Value="#DCE4EF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="stock"><Setter Property="Background" Value="#DDF7E7"/><Setter Property="BorderBrush" Value="#9ADFB2"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="delivered"><Setter Property="Background" Value="#E2EEFF"/><Setter Property="BorderBrush" Value="#B8D4F7"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="sold"><Setter Property="Background" Value="#FFF0D2"/><Setter Property="BorderBrush" Value="#F0D18D"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="inactive"><Setter Property="Background" Value="#EEF1F6"/><Setter Property="BorderBrush" Value="#DCE4EF"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKey}" Value="returned"><Setter Property="Background" Value="#FFE4E9"/><Setter Property="BorderBrush" Value="#F0A4B1"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MoveInk}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetails}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="EmptyStatePanel" Background="White" BorderBrush="#E7EDF5" BorderThickness="1" CornerRadius="0,0,8,8" Margin="0,35,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                            <Border Width="44" Height="44" Background="#F3F5F9" CornerRadius="22" Margin="0,0,0,8">
                                <Grid Width="25" Height="21">
                                    <Rectangle RadiusX="3" RadiusY="3" Stroke="#9AA7BA" StrokeThickness="1.8" Fill="Transparent"/>
                                    <Rectangle Height="4" Fill="#9AA7BA" VerticalAlignment="Top" Margin="1,5,1,0"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="لا توجد كروت مطابقة" FontSize="14" FontWeight="Bold" Foreground="{StaticResource MoveInk}" HorizontalAlignment="Center"/>
                            <TextBlock Text="غيّر معايير البحث أو امسح المرشحات لعرض الكروت." FontSize="10.5" Foreground="{StaticResource MoveMuted}" Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="4" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PagerSummaryTextBlock" Grid.Column="0" Text="عرض 0–0 من أصل 0 كرت" FontSize="10" Foreground="{StaticResource MoveMuted}" VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center">
                        <TextBlock Text="عرض" FontSize="10" Foreground="{StaticResource MoveMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="PageSizeComboBox" FlowDirection="RightToLeft" Width="68" Height="30" Style="{StaticResource MoveCombo}" SelectedIndex="1" SelectionChanged="PageSize_Changed">
                            <ComboBoxItem Content="10" Tag="10"/><ComboBoxItem Content="20" Tag="20"/><ComboBoxItem Content="50" Tag="50"/>
                        </ComboBox>
                        <Button x:Name="PreviousPageButton" Content="‹" Style="{StaticResource MoveSecondaryButton}" Width="32" MinWidth="32" Height="30" Padding="0" Margin="8,0,0,0" Click="PreviousPageButton_Click" ToolTip="الصفحة السابقة"/>
                        <Border Background="{StaticResource MoveRed}" BorderBrush="{StaticResource MoveRed}" BorderThickness="1" CornerRadius="6" MinWidth="36" Height="30" Margin="4,0" Padding="7,0">
                            <TextBlock x:Name="PageIndicatorTextBlock" Text="1 / 1" FontSize="10.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Button x:Name="NextPageButton" Content="›" Style="{StaticResource MoveSecondaryButton}" Width="32" MinWidth="32" Height="30" Padding="0" Click="NextPageButton_Click" ToolTip="الصفحة التالية"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
