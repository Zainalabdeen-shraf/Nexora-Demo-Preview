                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding DateLabel}" />
            </Grid>
        </DataTemplate>
    </ItemsControl.ItemTemplate>
</ItemsControl>
                </Grid>

                <!-- Actual summary / comparison text, populated by code-behind -->
                <Border Grid.Row="3"
