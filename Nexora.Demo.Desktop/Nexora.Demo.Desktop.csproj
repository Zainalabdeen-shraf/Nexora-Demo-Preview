<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Brand\cards-network-logo.png" />
    <Resource Include="Assets\Brand\nexora-network-card-mark.png" />
    <Content Include="Assets\Printing\TabCard-Modern-Blue-Wave-Background.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Watch Include="**\*.xaml"
           Exclude="**\bin\**;**\obj\**" />
</ItemGroup>
</Project>
